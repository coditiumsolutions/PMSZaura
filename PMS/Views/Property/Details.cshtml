@model PMS.Models.Property

@{
    ViewData["Title"] = "Property Details";
}

<div class="pms-property-details">
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center gap-3 ms-2">
        <div class="badge bg-light text-dark px-3 py-2 pms-property-details-header-badge">
            <i class="fas fa-home me-1" style="color: #2563eb;"></i>
            <strong>Property:</strong> <code class="pms-property-details-code">@Model.PropertyID</code>
            <span class="text-muted ms-2">| Created @Model.CreatedAt.ToString("MMM dd, yyyy")</span>
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status == "Available")
        {
            <a asp-action="Allot" asp-route-id="@Model.PropertyID" class="btn btn-success btn-sm">
                <i class="fas fa-hand-holding me-1"></i>Allot Property
            </a>
        }
        <a asp-action="Edit" asp-route-id="@Model.PropertyID" class="btn btn-primary btn-sm">
            <i class="fas fa-edit me-1"></i>Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="fas fa-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card pms-listing-flat pms-property-details-card">
            <div class="card-header p-0">
                <ul class="nav nav-tabs property-tabs" id="propertyTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="property-tab" data-bs-toggle="tab" data-bs-target="#property" type="button" role="tab" aria-controls="property" aria-selected="true">
                            <i class="fas fa-building me-2"></i>Property Info
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="allotments-tab" data-bs-toggle="tab" data-bs-target="#allotments" type="button" role="tab" aria-controls="allotments" aria-selected="false">
                            <i class="fas fa-users me-2"></i>Allotments
                            @if (Model.Allotments != null && Model.Allotments.Any())
                            {
                                <span class="badge bg-primary rounded-pill ms-1">@Model.Allotments.Count</span>
                            }
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="possessions-tab" data-bs-toggle="tab" data-bs-target="#possessions" type="button" role="tab" aria-controls="possessions" aria-selected="false">
                            <i class="fas fa-key me-2"></i>Possessions
                            @if (Model.Possessions != null && Model.Possessions.Any())
                            {
                                <span class="badge bg-success rounded-pill ms-1">@Model.Possessions.Count</span>
                            }
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content" id="propertyTabContent">
                    <!-- Property Info Tab -->
                    <div class="tab-pane fade show active" id="property" role="tabpanel" aria-labelledby="property-tab">
                        <h6 class="mb-3 pms-property-section-title"><i class="fas fa-building me-2"></i>Property Details</h6>
                        <div class="pms-registration-4col-form pms-property-info-form">
                            <div class="row g-2 pms-registration-4col-row align-items-center">
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Property ID</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value pms-property-field-box"><code>@Model.PropertyID</code></div></div>
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Status</div></div>
                                <div class="col-12 col-lg-4">
                                    <div class="pms-registration-details-value pms-property-field-box">
                                        <span class="badge @(Model.Status == "Available" ? "bg-success" : Model.Status == "Allotted" ? "bg-warning text-dark" : "bg-danger")">
                                            @Model.Status
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="row g-2 pms-registration-4col-row align-items-center">
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Unit No</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value pms-property-field-box">@Model.PlotNo</div></div>
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Subproject</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value pms-property-field-box">@(string.IsNullOrWhiteSpace(Model.SubProject) ? "—" : Model.SubProject)</div></div>
                            </div>
                            <div class="row g-2 pms-registration-4col-row align-items-center">
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Tower</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value pms-property-field-box">@Model.Block</div></div>
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Floor</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value pms-property-field-box">@(Model.Floor ?? "N/A")</div></div>
                            </div>
                            <div class="row g-2 pms-registration-4col-row align-items-center">
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Unit Type (Category)</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value pms-property-field-box">@(string.IsNullOrWhiteSpace(Model.PlotType) ? "—" : Model.PlotType)</div></div>
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Size</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value pms-property-field-box">@Model.Size</div></div>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.AdditionalInfo))
                            {
                                <div class="row g-2 pms-registration-4col-row align-items-center">
                                    <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Additional Information</div></div>
                                    <div class="col-12 col-lg-10"><div class="pms-registration-details-value pms-property-field-box">@Model.AdditionalInfo</div></div>
                                </div>
                            }
                        </div>

                        @if (Model.Project != null)
                        {
                            <h6 class="mb-3 mt-4 pms-property-section-title"><i class="fas fa-project-diagram me-2"></i>Project Information</h6>
                            <div class="pms-registration-4col-form pms-property-info-form">
                                <div class="row g-2 pms-registration-4col-row align-items-center">
                                    <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Project Name</div></div>
                                    <div class="col-12 col-lg-4"><div class="pms-registration-details-value pms-property-field-box">@Model.Project.ProjectName</div></div>
                                    <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Type</div></div>
                                    <div class="col-12 col-lg-4"><div class="pms-registration-details-value pms-property-field-box">@(Model.Project.Type ?? "—")</div></div>
                                </div>
                                <div class="row g-2 pms-registration-4col-row align-items-center">
                                    <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Location</div></div>
                                    <div class="col-12 col-lg-10"><div class="pms-registration-details-value pms-property-field-box">@(Model.Project.Location ?? "—")</div></div>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.Project.Description))
                                {
                                    <div class="row g-2 pms-registration-4col-row align-items-center">
                                        <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Description</div></div>
                                        <div class="col-12 col-lg-10"><div class="pms-registration-details-value pms-property-field-box">@Model.Project.Description</div></div>
                                    </div>
                                }
                            </div>
                        }

                        <h6 class="mb-3 mt-4 pms-property-section-title"><i class="fas fa-chart-bar me-2"></i>Statistics</h6>
                        <div class="pms-registration-4col-form pms-property-info-form">
                            <div class="row g-2 pms-registration-4col-row align-items-center">
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Allotments</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value pms-property-field-box">@(Model.Allotments?.Count ?? 0)</div></div>
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Possessions</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value pms-property-field-box">@(Model.Possessions?.Count ?? 0)</div></div>
                            </div>
                        </div>

                        @if (Model.Allotments != null && Model.Allotments.Any())
                        {
                            var currentAllotment = Model.Allotments.OrderByDescending(a => a.AllotmentDate).FirstOrDefault();
                            if (currentAllotment?.Customer != null)
                            {
                                <h6 class="mb-3 mt-4 pms-property-section-title"><i class="fas fa-user me-2"></i>Current Owner</h6>
                                <div class="pms-registration-4col-form pms-property-info-form">
                                    <div class="row g-2 pms-registration-4col-row align-items-center">
                                        <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Name</div></div>
                                        <div class="col-12 col-lg-4"><div class="pms-registration-details-value pms-property-field-box">@currentAllotment.Customer.FullName</div></div>
                                        <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Customer ID</div></div>
                                        <div class="col-12 col-lg-4"><div class="pms-registration-details-value pms-property-field-box"><code>@currentAllotment.Customer.CustomerID</code></div></div>
                                    </div>
                                    <div class="row g-2 pms-registration-4col-row align-items-center">
                                        <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Phone</div></div>
                                        <div class="col-12 col-lg-4"><div class="pms-registration-details-value pms-property-field-box">@(currentAllotment.Customer.Phone ?? "—")</div></div>
                                        <div class="col-12 col-lg-2"><div class="pms-registration-4col-label"></div></div>
                                        <div class="col-12 col-lg-4">
                                            <a asp-controller="Customer" asp-action="Details" asp-route-id="@currentAllotment.Customer.CustomerID"
                                               class="btn btn-outline-primary btn-sm">
                                                <i class="fas fa-eye me-1"></i>View Customer
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <!-- Allotments Tab -->
                    <div class="tab-pane fade" id="allotments" role="tabpanel" aria-labelledby="allotments-tab">
                        @if (Model.Allotments != null && Model.Allotments.Any())
                        {
                            var allotment = Model.Allotments.OrderByDescending(a => a.AllotmentDate).FirstOrDefault();
                            if (allotment != null)
                            {
                                <div class="alert alert-info mb-3">
                                    <i class="fas fa-info-circle me-2"></i>
                                    <strong>Business Rule:</strong> 1 Property = 1 Customer. This property can only have ONE allotment.
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <h6 class="mb-3"><i class="fas fa-file-contract me-2"></i>Allotment Information</h6>
                                        <div class="row">
                                            <div class="col-md-6 mb-2">
                                                <div class="detail-field">
                                                    <label><i class="fas fa-id-badge me-2"></i>Allotment ID</label>
                                                    <p><code>@allotment.AllotmentID</code></p>
                                                </div>
                                            </div>
                                            <div class="col-md-6 mb-2">
                                                <div class="detail-field">
                                                    <label><i class="fas fa-tag me-2"></i>Type</label>
                                                    <p>@allotment.AllottmentType</p>
                                                </div>
                                            </div>
                                            <div class="col-md-6 mb-2">
                                                <div class="detail-field">
                                                    <label><i class="fas fa-calendar me-2"></i>Allotment Date</label>
                                                    <p>@allotment.AllotmentDate.ToString("MMMM dd, yyyy")</p>
                                                </div>
                                            </div>
                                            <div class="col-md-6 mb-2">
                                                <div class="detail-field">
                                                    <label><i class="fas fa-info-circle me-2"></i>Status</label>
                                                    <p>
                                                        <span class="badge bg-primary">@allotment.WorkFlowStatus</span>
                                                    </p>
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrEmpty(allotment.ApprovedBy))
                                            {
                                                <div class="col-md-6 mb-2">
                                                    <div class="detail-field">
                                                        <label><i class="fas fa-user-check me-2"></i>Approved By</label>
                                                        <p>@allotment.ApprovedBy</p>
                                                    </div>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(allotment.Comments))
                                            {
                                                <div class="col-md-12 mb-2">
                                                    <div class="detail-field">
                                                        <label><i class="fas fa-comment me-2"></i>Comments</label>
                                                        <p>@allotment.Comments</p>
                                                    </div>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(allotment.AdditionalInfo))
                                            {
                                                <div class="col-md-12 mb-2">
                                                    <div class="detail-field">
                                                        <label><i class="fas fa-sticky-note me-2"></i>Additional Info</label>
                                                        <p>@allotment.AdditionalInfo</p>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        @if (allotment.Customer != null)
                                        {
                                            <h6 class="mb-3"><i class="fas fa-user me-2"></i>Customer Information</h6>
                                            <div class="card pms-property-details-panel">
                                                <div class="card-body">
                                                    <div class="text-center mb-3">
                                                        <i class="fas fa-user-circle fa-2x" style="color: #2563eb;"></i>
                                                    </div>
                                                    <div class="detail-field mb-2">
                                                        <label><i class="fas fa-user me-2"></i>Full Name</label>
                                                        <p><strong>@allotment.Customer.FullName</strong></p>
                                                    </div>
                                                    <div class="detail-field mb-2">
                                                        <label><i class="fas fa-id-card me-2"></i>Customer ID</label>
                                                        <p><code>@allotment.Customer.CustomerID</code></p>
                                                    </div>
                                                    <div class="detail-field mb-2">
                                                        <label><i class="fas fa-phone me-2"></i>Phone</label>
                                                        <p>@allotment.Customer.Phone</p>
                                                    </div>
                                                    <div class="detail-field mb-2">
                                                        <label><i class="fas fa-envelope me-2"></i>Email</label>
                                                        <p>@(allotment.Customer.Email ?? "N/A")</p>
                                                    </div>
                                                    <div class="detail-field mb-3">
                                                        <label><i class="fas fa-id-card-alt me-2"></i>CNIC</label>
                                                        <p>@(allotment.Customer.CNIC ?? "N/A")</p>
                                                    </div>
                                                    <a asp-controller="Customer" asp-action="Details" asp-route-id="@allotment.Customer.CustomerID" 
                                                       class="btn btn-primary btn-sm w-100">
                                                        <i class="fas fa-eye me-1"></i>View Full Customer Details
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-warning">
                                                <i class="fas fa-exclamation-triangle me-2"></i>
                                                Customer information not available
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-3">
                                <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                <p class="mb-2">This property has not been allotted yet.</p>
                                @if (Model.Status == "Available")
                                {
                                    <a asp-action="Allot" asp-route-id="@Model.PropertyID" class="btn btn-success btn-sm">
                                        <i class="fas fa-hand-holding me-1"></i>Allot Property
                                    </a>
                                }
                            </div>
                        }
                    </div>

                    <!-- Possessions Tab -->
                    <div class="tab-pane fade" id="possessions" role="tabpanel" aria-labelledby="possessions-tab">
                        @if (Model.Possessions != null && Model.Possessions.Any())
                        {
                            <div class="table-responsive pms-property-details-panel p-2">
                                <table class="table table-sm table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>Possession ID</th>
                                            <th>Customer</th>
                                            <th>Date</th>
                                            <th>Status</th>
                                            <th>Remarks</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var possession in Model.Possessions.OrderByDescending(p => p.PossessionDate))
                                        {
                                            <tr>
                                                <td><code>@possession.PossessionID</code></td>
                                                <td>
                                                    @if (possession.Customer != null)
                                                    {
                                                        <strong>@possession.Customer.FullName</strong>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">N/A</span>
                                                    }
                                                </td>
                                                <td>@possession.PossessionDate.ToString("MMM dd, yyyy")</td>
                                                <td>
                                                    <span class="badge bg-success">@possession.WorkFlowStatus</span>
                                                </td>
                                                <td>@(possession.Remarks ?? "N/A")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted py-3">
                                <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                <p class="mb-0">No possession records found.</p>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
</div>

<style>
    .pms-property-details .pms-property-details-header-badge {
        font-size: 1rem;
        font-weight: 500;
    }

    .pms-property-details .pms-property-details-header-badge .pms-property-details-code {
        font-size: 1.05rem;
        font-weight: 700;
    }

    .pms-property-details-card {
        background: #fff !important;
        border: 1px solid #e5e7eb !important;
        box-shadow: none !important;
    }

    .pms-property-details-card > .card-body {
        background: #fff;
    }

    .pms-property-details .property-tabs {
        border-bottom: 1px solid #e5e7eb;
        background: #fff;
        padding: 0.35rem 0.75rem 0;
    }

    .pms-property-details .property-tabs .nav-link {
        color: #64748b;
        font-weight: 600;
        border: none;
        border-bottom: 2px solid transparent;
        padding: 0.45rem 0.85rem;
        font-size: 0.8125rem;
        background: #fff;
    }

    .pms-property-details .property-tabs .nav-link:hover {
        color: #2563eb;
        background: #fff;
        border-bottom-color: #cbd5e1;
    }

    .pms-property-details .property-tabs .nav-link.active {
        color: #2563eb;
        background: #fff;
        border-bottom-color: #2563eb;
    }

    .pms-property-details .property-tabs .nav-link i {
        font-size: 0.75rem;
    }

    .pms-property-details .property-tabs .badge {
        font-size: 0.625rem;
        padding: 0.15rem 0.35rem;
    }

    .pms-property-details .tab-content {
        padding-top: 0.75rem;
        background: #fff;
    }

    .pms-property-details .tab-pane {
        background: #fff;
    }

    .pms-property-details .tab-pane h6,
    .pms-property-details .pms-property-section-title {
        color: #0f172a;
        font-weight: 700;
        font-size: 0.9rem;
        padding-bottom: 0.25rem;
        margin-bottom: 0.4rem !important;
        border-bottom: 1px solid #e5e7eb;
    }

    .pms-property-details .pms-property-info-form {
        margin-bottom: 0.35rem;
    }

    .pms-property-details .pms-property-info-form .pms-registration-4col-row {
        margin-bottom: 0;
        padding-top: 0.1rem;
        padding-bottom: 0.1rem;
        border-bottom: 1px solid #e8edf3;
        align-items: center;
        --bs-gutter-x: 0.25rem;
        --bs-gutter-y: 0.05rem;
    }

    .pms-property-details .pms-property-info-form .pms-registration-4col-row:last-child {
        border-bottom: 1px solid #e8edf3;
    }

    .pms-property-details .pms-property-info-form .pms-registration-4col-label {
        color: #000;
        font-weight: 600;
        font-size: 0.7rem;
        margin-bottom: 0;
        line-height: 1.15;
        padding-right: 0.1rem;
    }

    .pms-property-details .pms-property-info-form .pms-registration-details-value,
    .pms-property-details .pms-property-info-form .pms-property-field-box {
        color: #2563eb !important;
        font-size: 0.8125rem;
        font-weight: 500;
        line-height: 1.15;
        margin-bottom: 0;
        min-height: 22px;
        max-width: 100%;
        display: flex;
        align-items: center;
        padding: 0.05rem 0;
        border: none !important;
        border-radius: 0;
        background: transparent;
        width: auto;
        min-width: 0;
        word-break: break-word;
        box-shadow: none;
    }

    /* Keep value boxes from stretching full column width */
    .pms-property-details .pms-property-info-form .col-lg-4 > .pms-property-field-box,
    .pms-property-details .pms-property-info-form .col-lg-10 > .pms-property-field-box {
        display: inline-flex;
        width: fit-content;
        max-width: 100%;
        min-width: 0;
    }

    .pms-property-details .pms-property-info-form .col-lg-10 > .pms-property-field-box {
        min-width: 0;
        max-width: 100%;
    }

    .pms-property-details .pms-property-info-form .pms-property-field-box code {
        background: transparent;
        color: #2563eb !important;
        padding: 0;
        font-size: inherit;
        font-weight: 500;
    }

    /* Slightly tighter label columns so fields sit closer to titles */
    @@media (min-width: 992px) {
        .pms-property-details .pms-property-info-form .pms-registration-4col-row > .col-lg-2 {
            flex: 0 0 12%;
            max-width: 12%;
        }

        .pms-property-details .pms-property-info-form .pms-registration-4col-row > .col-lg-4 {
            flex: 0 0 38%;
            max-width: 38%;
        }

        .pms-property-details .pms-property-info-form .pms-registration-4col-row > .col-lg-10 {
            flex: 0 0 88%;
            max-width: 88%;
        }
    }

    .pms-property-details .detail-field {
        padding: 6px 8px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 4px;
    }

    .pms-property-details .detail-field label {
        display: block;
        margin-bottom: 2px;
        font-size: 0.6875rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #000;
        font-weight: 600;
