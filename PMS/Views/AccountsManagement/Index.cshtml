@model PMS.Models.AccountsDashboardViewModel
@{
    ViewData["Title"] = "Accounts Management";
    ViewData["HidePageBanner"] = true;
}

<div class="pms-ams-dashboard">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h5 class="mb-0 pms-ams-page-title">Accounts Management</h5>
        <a class="btn btn-sm btn-outline-primary py-0 px-2" asp-controller="AmsCoa" asp-action="Index">
            <i class="fas fa-book me-1"></i>Open full accounting
        </a>
    </div>

    <partial name="_Nav" />

    <div class="row g-2 mb-3 ams-stats-compact">
        <div class="col-6 col-md-3">
            <div class="stats-card">
                <div class="stats-number">@Model.TotalCollectedToday.ToString("N0")</div>
                <div class="stats-label">Collected Today</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stats-card">
                <div class="stats-number">@Model.TotalCollectedThisMonth.ToString("N0")</div>
                <div class="stats-label">Collected This Month</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stats-card">
                <div class="stats-number">@Model.TotalReceivableThisMonth.ToString("N0")</div>
                <div class="stats-label">Receivable This Month</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stats-card">
                <div class="stats-number">@Model.TotalOverdueReceivable.ToString("N0")</div>
                <div class="stats-label">Overdue Outstanding</div>
            </div>
        </div>
    </div>

    <div class="row g-2">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header py-1 px-3 pms-ams-card-header">
                    <h6 class="mb-0">Collections by Method (This Month)</h6>
                </div>
                <div class="card-body py-2 px-3 bg-white">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0 pms-ams-table">
                            <thead>
                                <tr>
                                    <th>Method</th>
                                    <th class="text-end">Count</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Model.CollectionsByMethodThisMonth)
                                {
                                    <tr>
                                        <td><span class="pms-pill pms-pill--neutral">@m.Method</span></td>
                                        <td class="text-end">@m.Count</td>
                                        <td class="text-end fw-semibold">@m.TotalAmount.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-2">
                        <a class="btn btn-sm btn-outline-primary py-0 px-2" asp-action="BankWiseCollections">
                            <i class="fas fa-university me-1"></i>Bank-wise Report
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header py-1 px-3 pms-ams-card-header">
                    <h6 class="mb-0">Bank-wise Collections (Top)</h6>
                </div>
                <div class="card-body py-2 px-3 bg-white">
                    @if (Model.BankWiseCollectionsThisMonth.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0 pms-ams-table">
                                <thead>
                                    <tr>
                                        <th>Bank</th>
                                        <th class="text-end">Count</th>
                                        <th class="text-end">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var b in Model.BankWiseCollectionsThisMonth)
                                    {
                                        <tr>
                                            <td><span class="pms-pill pms-pill--info">@b.Bank</span></td>
                                            <td class="text-end">@b.Count</td>
                                            <td class="text-end fw-semibold">@b.TotalAmount.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="text-muted small mt-1">
                            Bank name is inferred from payment reference/remarks for Bank Transfer payments.
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-3 text-muted small">
                            No bank transfer payments found for this month.
                        </div>
                    }
                    <div class="mt-2 d-flex flex-wrap gap-1">
                        <a class="btn btn-sm btn-outline-primary py-0 px-2" asp-action="ReceivablesThisMonth">
                            <i class="fas fa-calendar-check me-1"></i>Receivables This Month
                        </a>
                        <a class="btn btn-sm btn-outline-danger py-0 px-2" asp-action="OverdueAging">
                            <i class="fas fa-hourglass-half me-1"></i>Overdue Aging
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .pms-ams-page-title {
        font-size: 0.8rem;
        font-weight: 600;
        color: #334155;
        letter-spacing: 0.01em;
    }

    .pms-ams-card-header {
        background: #E8EAE4 !important;
        border-bottom: 1px solid #d1d5db;
    }

    .pms-ams-card-header h6 {
        color: #000 !important;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .ams-stats-compact .stats-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 0.65rem 0.75rem;
        text-align: center;
        min-height: 0;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }

    .ams-stats-compact .stats-number {
        font-size: 1.2rem;
        font-weight: 700;
        color: #000;
        margin-bottom: 0.15rem;
        line-height: 1.2;
    }

    .ams-stats-compact .stats-label {
        font-size: 10px;
        color: #000;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.35px;
        margin: 0;
        line-height: 1.2;
    }

    .pms-ams-table thead th {
        background: #E8EAE4 !important;
        color: #334155 !important;
        font-size: 0.75rem !important;
        font-weight: 600 !important;
        border-bottom: 1px solid #d1d5db !important;
        white-space: nowrap;
    }

    .pms-ams-table tbody td {
        color: #000 !important;
        font-size: 0.8125rem;
    }

    .pms-ams-table tbody td:first-child {
        color: #1e3a8a !important;
        font-weight: 600;
    }
</style>
