@model IEnumerable<PMS.Models.Registration>

@{
    ViewData["Title"] = "Registrations";
    var registrationCount = Model?.Count() ?? 0;
    var canEdit = ViewBag.CanEdit == true;
    var canDelete = ViewBag.CanDelete == true;
    var showDelete = canDelete || canEdit;
}

<div class="pms-registration-listing pms-listing-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <h5 class="pms-grid-title pms-registration-page-heading mb-0">Registrations</h5>
            <span class="badge rounded-pill pms-record-badge">@registrationCount record@(registrationCount == 1 ? "" : "s")</span>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (canEdit)
            {
                <button type="button"
                        id="btnEditRegistration"
                        class="btn btn-outline-primary btn-sm"
                        disabled
                        title="Select a registration first">
                    <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>Edit
                </button>
            }
            @if (showDelete)
            {
                <button type="button"
                        id="btnDeleteRegistration"
                        class="btn btn-outline-danger btn-sm"
                        disabled
                        title="Select a registration first">
                    <i class="bi bi-trash me-1" aria-hidden="true"></i>Delete
                </button>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-2 mb-2 pms-registration-summary-cards">
        <div class="col-6 col-md-3">
            <div class="card border-0 h-100 pms-registration-stat-card" style="background:#e8f0fe;">
                <div class="card-body text-center py-2 px-2">
                    <div class="small text-muted text-uppercase fw-semibold mb-0">Total Registrations</div>
                    <div class="fs-5 fw-bold text-primary mb-0">@(ViewBag.TotalRegistrations ?? 0)</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 h-100 pms-registration-stat-card" style="background:#fff3cd;">
                <div class="card-body text-center py-2 px-2">
                    <div class="small text-muted text-uppercase fw-semibold mb-0">Pending</div>
                    <div class="fs-5 fw-bold text-warning mb-0">@(ViewBag.PendingRegistrations ?? 0)</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 h-100 pms-registration-stat-card" style="background:#d4edda;">
                <div class="card-body text-center py-2 px-2">
                    <div class="small text-muted text-uppercase fw-semibold mb-0">Approved</div>
                    <div class="fs-5 fw-bold text-success mb-0">@(ViewBag.ApprovedRegistrations ?? 0)</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 h-100 pms-registration-stat-card" style="background:#e2e3f3;">
                <div class="card-body text-center py-2 px-2">
                    <div class="small text-muted text-uppercase fw-semibold mb-0">Converted Customers</div>
                    <div class="fs-5 fw-bold text-info mb-0">@(ViewBag.ConvertedToCustomers ?? 0)</div>
                </div>
            </div>
        </div>
    </div>

<form method="get" asp-action="Index" class="mb-2">
    <div class="pms-registration-search-wrap pms-listing-search-wrap pms-registration-search-panel">
        <div class="row g-2 pms-registration-search-fields">
            <div class="col-12 col-md-6">
                <div class="pms-compact-field pms-select-dropdown pms-registration-equal-field">
                    <label for="statusFilter" class="visually-hidden">Status</label>
                    <select name="statusFilter" id="statusFilter" class="form-select" onchange="this.form.submit()" aria-label="Status">
                        <option value="All" selected="@(ViewBag.StatusFilter == "All")">All Status</option>
                        <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending")">Pending</option>
                        <option value="Approved" selected="@(ViewBag.StatusFilter == "Approved")">Approved</option>
                        <option value="Rejected" selected="@(ViewBag.StatusFilter == "Rejected")">Rejected</option>
                    </select>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="pms-compact-field pms-registration-equal-field">
                    <label for="searchTerm" class="visually-hidden">Search Registration</label>
                    <input type="text"
                           name="searchTerm"
                           id="searchTerm"
                           class="form-control"
                           placeholder="Search Registration"
                           aria-label="Search Registration"
                           value="@ViewBag.SearchTerm" />
                </div>
            </div>
        </div>
        <div class="row g-2 mt-2 pms-registration-search-actions-row">
            <div class="col-12 @(ViewBag.CanCreate == true ? "col-md-6" : "col-md-12")">
                <button type="submit" class="btn btn-sm pms-registration-action-btn pms-registration-action-btn--search">
                    <i class="bi bi-search me-1" aria-hidden="true"></i>Search
                </button>
            </div>
            @if (ViewBag.CanCreate == true)
            {
                <div class="col-12 col-md-6">
                    <a asp-action="Create" class="btn btn-sm pms-registration-action-btn pms-registration-action-btn--create">
                        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>New Registration
                    </a>
                </div>
            }
        </div>
    </div>
</form>

@Html.AntiForgeryToken()

<!-- Data Grid -->
<div class="card pms-grid-card pms-listing-flat pms-registration-listing pms-registration-grid-compact mb-2">
    <div class="card-body py-2">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle pms-enterprise-table" id="registrationsTable">
                    <thead>
                        <tr>
                            <th class="pms-registration-select-col text-center">Select</th>
                            <th>Reg ID</th>
                            <th>Name</th>
                            <th>Project</th>
                            <th>Size</th>
                            <th>SubProject</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var registration in Model)
                        {
                            <tr class="pms-registration-selectable-row"
                                data-registration-id="@registration.RegID"
                                data-href="@Url.Action("Details", new { id = registration.RegID })">
                                <td data-label="Select" class="text-center pms-registration-select-col">
                                    <input type="radio"
                                           name="selectedRegistration"
                                           class="form-check-input registration-select-radio m-0"
                                           value="@registration.RegID"
                                           aria-label="Select @registration.FullName" />
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@registration.RegID" class="text-decoration-none pms-reg-id-link">
                                        <code class="pms-reg-id">@registration.RegID</code>
                                    </a>
                                </td>
                                <td><strong class="pms-cell-truncate" title="@registration.FullName">@registration.FullName</strong></td>
                                <td><span class="pms-cell-truncate" title="@(registration.Project?.ProjectName ?? "—")">@(registration.Project?.ProjectName ?? "—")</span></td>
                                <td>@(registration.Size ?? "—")</td>
                                <td>@(registration.SubProject ?? "—")</td>
                                <td>
                                    @if (registration.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="fas fa-clock me-1"></i>Pending
                                        </span>
                                    }
                                    else if (registration.Status == "Approved")
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-check-circle me-1"></i>Approved
                                        </span>
                                    }
                                    else if (registration.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger">
                                            <i class="fas fa-times-circle me-1"></i>Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@registration.Status</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="pms-empty-state">
                <i class="bi bi-inbox display-4 d-block mb-3 text-muted"></i>
                <h5 class="text-muted">No Registrations Found</h5>
                <p class="text-muted mb-3">@(ViewBag.SearchTerm != null && ViewBag.SearchTerm != "" ? "Try different search criteria." : "Start by creating a new registration.")</p>
                @if (ViewBag.CanCreate == true)
                {
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i>Create First Registration
                    </a>
                }
            </div>
        }
    </div>
</div>
</div>

<style>
    .pms-registration-page-heading {
        font-size: 1.2rem;
        font-weight: 700;
        color: #0f172a;
    }

    .pms-registration-listing .pms-registration-select-col {
        width: 4.5rem;
        min-width: 4.5rem;
    }

    .pms-registration-listing .pms-registration-selectable-row {
        cursor: pointer;
    }

    .pms-registration-listing .pms-registration-selectable-row.pms-row-selected,
    .pms-registration-listing .pms-registration-selectable-row.pms-row-selected > td {
        background-color: #e7f1ff !important;
    }

    .pms-registration-search-panel {
        padding: 0.75rem 1rem !important;
        background: #e8eef8 !important;
        border: 1px solid #c5d0e0 !important;
        border-radius: 12px;
    }

    .pms-registration-search-fields {
        margin-top: 0 !important;
        align-items: stretch !important;
    }

    .pms-registration-listing .pms-registration-search-panel .form-label:not(.visually-hidden) {
        display: none !important;
    }

    .pms-registration-equal-field .form-select,
    .pms-registration-equal-field .form-control {
        width: 100% !important;
        border-radius: 0 !important;
        min-height: var(--pms-listing-control-h, 36px);
        height: var(--pms-listing-control-h, 36px);
    }

    .pms-registration-search-actions-row .pms-registration-action-btn {
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        width: 100% !important;
        border-radius: 0 !important;
        font-weight: 600;
        min-height: var(--pms-listing-control-h, 36px);
        height: var(--pms-listing-control-h, 36px);
        padding: 0.35rem 0.5rem !important;
        border: 1px solid transparent;
        white-space: nowrap;
        box-sizing: border-box;
        text-decoration: none;
    }

    .pms-registration-action-btn--search {
        background-color: #a8dadc !important;
        border-color: #8fc9cc !important;
        color: #1d3557 !important;
    }

    .pms-registration-action-btn--search:hover,
    .pms-registration-action-btn--search:focus {
        background-color: #95d0d3 !important;
        border-color: #7dbec2 !important;
        color: #1d3557 !important;
    }

    .pms-registration-action-btn--create {
        background-color: #457b9d !important;
        border-color: #3a6a88 !important;
        color: #fff !important;
    }

    .pms-registration-action-btn--create:hover,
    .pms-registration-action-btn--create:focus {
        background-color: #3a6a88 !important;
        border-color: #315c76 !important;
        color: #fff !important;
    }

    .pms-listing-scope .pms-registration-listing .table.pms-enterprise-table thead th,
    .pms-listing-scope .pms-registration-listing .table-responsive > table.table thead th,
    .pms-registration-listing .pms-enterprise-table thead th,
    .pms-registration-listing #registrationsTable thead th {
        background-color: #6059A6 !important;
        color: #fff !important;
        border-color: #524c96 !important;
        border-bottom-color: #524c96 !important;
    }

    .pms-registration-listing .pms-reg-id {
        color: #000 !important;
        font-size: 0.9rem;
        font-weight: 600;
        background: transparent;
        padding: 0;
    }

    .pms-registration-listing .pms-reg-id-link {
        color: #000;
    }

    .pms-registration-listing .pms-reg-id-link:hover .pms-reg-id {
        color: #000 !important;
        text-decoration: underline;
    }

    .pms-registration-grid-compact > .card-body {
        padding-top: 0.25rem !important;
    }

    .pms-registration-listing .pms-registration-dt-footer {
        width: 100%;
        padding: 0.5rem 0.25rem 0.25rem;
    }

    .pms-registration-listing .pms-registration-dt-footer .dataTables_length,
    .pms-registration-listing .pms-registration-dt-footer .dataTables_info,
    .pms-registration-listing .pms-registration-dt-footer .dataTables_paginate {
        float: none !important;
        padding: 0 !important;
        margin: 0 !important;
        font-size: 0.8125rem;
        color: #64748b;
    }

    .pms-registration-listing .pms-registration-dt-footer .dataTables_length select {
        border-radius: 8px;
        border: 1px solid #94a3b8;
        padding: 0.2rem 1.75rem 0.2rem 0.5rem;
        min-height: 32px;
        height: 32px;
        font-size: 0.8125rem;
        margin: 0 0.35rem;
        background-color: #fff;
    }

    .pms-registration-listing .pms-registration-dt-footer .dataTables_paginate {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.15rem;
    }

    html[data-theme="dark"] #registrationsTable thead th {
        background-color: #0f172a !important;
        color: var(--text-primary) !important;
    }

    html[data-theme="dark"] #registrationsTable tbody td {
        color: var(--text-primary) !important;
    }

    html[data-theme="dark"] #registrationsTable code {
        background: rgba(148, 163, 184, 0.18);
        color: #e5e7eb;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            var canEdit = @canEdit.ToString().ToLowerInvariant();
            var canDelete = @showDelete.ToString().ToLowerInvariant();
            var editRegistrationBaseUrl = '@Url.Action("Edit", "Registration")';
            var deleteRegistrationBaseUrl = '@Url.Action("Delete", "Registration")';
            var selectedRegistrationId = null;
            var $editBtn = $('#btnEditRegistration');
            var $deleteBtn = $('#btnDeleteRegistration');

            function clearSelection() {
                selectedRegistrationId = null;
                $('#registrationsTable tbody tr.pms-registration-selectable-row').removeClass('pms-row-selected');
                $('.registration-select-radio').prop('checked', false);
                if ($editBtn.length) {
                    $editBtn.prop('disabled', true).attr('title', 'Select a registration first');
                }
                if ($deleteBtn.length) {
                    $deleteBtn.prop('disabled', true).attr('title', 'Select a registration first');
                }
            }

            function setSelectedRegistration($row) {
                if (!$row || !$row.length) {
                    clearSelection();
                    return;
                }

                selectedRegistrationId = String($row.data('registration-id') || '');
                $('#registrationsTable tbody tr.pms-registration-selectable-row').removeClass('pms-row-selected');
                $row.addClass('pms-row-selected');
                $row.find('.registration-select-radio').prop('checked', true);

                if ($editBtn.length) {
                    $editBtn.prop('disabled', false).attr('title', 'Edit selected registration');
                }
                if ($deleteBtn.length) {
                    $deleteBtn.prop('disabled', false).attr('title', 'Delete selected registration');
                }
            }

            if ($('#registrationsTable').length) {
                PmsListingDataTable.init('#registrationsTable', {
                    searching: false,
                    order: [[1, "desc"]],
                    columnDefs: [{ orderable: false, targets: 0 }],
                    dom: 'rt<"pms-registration-dt-footer d-flex flex-wrap align-items-center justify-content-between gap-2 mt-2"lip>'
                });

                $('#registrationsTable tbody').on('change', '.registration-select-radio', function () {
                    setSelectedRegistration($(this).closest('tr'));
                });

                $('#registrationsTable tbody').on('click', 'tr.pms-registration-selectable-row', function (e) {
                    if ($(e.target).closest('a, button, form, select, textarea, input').length) {
                        return;
                    }
                    var $row = $(this);
                    if (selectedRegistrationId === String($row.data('registration-id') || '')) {
                        clearSelection();
                    } else {
                        setSelectedRegistration($row);
                    }
                });

                $('#registrationsTable tbody').on('dblclick', 'tr.pms-registration-selectable-row', function () {
                    var href = $(this).data('href');
                    if (href) {
                        window.location.href = href;
                    }
                });
            }

            if (canEdit) {
                $editBtn.on('click', function () {
                    if (!selectedRegistrationId) return;
                    window.location.href = editRegistrationBaseUrl + '/' + encodeURIComponent(selectedRegistrationId);
                });
            }

            if (canDelete) {
                $deleteBtn.on('click', function () {
                    if (!selectedRegistrationId) return;
                    if (!confirm('Are you sure you want to delete this registration? This cannot be undone.')) {
                        return;
                    }

                    var token = $('input[name="__RequestVerificationToken"]').val();
                    var $form = $('<form>', { method: 'post', action: deleteRegistrationBaseUrl + '/' + encodeURIComponent(selectedRegistrationId) });
                    $form.append($('<input>', { type: 'hidden', name: '__RequestVerificationToken', value: token }));
                    $('body').append($form);
                    $form.submit();
                });
            }
        });
    </script>
}
