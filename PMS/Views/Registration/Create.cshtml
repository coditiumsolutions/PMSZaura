@model PMS.Models.Registration

@{
    ViewData["Title"] = "Registration";
}

<div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
    <h5 class="mb-0">Registration</h5>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm py-0 px-2">
        <i class="fas fa-arrow-left me-1"></i>Back to List
    </a>
</div>

<div class="pms-registration-process-note mb-4">
    <span class="pms-registration-process-detail">Important: Current Record will be converted to a Customer Record with a Payment Plan</span>
</div>

<div class="card border-0 shadow-sm pms-mp-header pms-registration-create">
    <div class="card-header py-2 pms-mp-header-bar">
        <h6 class="mb-0"><i class="fas fa-user-plus me-2"></i>Registration Details</h6>
    </div>
    <div class="card-body py-3 px-3">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="pms-registration-4col-form">
                <div class="row g-2 pms-registration-4col-row align-items-center mb-2">
                    <div class="col-12 col-md-2">
                        <label asp-for="FullName" class="form-label fw-semibold mb-0 small">
                            <i class="fas fa-user me-1" style="color:var(--primary)"></i>Full Name <span class="text-danger">*</span>
                        </label>
                    </div>
                    <div class="col-12 col-md-4">
                        <input asp-for="FullName" id="FullName" class="form-control form-control-sm" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-2">
                        <label asp-for="Phone" class="form-label fw-semibold mb-0 small">
                            <i class="fas fa-phone me-1" style="color:var(--primary)"></i>Phone Number <span class="text-danger">*</span>
                        </label>
                    </div>
                    <div class="col-12 col-md-4">
                        <input asp-for="Phone" id="Phone" class="form-control form-control-sm" required />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-2 pms-registration-4col-row align-items-center mb-2">
                    <div class="col-12 col-md-2">
                        <label asp-for="CNIC" class="form-label fw-semibold mb-0 small">
                            <i class="fas fa-id-card me-1" style="color:var(--primary)"></i>CNIC
                        </label>
                    </div>
                    <div class="col-12 col-md-4">
                        <input asp-for="CNIC" id="CNIC" class="form-control form-control-sm" placeholder="XXXXX-XXXXXXX-X" maxlength="15" />
                        <span asp-validation-for="CNIC" class="text-danger small d-block"></span>
                        <span id="cnicError" class="text-danger small d-none"></span>
                    </div>
                    <div class="col-12 col-md-2">
                        <label asp-for="Email" class="form-label fw-semibold mb-0 small">
                            <i class="fas fa-envelope me-1" style="color:var(--primary)"></i>Email Address
                        </label>
                    </div>
                    <div class="col-12 col-md-4">
                        <input asp-for="Email" type="email" class="form-control form-control-sm" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-2 pms-registration-4col-row align-items-center mb-2">
                    <div class="col-12 col-md-2">
                        <label asp-for="PassportNo" class="form-label fw-semibold mb-0 small">
                            <i class="fas fa-passport me-1" style="color:var(--primary)"></i>Passport Number
                        </label>
                    </div>
                    <div class="col-12 col-md-4">
                        <input asp-for="PassportNo" id="PassportNo" class="form-control form-control-sm" placeholder="e.g. AB1234567" />
                        <small class="text-muted d-block">Alphanumeric only. Provide if no CNIC.</small>
                        <span asp-validation-for="PassportNo" class="text-danger small d-block"></span>
                        <span id="passportError" class="text-danger small d-none"></span>
                    </div>
                    <div class="col-12 col-md-2">
                        <label asp-for="ProjectID" class="form-label fw-semibold mb-0 small">
                            <i class="fas fa-building me-1" style="color:var(--primary)"></i>Project <span class="text-danger">*</span>
                        </label>
                    </div>
                    <div class="col-12 col-md-4">
                        <select asp-for="ProjectID" class="form-select form-select-sm" id="projectSelect" required>
                            <option value="">-- Select Project --</option>
                            @if (ViewBag.Projects != null)
                            {
                                @foreach (var p in ViewBag.Projects)
                                {
                                    <option value="@p.ProjectID">@p.ProjectName</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="ProjectID" class="text-danger small"></span>
                    </div>
                </div>

                <div id="cnicPassportRuleError" class="alert alert-warning small py-2 d-none mb-2" role="alert">
                    <i class="fas fa-exclamation-triangle me-1"></i>Either CNIC or Passport Number is required.
                </div>

                <div class="row g-2 pms-registration-4col-row align-items-center mb-2">
                    <div class="col-12 col-md-2">
                        <label asp-for="FormNo" class="form-label fw-semibold mb-0 small">
                            <i class="fas fa-hashtag me-1" style="color:var(--primary)"></i>Form No
                        </label>
                    </div>
                    <div class="col-12 col-md-4">
                        <input asp-for="FormNo" class="form-control form-control-sm" placeholder="Enter form number (optional)" />
                        <span asp-validation-for="FormNo" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-2">
                        <label asp-for="Size" class="form-label fw-semibold mb-0 small">
                            <i class="fas fa-ruler-combined me-1" style="color:var(--primary)"></i>Size <span class="text-danger">*</span>
                        </label>
                    </div>
                    <div class="col-12 col-md-4">
                        <select asp-for="Size" class="form-select form-select-sm" id="sizeSelect" disabled required>
                            <option value="">-- Select Project first --</option>
                        </select>
                        <span asp-validation-for="Size" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-2 pms-registration-4col-row align-items-center mb-2">
                    <div class="col-12 col-md-2">
                        <label asp-for="SubProject" class="form-label fw-semibold mb-0 small">
                            <i class="fas fa-sitemap me-1" style="color:var(--primary)"></i>SubProject
                        </label>
                    </div>
                    <div class="col-12 col-md-4">
                        <select asp-for="SubProject" class="form-select form-select-sm" id="subProjectSelect" disabled>
                            <option value="">-- Select Project first --</option>
                        </select>
                        <span asp-validation-for="SubProject" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="mt-2 d-flex justify-content-end gap-2 pms-registration-create-actions">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-sm fw-semibold" style="background:linear-gradient(135deg,var(--primary) 0%,var(--primary-light) 100%);color:white;border:none;">
                    <i class="fas fa-check me-1"></i>Save
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // FullName: letters, spaces, dots, hyphens only
        document.getElementById('FullName').addEventListener('input', function () {
            this.value = this.value.replace(/[^a-zA-Z\s\.\-]/g, '');
        });
        // Phone: digits and + only
        document.getElementById('Phone').addEventListener('input', function () {
            this.value = this.value.replace(/[^0-9\+]/g, '');
        });

        // Project / Size / SubProject loader
        document.getElementById('projectSelect').addEventListener('change', function () {
            var projectId = this.value;
            var sizeSelect = document.getElementById('sizeSelect');
            var subProjectSelect = document.getElementById('subProjectSelect');
            sizeSelect.innerHTML = '<option value="">-- Select Size --</option>';
            subProjectSelect.innerHTML = '<option value="">-- Select SubProject --</option>';
            sizeSelect.disabled = !projectId;
            subProjectSelect.disabled = !projectId;
            if (projectId) {
                fetch('@Url.Action("GetProjectSizes", "Registration")?projectId=' + encodeURIComponent(projectId))
                    .then(function (r) { return r.json(); })
                    .then(function (arr) {
                        arr.forEach(function (s) {
                            var opt = document.createElement('option');
                            opt.value = s;
                            opt.textContent = s;
                            sizeSelect.appendChild(opt);
                        });
                    });

                fetch('@Url.Action("GetProjectSubProjects", "Registration")?projectId=' + encodeURIComponent(projectId))
                    .then(function (r) { return r.json(); })
                    .then(function (arr) {
                        arr.forEach(function (s) {
                            var opt = document.createElement('option');
                            opt.value = s;
                            opt.textContent = s;
                            subProjectSelect.appendChild(opt);
                        });
                    });
            }
        });

        // CNIC: auto-insert hyphens, block letters
        var cnicInput = document.getElementById('CNIC');
        cnicInput.addEventListener('input', function (e) {
            var raw = this.value.replace(/[^0-9]/g, '');
            var formatted = '';
            if (raw.length <= 5) {
                formatted = raw;
            } else if (raw.length <= 12) {
                formatted = raw.slice(0, 5) + '-' + raw.slice(5);
            } else {
                formatted = raw.slice(0, 5) + '-' + raw.slice(5, 12) + '-' + raw.slice(12, 13);
            }
            this.value = formatted;
            validateCnicPassport();
        });

        // Passport: block non-alphanumeric
        var passportInput = document.getElementById('PassportNo');
        passportInput.addEventListener('input', function () {
            this.value = this.value.replace(/[^a-zA-Z0-9]/g, '');
            validateCnicPassport();
        });

        function validateCnicPassport() {
            var cnic = (cnicInput.value || '').trim();
            var passport = (passportInput.value || '').trim();
            var cnicRegex = /^\d{5}-\d{7}-\d$/;
            var cnicValid = cnicRegex.test(cnic);
            var passportValid = passport.length >= 3;

            document.getElementById('cnicError').classList.add('d-none');
            document.getElementById('passportError').classList.add('d-none');
            document.getElementById('cnicPassportRuleError').classList.add('d-none');
            cnicInput.classList.remove('is-invalid');
            passportInput.classList.remove('is-invalid');

            if (cnic && !cnicValid) {
                cnicInput.classList.add('is-invalid');
                document.getElementById('cnicError').classList.remove('d-none');
                document.getElementById('cnicError').textContent = 'CNIC must be XXXXX-XXXXXXX-X (digits only).';
            }
            if (passport && !/^[a-zA-Z0-9]+$/.test(passport)) {
                passportInput.classList.add('is-invalid');
                document.getElementById('passportError').classList.remove('d-none');
                document.getElementById('passportError').textContent = 'Passport must be alphanumeric only.';
            }
        }

        // On submit: require at least one of CNIC (valid) or Passport
        document.querySelector('form').addEventListener('submit', function (e) {
            var cnic = (cnicInput.value || '').trim();
            var passport = (passportInput.value || '').trim();
            var cnicValid = /^\d{5}-\d{7}-\d$/.test(cnic);
            var passportValid = passport.length >= 3;
            if (!cnicValid && !passportValid) {
                e.preventDefault();
                document.getElementById('cnicPassportRuleError').classList.remove('d-none');
                cnicInput.classList.add('is-invalid');
                passportInput.classList.add('is-invalid');
                cnicInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });
    </script>
}

