@model PMS.Models.Registration

@{
    ViewData["Title"] = "Edit Registration";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0 pms-registration-page-title">Edit Registration</h2>
    <div class="d-flex gap-2">
        <a asp-action="Details" asp-route-id="@Model.RegID" class="btn btn-outline-info btn-sm">
            <i class="fas fa-eye me-1"></i>View Details
        </a>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="fas fa-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>

<div class="card pms-listing-flat pms-registration-create">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            
            <input type="hidden" asp-for="RegID" />
            <input type="hidden" asp-for="CreatedAt" />
            
            <div class="pms-registration-4col-form">
                <div class="row g-2 pms-registration-4col-row align-items-start">
                    <div class="col-12 col-lg-2">
                        <label asp-for="FullName" class="form-label pms-registration-4col-label">Full Name *</label>
                    </div>
                    <div class="col-12 col-lg-4">
                        <input asp-for="FullName" id="FullName" class="form-control" required />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-lg-2">
                        <label asp-for="Phone" class="form-label pms-registration-4col-label">Phone Number *</label>
                    </div>
                    <div class="col-12 col-lg-4">
                        <input asp-for="Phone" id="Phone" class="form-control" required />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                </div>

                <div class="row g-2 pms-registration-4col-row align-items-start">
                    <div class="col-12 col-lg-2">
                        <label asp-for="CNIC" class="form-label pms-registration-4col-label">CNIC</label>
                    </div>
                    <div class="col-12 col-lg-4">
                        <input asp-for="CNIC" id="CNIC" class="form-control" placeholder="XXXXX-XXXXXXX-X" maxlength="15" />
                        <small class="text-muted d-block">Format: 5 digits – 7 digits – 1 digit. No letters allowed.</small>
                        <span asp-validation-for="CNIC" class="text-danger d-block"></span>
                        <span id="cnicError" class="text-danger small d-none"></span>
                    </div>
                    <div class="col-12 col-lg-2">
                        <label asp-for="Email" class="form-label pms-registration-4col-label">Email Address</label>
                    </div>
                    <div class="col-12 col-lg-4">
                        <input asp-for="Email" type="email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="row g-2 pms-registration-4col-row align-items-start">
                    <div class="col-12 col-lg-2">
                        <label asp-for="PassportNo" class="form-label pms-registration-4col-label">Passport Number</label>
                    </div>
                    <div class="col-12 col-lg-4">
                        <input asp-for="PassportNo" id="PassportNo" class="form-control" placeholder="e.g. AB1234567" />
                        <small class="text-muted d-block">Alphanumeric only (letters and digits). Provide if no CNIC.</small>
                        <span asp-validation-for="PassportNo" class="text-danger d-block"></span>
                        <span id="passportError" class="text-danger small d-none"></span>
                    </div>
                    <div class="col-12 col-lg-2">
                        <label asp-for="ProjectID" class="form-label pms-registration-4col-label">Project</label>
                    </div>
                    <div class="col-12 col-lg-4">
                        <select asp-for="ProjectID" class="form-select" id="projectSelect">
                            <option value="">-- Select Project --</option>
                            @if (ViewBag.Projects != null)
                            {
                                @foreach (var p in ViewBag.Projects)
                                {
                                    <option value="@p.ProjectID">@p.ProjectName</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div id="cnicPassportRuleError" class="alert alert-warning small py-2 d-none mb-2" role="alert">
                    <i class="fas fa-exclamation-triangle me-1"></i>Either CNIC or Passport Number is required.
                </div>

                <div class="row g-2 pms-registration-4col-row align-items-start">
                    <div class="col-12 col-lg-2">
                        <label asp-for="FormNo" class="form-label pms-registration-4col-label">Form No</label>
                    </div>
                    <div class="col-12 col-lg-4">
                        <input asp-for="FormNo" class="form-control" placeholder="Enter form number (optional)" />
                        <span asp-validation-for="FormNo" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-lg-2">
                        <label asp-for="Size" class="form-label pms-registration-4col-label">Size</label>
                    </div>
                    <div class="col-12 col-lg-4">
                        <select asp-for="Size" class="form-select" id="sizeSelect">
                            <option value="">-- Select Project first --</option>
                        </select>
                    </div>
                </div>

                <div class="row g-2 pms-registration-4col-row align-items-start">
                    <div class="col-12 col-lg-2">
                        <label asp-for="SubProject" class="form-label pms-registration-4col-label">SubProject</label>
                    </div>
                    <div class="col-12 col-lg-4">
                        <select asp-for="SubProject" class="form-select" id="subProjectSelect">
                            <option value="">-- Select Project first --</option>
                        </select>
                    </div>
                    <div class="col-12 col-lg-2">
                        <label asp-for="Status" class="form-label pms-registration-4col-label">Status *</label>
                    </div>
                    <div class="col-12 col-lg-4">
                        <select asp-for="Status" class="form-select" required>
                            <option value="Pending">Pending</option>
                            <option value="Approved">Approved</option>
                            <option value="Rejected">Rejected</option>
                        </select>
                    </div>
                </div>
            </div>

            <hr class="my-4">

            <div class="d-flex justify-content-end gap-2 pms-registration-create-actions">
                <a asp-action="Details" asp-route-id="@Model.RegID" class="btn btn-sm btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-sm btn-primary">
                    <i class="bi bi-check-lg me-1" aria-hidden="true"></i>Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            // FullName: letters, spaces, dots, hyphens only
            document.getElementById('FullName').addEventListener('input', function () {
                this.value = this.value.replace(/[^a-zA-Z\s\.\-]/g, '');
            });
            // Phone: digits and + only
            document.getElementById('Phone').addEventListener('input', function () {
                this.value = this.value.replace(/[^0-9\+]/g, '');
            });

            // Project / Size / SubProject loader
            var projectSelect = document.getElementById('projectSelect');
            var sizeSelect = document.getElementById('sizeSelect');
            var subProjectSelect = document.getElementById('subProjectSelect');
            var currentSize = '@(Model.Size ?? "")';
            var currentSubProject = '@(Model.SubProject ?? "")';

            function loadSizes(projectId, selectValue) {
                sizeSelect.innerHTML = '<option value="">-- Select Size --</option>';
                sizeSelect.disabled = !projectId;
                if (projectId) {
                    fetch('@Url.Action("GetProjectSizes", "Registration")?projectId=' + encodeURIComponent(projectId))
                        .then(function (r) { return r.json(); })
                        .then(function (arr) {
                            arr.forEach(function (s) {
                                var opt = document.createElement('option');
                                opt.value = s;
                                opt.textContent = s;
                                if (s === selectValue) opt.selected = true;
                                sizeSelect.appendChild(opt);
                            });
                        });
                }
            }

            function loadSubProjects(projectId, selectValue) {
                subProjectSelect.innerHTML = '<option value="">-- Select SubProject --</option>';
                subProjectSelect.disabled = !projectId;
                if (projectId) {
                    fetch('@Url.Action("GetProjectSubProjects", "Registration")?projectId=' + encodeURIComponent(projectId))
                        .then(function (r) { return r.json(); })
                        .then(function (arr) {
                            arr.forEach(function (s) {
                                var opt = document.createElement('option');
                                opt.value = s;
                                opt.textContent = s;
                                if (s === selectValue) opt.selected = true;
                                subProjectSelect.appendChild(opt);
                            });
                        });
                }
            }

            var pid = projectSelect.value;
            if (pid) {
                loadSizes(pid, currentSize);
                loadSubProjects(pid, currentSubProject);
            } else {
                sizeSelect.disabled = true;
                subProjectSelect.disabled = true;
            }

            projectSelect.addEventListener('change', function () {
                loadSizes(this.value, '');
                loadSubProjects(this.value, '');
            });

            // CNIC: auto-insert hyphens, block letters
            var cnicInput = document.getElementById('CNIC');
            cnicInput.addEventListener('input', function () {
                var raw = this.value.replace(/[^0-9]/g, '');
                var formatted = '';
                if (raw.length <= 5) {
                    formatted = raw;
                } else if (raw.length <= 12) {
                    formatted = raw.slice(0, 5) + '-' + raw.slice(5);
                } else {
                    formatted = raw.slice(0, 5) + '-' + raw.slice(5, 12) + '-' + raw.slice(12, 13);
                }
                this.value = formatted;
                validateCnicPassport();
            });

            // Passport: block non-alphanumeric
            var passportInput = document.getElementById('PassportNo');
            passportInput.addEventListener('input', function () {
                this.value = this.value.replace(/[^a-zA-Z0-9]/g, '');
                validateCnicPassport();
            });

            function validateCnicPassport() {
                var cnic = (cnicInput.value || '').trim();
                var passport = (passportInput.value || '').trim();
                var cnicRegex = /^\d{5}-\d{7}-\d$/;
                var cnicValid = cnicRegex.test(cnic);

                document.getElementById('cnicError').classList.add('d-none');
                document.getElementById('passportError').classList.add('d-none');
                document.getElementById('cnicPassportRuleError').classList.add('d-none');
                cnicInput.classList.remove('is-invalid');
                passportInput.classList.remove('is-invalid');

                if (cnic && !cnicValid) {
                    cnicInput.classList.add('is-invalid');
                    document.getElementById('cnicError').classList.remove('d-none');
                    document.getElementById('cnicError').textContent = 'CNIC must be XXXXX-XXXXXXX-X (digits only).';
                }
                if (passport && !/^[a-zA-Z0-9]+$/.test(passport)) {
                    passportInput.classList.add('is-invalid');
                    document.getElementById('passportError').classList.remove('d-none');
                    document.getElementById('passportError').textContent = 'Passport must be alphanumeric only.';
                }
            }

            // On submit: require at least one of CNIC (valid) or Passport
            document.querySelector('form').addEventListener('submit', function (e) {
                var cnic = (cnicInput.value || '').trim();
                var passport = (passportInput.value || '').trim();
                var cnicValid = /^\d{5}-\d{7}-\d$/.test(cnic);
                var passportValid = passport.length >= 3;
                if (!cnicValid && !passportValid) {
                    e.preventDefault();
                    document.getElementById('cnicPassportRuleError').classList.remove('d-none');
                    cnicInput.classList.add('is-invalid');
                    passportInput.classList.add('is-invalid');
                    cnicInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            });

            // Format existing CNIC value on load (in case it's stored without hyphens)
            (function formatExistingCnic() {
                var raw = (cnicInput.value || '').replace(/[^0-9]/g, '');
                if (raw.length === 13) {
                    cnicInput.value = raw.slice(0,5) + '-' + raw.slice(5,12) + '-' + raw.slice(12);
                }
            })();
        })();
    </script>
}

