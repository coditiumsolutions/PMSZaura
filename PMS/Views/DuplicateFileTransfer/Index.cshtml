@model IEnumerable<PMS.Models.DuplicateFileTransfer>
@{
    ViewData["Title"] = "Duplicate File Transfer";
    ViewData["ListingHideToolbarActions"] = true;
    ViewData["ListingHideTitle"] = true;
    const string Initiated = "Initiated";
    const string Approved = "Approved";
    const string Declined = "Declined";
    var wfSel = ViewBag.WorkflowFilter as string ?? "";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2 mb-2 small">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show py-2 mb-2 small">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="pms-dft-listing pms-listing-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h5 class="pms-grid-title mb-0">Duplicate File Transfer</h5>
        @if (Model != null)
        {
            <span class="badge rounded-pill pms-record-badge">@Model.Count() record@(Model.Count() == 1 ? "" : "s")</span>
        }
    </div>

    <div class="row g-2 mb-2">
        <div class="col-6 col-md-4">
            <a href="@Url.Action("Index", new { workflowFilter = Initiated })" class="text-decoration-none">
                <div class="card border-0 h-100" style="background:#fff3cd;">
                    <div class="card-body text-center py-2 px-2">
                        <div class="small text-muted text-uppercase fw-semibold mb-0">@Initiated</div>
                        <div class="fs-5 fw-bold text-warning mb-0">@(ViewBag.InitiatedCount ?? 0)</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4">
            <a href="@Url.Action("Index", new { workflowFilter = Approved })" class="text-decoration-none">
                <div class="card border-0 h-100" style="background:#d4edda;">
                    <div class="card-body text-center py-2 px-2">
                        <div class="small text-muted text-uppercase fw-semibold mb-0">@Approved</div>
                        <div class="fs-5 fw-bold text-success mb-0">@(ViewBag.ApprovedCount ?? 0)</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4">
            <a href="@Url.Action("Index", new { workflowFilter = Declined })" class="text-decoration-none">
                <div class="card border-0 h-100" style="background:#f8d7da;">
                    <div class="card-body text-center py-2 px-2">
                        <div class="small text-muted text-uppercase fw-semibold mb-0">@Declined</div>
                        <div class="fs-5 fw-bold text-danger mb-0">@(ViewBag.DeclinedCount ?? 0)</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <form method="get" asp-action="Index" class="mb-2">
        <div class="pms-listing-search-wrap">
            <div class="row g-1 align-items-end flex-lg-nowrap">
                <div class="col-12 col-md-4 col-lg-3">
                    <div class="pms-compact-field pms-select-dropdown">
                        <label for="workflowFilter" class="form-label">Status</label>
                        <select name="workflowFilter" id="workflowFilter" class="form-select" onchange="this.form.submit()">
                            <option value="" selected="@(wfSel == "")">All</option>
                            <option value="@Initiated" selected="@(wfSel == Initiated)">@Initiated</option>
                            <option value="@Approved" selected="@(wfSel == Approved)">@Approved</option>
                            <option value="@Declined" selected="@(wfSel == Declined)">@Declined</option>
                        </select>
                    </div>
                </div>
                <div class="col-12 col-md-8 col-lg-5">
                    <div class="pms-compact-field">
                        <label for="customerFilter" class="form-label">Customer ID</label>
                        <input type="text" name="customerFilter" id="customerFilter" class="form-control"
                               placeholder="Filter by customer ID"
                               value="@ViewBag.CustomerFilter" />
                    </div>
                </div>
                <div class="col-12 col-lg-auto">
                    <div class="d-flex flex-nowrap gap-2 align-items-center pms-listing-search-actions">
                        <button type="submit" class="btn btn-sm pms-pair-action-btn pms-pair-action-btn--search">
                            <i class="bi bi-search me-1" aria-hidden="true"></i>Search
                        </button>
                        <partial name="_OperationsDropdown" />
                    </div>
                </div>
            </div>
        </div>
    </form>

    <div class="card pms-grid-card pms-listing-flat pms-saas-grid pms-listing-page mb-2">
        <div class="card-body py-2">
            <div class="table-responsive pms-saas-table-wrap">
                <table class="table pms-saas-table" id="dftTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Customer</th>
                            <th class="text-end">Fee Due</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            var wf = r.Status ?? Initiated;
                            var pillClass = string.Equals(wf, Approved, StringComparison.OrdinalIgnoreCase) ? "pms-pill--success"
                                : string.Equals(wf, Declined, StringComparison.OrdinalIgnoreCase) ? "pms-pill--danger" : "pms-pill--warning";
                            <tr class="pms-listing-row" data-href="@Url.Action("Details", new { id = r.Id })">
                                <td data-label="ID">
                                    <a asp-action="Details" asp-route-id="@r.Id" class="text-decoration-none">
                                        <code>@r.Id</code>
                                    </a>
                                </td>
                                <td data-label="Customer">
                                    <div><code>@r.CustomerID</code></div>
                                    <div class="small text-muted">@(r.CustomerName ?? "—")</div>
                                </td>
                                <td class="text-end" data-label="Fee Due">@(r.FeeDue.HasValue ? $"PKR {r.FeeDue:N0}" : "—")</td>
                                <td data-label="Status"><span class="pms-pill @pillClass">@wf</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(function () {
        PmsListingDataTable.init('#dftTable', {
            order: [[0, 'desc']]
        });
        PmsListingDataTable.bindRowNavigation('#dftTable');
    });
</script>
}
