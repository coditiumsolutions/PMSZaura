@model IEnumerable<PMS.Models.Waiver>
@{
    ViewData["Title"] = "Waivers";
    ViewData["ListingHideToolbarActions"] = true;
    ViewData["ListingHideTitle"] = true;
    var initiatedStatus = (string?)ViewBag.InitiatedStatus ?? "Initiated";
    var approvedStatus = (string?)ViewBag.ApprovedStatus ?? "Approved";
    var declinedStatus = (string?)ViewBag.DeclinedStatus ?? "Declined";
    var statusSel = ViewBag.StatusFilter as string ?? "";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2 mb-2 small">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show py-2 mb-2 small">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="pms-waiver-listing pms-listing-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h5 class="pms-grid-title mb-0">Waivers</h5>
        @if (Model != null)
        {
            <span class="badge rounded-pill pms-record-badge">@Model.Count() record@(Model.Count() == 1 ? "" : "s")</span>
        }
    </div>

    <div class="row g-2 mb-2">
        <div class="col-6 col-md-4">
            <a href="@Url.Action("Index", new { statusFilter = initiatedStatus })" class="text-decoration-none">
                <div class="card border-0 h-100" style="background:#fff3cd;">
                    <div class="card-body text-center py-2 px-2">
                        <div class="small text-muted text-uppercase fw-semibold mb-0">@initiatedStatus</div>
                        <div class="fs-5 fw-bold text-warning mb-0">@(ViewBag.InitiatedCount ?? 0)</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4">
            <a href="@Url.Action("Index", new { statusFilter = approvedStatus })" class="text-decoration-none">
                <div class="card border-0 h-100" style="background:#d4edda;">
                    <div class="card-body text-center py-2 px-2">
                        <div class="small text-muted text-uppercase fw-semibold mb-0">@approvedStatus</div>
                        <div class="fs-5 fw-bold text-success mb-0">@(ViewBag.ApprovedCount ?? 0)</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4">
            <a href="@Url.Action("Index", new { statusFilter = declinedStatus })" class="text-decoration-none">
                <div class="card border-0 h-100" style="background:#f8d7da;">
                    <div class="card-body text-center py-2 px-2">
                        <div class="small text-muted text-uppercase fw-semibold mb-0">@declinedStatus</div>
                        <div class="fs-5 fw-bold text-danger mb-0">@(ViewBag.DeclinedCount ?? 0)</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <form method="get" asp-action="Index" class="mb-2">
        <div class="pms-listing-search-wrap">
            <div class="row g-1 align-items-end flex-lg-nowrap">
                <div class="col-12 col-md-4 col-lg-3">
                    <div class="pms-compact-field pms-select-dropdown">
                        <label for="statusFilter" class="form-label">Status</label>
                        <select name="statusFilter" id="statusFilter" class="form-select" onchange="this.form.submit()">
                            <option value="" selected="@(statusSel == "")">All</option>
                            @foreach (var s in (ViewBag.WorkflowStatuses as List<string> ?? new List<string>()))
                            {
                                <option value="@s" selected="@(statusSel == s)">@s</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-12 col-md-8 col-lg-5">
                    <div class="pms-compact-field">
                        <label for="customerFilter" class="form-label">Customer ID</label>
                        <input type="text" name="customerFilter" id="customerFilter" class="form-control"
                               placeholder="Filter by customer ID"
                               value="@ViewBag.CustomerFilter" />
                    </div>
                </div>
                <div class="col-12 col-lg-auto">
                    <div class="d-flex flex-nowrap gap-2 align-items-center pms-listing-search-actions">
                        <button type="submit" class="btn btn-sm pms-pair-action-btn pms-pair-action-btn--search">
                            <i class="bi bi-search me-1" aria-hidden="true"></i>Search
                        </button>
                        <partial name="_OperationsDropdown" />
                    </div>
                </div>
            </div>
        </div>
    </form>

    <div class="card pms-grid-card pms-listing-flat pms-saas-grid pms-listing-page mb-2">
        <div class="card-body py-2">
            <div class="table-responsive pms-saas-table-wrap">
                <table class="table pms-saas-table" id="waiverTable">
                    <thead>
                        <tr>
                            <th>Waiver ID</th>
                            <th>Customer</th>
                            <th>Type</th>
                            <th class="text-end">Total Surcharge</th>
                            <th class="text-end">Waived</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var w in Model)
                        {
                            var status = w.Status ?? initiatedStatus;
                            var isApproved = string.Equals(status, approvedStatus, StringComparison.OrdinalIgnoreCase);
                            var pillClass = string.Equals(status, approvedStatus, StringComparison.OrdinalIgnoreCase)
                                ? "pms-pill--success"
                                : string.Equals(status, declinedStatus, StringComparison.OrdinalIgnoreCase)
                                    ? "pms-pill--danger"
                                    : "pms-pill--warning";
                            <tr class="pms-listing-row" data-href="@Url.Action("Details", new { id = w.WaiverID })">
                                <td data-label="Waiver ID">
                                    <a asp-action="Details" asp-route-id="@w.WaiverID" class="text-decoration-none">
                                        <code>@w.WaiverID</code>
                                    </a>
                                </td>
                                <td data-label="Customer">
                                    <div><code>@w.CustomerID</code></div>
                                    <div class="small text-muted">@(w.Customer?.FullName ?? "—")</div>
                                </td>
                                <td data-label="Type">@(w.WaiverType ?? "—")</td>
                                <td class="text-end" data-label="Total Surcharge">@w.TotalAmount.ToString("N0")</td>
                                <td class="text-end fw-bold text-success" data-label="Waived">@w.WaivedAmount.ToString("N0")</td>
                                <td data-label="Status"><span class="pms-pill @pillClass">@status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(function () {
        PmsListingDataTable.init('#waiverTable', {
            order: [[0, 'desc']]
        });
        PmsListingDataTable.bindRowNavigation('#waiverTable');
    });
</script>
}
