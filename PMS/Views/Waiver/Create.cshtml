@model PMS.Models.Waiver
@{
    ViewData["Title"] = "Waiver";
}

<div class="pms-waiver-create">
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <h5 class="mb-0">Waiver</h5>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm py-0 px-2"><i class="fas fa-arrow-left me-1"></i>Back</a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm pms-mp-header pms-registration-create mb-3 pms-waiver-customer-search">
        <div class="card-header py-2 pms-mp-header-bar">
            <h6 class="mb-0"><i class="fas fa-search me-2"></i>Customer Search</h6>
        </div>
        <div class="card-body py-2 px-3">
            <div class="pms-registration-4col-form">
                <div class="row g-1 pms-registration-4col-row align-items-center pms-waiver-customer-id-row">
                    <div class="col-12 col-lg-2">
                        <label for="customerIdInput" class="form-label pms-registration-4col-label mb-0">Customer ID *</label>
                    </div>
                    <div class="col-12 col-lg-10">
                        <div class="d-flex gap-2 flex-wrap align-items-center">
                            <input type="text" id="customerIdInput" class="form-control" placeholder="Enter Customer ID" style="max-width: 280px;" value="@((string?)ViewBag.PreSelectedCustomerId ?? "")" />
                            <button type="button" class="btn btn-sm btn-primary" id="searchCustomerBtn">
                                <i class="fas fa-search me-1"></i>Search
                            </button>
                        </div>
                    </div>
                </div>

                <div id="customerInfoPanel" style="display:none;">
                    <div class="row g-2 pms-registration-4col-row align-items-start">
                        <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Name</div></div>
                        <div class="col-12 col-lg-4"><div class="pms-registration-details-value" id="custName"></div></div>
                        <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">CNIC</div></div>
                        <div class="col-12 col-lg-4"><div class="pms-registration-details-value" id="custCnic"></div></div>
                    </div>
                    <div class="row g-2 pms-registration-4col-row align-items-start">
                        <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Phone</div></div>
                        <div class="col-12 col-lg-4"><div class="pms-registration-details-value" id="custPhone"></div></div>
                        <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Project/Plan</div></div>
                        <div class="col-12 col-lg-4"><div class="pms-registration-details-value" id="custProjectPlan"></div></div>
                    </div>
                </div>
            </div>
            <div id="customerSearchError" class="text-danger mt-2" style="display:none;"></div>
        </div>
    </div>

    <div id="installmentsSection" class="card border-0 shadow-sm pms-mp-header mb-3" style="display:none;">
        <div class="card-header py-2 pms-mp-header-bar">
            <h6 class="mb-0"><i class="fas fa-list me-2"></i>Installments &amp; Surcharge</h6>
        </div>
        <div class="card-body py-3 px-3">
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Inst #</th>
                            <th>Due Date</th>
                            <th class="text-end">Amount</th>
                            <th class="text-end">Paid</th>
                            <th class="text-end">Outstanding</th>
                            <th class="text-end">Surcharge</th>
                        </tr>
                    </thead>
                    <tbody id="linesBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <form asp-action="Create" method="post" id="waiverForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CustomerID" id="hiddenCustomerId" />

        <div class="card border-0 shadow-sm pms-mp-header pms-registration-create mb-3">
            <div class="card-header py-2 pms-mp-header-bar">
                <h6 class="mb-0"><i class="fas fa-file-invoice me-2"></i>Waiver Details</h6>
            </div>
            <div class="card-body py-3 px-3">
                <div class="pms-registration-4col-form">
                    <div class="row g-2 pms-registration-4col-row align-items-start">
                        <div class="col-12 col-lg-2">
                            <label asp-for="WaiverType" class="form-label pms-registration-4col-label">Waiver Type</label>
                        </div>
                        <div class="col-12 col-lg-4">
                            <input asp-for="WaiverType" class="form-control" value="Surcharge Waiver" readonly />
                        </div>
                        <div class="col-12 col-lg-2">
                            <label asp-for="AccountHead" class="form-label pms-registration-4col-label">Account Head</label>
                        </div>
                        <div class="col-12 col-lg-4">
                            <input asp-for="AccountHead" class="form-control" value="Surcharge Waived Off" readonly />
                        </div>
                    </div>

                    <div class="row g-2 pms-registration-4col-row align-items-start">
                        <div class="col-12 col-lg-2">
                            <label asp-for="TotalAmount" class="form-label pms-registration-4col-label">Total Surcharge (PKR)</label>
                        </div>
                        <div class="col-12 col-lg-4">
                            <input asp-for="TotalAmount" id="totalSurchargeInput" class="form-control" readonly />
                        </div>
                        <div class="col-12 col-lg-2">
                            <label asp-for="WaivedPercentage" class="form-label pms-registration-4col-label">Waived Percentage (%)</label>
                        </div>
                        <div class="col-12 col-lg-4">
                            <input asp-for="WaivedPercentage" id="waivedPercentageInput" type="number" class="form-control" min="0" max="100" step="0.01" />
                        </div>
                    </div>

                    <div class="row g-2 pms-registration-4col-row align-items-start">
                        <div class="col-12 col-lg-2">
                            <label asp-for="WaivedAmount" class="form-label pms-registration-4col-label">Waived Amount (PKR) *</label>
                        </div>
                        <div class="col-12 col-lg-4">
                            <input asp-for="WaivedAmount" id="waivedAmountInput" type="number" class="form-control" min="0" step="0.01" />
                            <span asp-validation-for="WaivedAmount" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-lg-2">
                            <label asp-for="Comments" class="form-label pms-registration-4col-label">Comments *</label>
                        </div>
                        <div class="col-12 col-lg-4">
                            <textarea asp-for="Comments" class="form-control" rows="2" maxlength="2000" placeholder="Enter comments"></textarea>
                            <span asp-validation-for="Comments" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-sm fw-semibold pms-mp-btn-save" id="submitBtn">
                <i class="fas fa-check me-1"></i>Submit Waiver
            </button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

<style>
    .pms-waiver-create .pms-waiver-customer-search > .card-body {
        padding-top: 0.4rem !important;
        padding-bottom: 0.4rem !important;
        background: #ffffff !important;
    }

    .pms-waiver-create .pms-waiver-customer-search .pms-registration-4col-form .pms-registration-4col-row,
    .pms-waiver-create .pms-waiver-customer-search.pms-mp-header .pms-registration-4col-form .pms-registration-4col-row {
        margin-bottom: 0.15rem !important;
        padding-top: 0.1rem !important;
        padding-bottom: 0.15rem !important;
    }

    .pms-waiver-create .pms-waiver-customer-id-row {
        margin-bottom: 0 !important;
        padding-top: 0.05rem !important;
        padding-bottom: 0.05rem !important;
        border-bottom: none !important;
    }

    .pms-waiver-create .pms-registration-4col-form .pms-registration-4col-row {
        margin-bottom: 0.25rem;
        padding-top: 0.2rem;
        padding-bottom: 0.25rem;
        border-bottom: 1px solid #e2e8f0;
        background: transparent !important;
    }

    .pms-waiver-create .pms-registration-4col-form .pms-registration-4col-row:last-child {
        margin-bottom: 0;
        border-bottom: none;
        padding-bottom: 0;
    }

    .pms-waiver-create .pms-registration-4col-label {
        font-size: 0.72rem;
        font-weight: 600;
        color: #000 !important;
        line-height: 1.2;
        margin-bottom: 0;
    }

    .pms-waiver-create .pms-registration-details-value,
    .pms-waiver-create .form-control,
    .pms-waiver-create .form-select {
        color: #2563eb !important;
        font-weight: 500;
    }

    .pms-waiver-create .form-control::placeholder {
        color: #93c5fd;
        font-weight: 400;
    }

    .pms-waiver-create .pms-mp-header > .card-body {
        background: #ffffff !important;
    }
</style>

@section Scripts {
<script>
(function () {
    let totalSurcharge = 0;

    function setError(msg) {
        if (!msg) {
            $('#customerSearchError').hide().text('');
            return;
        }
        $('#customerSearchError').text(msg).show();
    }

    function renderLines(lines) {
        const body = $('#linesBody').empty();
        if (!lines || lines.length === 0) {
            body.append('<tr><td colspan="6" class="text-center text-muted py-3">No installment records found.</td></tr>');
            return;
        }
        lines.forEach(function (line) {
            body.append(`<tr>
                <td>${line.installmentNo ?? '-'}</td>
                <td>${line.dueDate}</td>
                <td class="text-end">${Number(line.amount || 0).toLocaleString()}</td>
                <td class="text-end">${Number(line.paid || 0).toLocaleString()}</td>
                <td class="text-end">${Number(line.outstanding || 0).toLocaleString()}</td>
                <td class="text-end">${Number(line.surcharge || 0).toLocaleString()}</td>
            </tr>`);
        });
    }

    function recalculateFromPercentage() {
        const pct = parseFloat($('#waivedPercentageInput').val()) || 0;
        if (pct < 0 || pct > 100) return;
        const amount = totalSurcharge * (pct / 100);
        $('#waivedAmountInput').val(amount.toFixed(2));
    }

    function recalculateFromAmount() {
        const amount = parseFloat($('#waivedAmountInput').val()) || 0;
        if (totalSurcharge <= 0) {
            $('#waivedPercentageInput').val('');
            return;
        }
        const pct = (amount / totalSurcharge) * 100;
        $('#waivedPercentageInput').val(pct.toFixed(2));
    }

    function searchCustomer() {
        const customerId = ($('#customerIdInput').val() || '').trim();
        if (!customerId) {
            setError('Enter a Customer ID.');
            return;
        }
        setError('');
        $.post('@Url.Action("SearchCustomerForWaiver")', { customerId: customerId }, function (res) {
            if (!res.success) {
                $('#customerInfoPanel').hide();
                $('#installmentsSection').hide();
                $('#hiddenCustomerId').val('');
                setError(res.message || 'Unable to fetch customer.');
                return;
            }

            $('#custName').text(res.fullName || '—');
            $('#custCnic').text(res.cnic || '—');
            $('#custPhone').text(res.phone || '—');
            $('#custProjectPlan').text((res.project || '—') + ' / ' + (res.plan || '—'));
            $('#customerInfoPanel').show();
            $('#hiddenCustomerId').val(res.customerID || '');
            $('#searchCustomerBtn').addClass('d-none');

            renderLines(res.lines || []);
            $('#installmentsSection').show();

            totalSurcharge = Number(res.totalSurcharge || 0);
            $('#totalSurchargeInput').val(totalSurcharge.toFixed(2));
            $('#waivedAmountInput').val(totalSurcharge.toFixed(2));
            $('#waivedPercentageInput').val(totalSurcharge > 0 ? '100.00' : '');
        }).fail(function () {
            setError('Error searching customer. Try again.');
        });
    }

    $('#searchCustomerBtn').on('click', searchCustomer);
    $('#customerIdInput').on('keypress', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            searchCustomer();
        }
    });
    $('#waivedPercentageInput').on('input', recalculateFromPercentage);
    $('#waivedAmountInput').on('input', recalculateFromAmount);

    const preSelectedCustomerId = ('@((string?)ViewBag.PreSelectedCustomerId ?? "")' || '').trim();
    if (preSelectedCustomerId) {
        searchCustomer();
    }
})();
</script>
}
