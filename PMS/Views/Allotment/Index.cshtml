@model IEnumerable<PMS.Models.Allotment>

@{
    ViewData["Title"] = "Allotments";
    ViewData["ListingHideToolbarActions"] = true;
    ViewData["ListingHideTitle"] = true;
    var workflowStatuses = ViewBag.WorkflowStatuses as List<string> ?? new List<string> { "Initiated", "Operations Desk", "Approved", "Declined" };
    var initiatedStatus = (string?)ViewBag.InitiatedStatus ?? "Initiated";
    var operationsDeskStatus = (string?)ViewBag.OperationsDeskStatus ?? "Operations Desk";
    var approvedStatus = (string?)ViewBag.ApprovedStatus ?? "Approved";
    var declinedStatus = (string?)ViewBag.DeclinedStatus ?? "Declined";
}

<div class="pms-allotment-listing pms-listing-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h5 class="pms-grid-title pms-allotment-page-heading mb-0">Allotments</h5>
        @if (Model != null)
        {
            <span class="badge rounded-pill pms-record-badge">@Model.Count() record@(Model.Count() == 1 ? "" : "s")</span>
        }
    </div>

    <div class="row g-2 mb-2">
        <div class="col-6 col-md-3">
            <a href="@Url.Action("Index", new { statusFilter = initiatedStatus })" class="text-decoration-none">
                <div class="card border-0 h-100" style="background:#fff3cd;">
                    <div class="card-body text-center py-2 px-2">
                        <div class="small text-muted text-uppercase fw-semibold mb-0">@initiatedStatus</div>
                        <div class="fs-5 fw-bold text-warning mb-0">@(ViewBag.InitiatedCount ?? 0)</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="@Url.Action("Index", new { statusFilter = operationsDeskStatus })" class="text-decoration-none">
                <div class="card border-0 h-100" style="background:#d1ecf1;">
                    <div class="card-body text-center py-2 px-2">
                        <div class="small text-muted text-uppercase fw-semibold mb-0">@operationsDeskStatus</div>
                        <div class="fs-5 fw-bold text-info mb-0">@(ViewBag.OperationsDeskCount ?? 0)</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="@Url.Action("Index", new { statusFilter = approvedStatus })" class="text-decoration-none">
                <div class="card border-0 h-100" style="background:#d4edda;">
                    <div class="card-body text-center py-2 px-2">
                        <div class="small text-muted text-uppercase fw-semibold mb-0">@approvedStatus</div>
                        <div class="fs-5 fw-bold text-success mb-0">@(ViewBag.Approved ?? 0)</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="@Url.Action("Index", new { statusFilter = declinedStatus })" class="text-decoration-none">
                <div class="card border-0 h-100" style="background:#f8d7da;">
                    <div class="card-body text-center py-2 px-2">
                        <div class="small text-muted text-uppercase fw-semibold mb-0">@declinedStatus</div>
                        <div class="fs-5 fw-bold text-danger mb-0">@(ViewBag.Declined ?? 0)</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <form method="get" asp-action="Index" class="mb-2 pms-listing-page">
        <div class="pms-listing-search-wrap">
            <div class="row g-1 align-items-end flex-lg-nowrap">
                <div class="col-12 col-md-4 col-lg-3">
                    <div class="pms-compact-field pms-select-dropdown">
                        <label for="projectFilter" class="form-label">Project</label>
                        <select name="projectFilter" id="projectFilter" class="form-select" onchange="this.form.submit()">
                            <option value="All" selected="@(ViewBag.ProjectFilter == "All")">All Projects</option>
                            @if (ViewBag.Projects != null)
                            {
                                foreach (var project in ViewBag.Projects)
                                {
                                    <option value="@project.ProjectID" selected="@(ViewBag.ProjectFilter == project.ProjectID)">
                                        @project.ProjectName
                                    </option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-12 col-md-3 col-lg-2">
                    <div class="pms-compact-field pms-select-dropdown">
                        <label for="statusFilter" class="form-label">Status</label>
                        <select name="statusFilter" id="statusFilter" class="form-select" onchange="this.form.submit()">
                            <option value="All" selected="@(ViewBag.StatusFilter == "All")">All Status</option>
                            @foreach (var s in workflowStatuses)
                            {
                                <option value="@s" selected="@(ViewBag.StatusFilter == s)">@s</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-12 col-md-5 col-lg-4">
                    <div class="pms-compact-field">
                        <label for="searchTerm" class="form-label">Search</label>
                        <div class="input-group pms-inline-search-group">
                            <input type="text" name="searchTerm" id="searchTerm" class="form-control"
                                   placeholder="Search by ID, Customer, Property..."
                                   value="@ViewBag.SearchTerm" />
                            <button type="submit" class="btn btn-primary pms-inline-search-btn" title="Search">
                                <i class="bi bi-search" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row g-1 mt-1">
                <div class="col-12">
                    <div class="pms-listing-search-actions">
                        <partial name="_OperationsDropdown" />
                    </div>
                </div>
            </div>
        </div>
    </form>

    <div class="card pms-grid-card pms-listing-flat pms-saas-grid pms-listing-page mb-2">
        <div class="card-body py-2">
            @if (Model.Any())
            {
                <div class="table-responsive pms-saas-table-wrap">
                    <table class="table pms-saas-table" id="allotmentsTable">
                        <thead>
                            <tr>
                                <th>Property</th>
                                <th>Customer</th>
                                <th>Project</th>
                                <th class="pms-allotment-type-col">Type</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var allotment in Model)
                            {
                                var wf = allotment.WorkFlowStatus ?? initiatedStatus;
                                var pillClass = string.Equals(wf, approvedStatus, StringComparison.OrdinalIgnoreCase)
                                    ? "pms-pill--success"
                                    : string.Equals(wf, declinedStatus, StringComparison.OrdinalIgnoreCase)
                                        ? "pms-pill--danger"
                                        : string.Equals(wf, operationsDeskStatus, StringComparison.OrdinalIgnoreCase)
                                            ? "pms-pill--info"
                                            : "pms-pill--warning";
                                <tr class="pms-listing-row" data-href="@Url.Action("Details", new { id = allotment.AllotmentID })">
                                    <td data-label="Property">
                                        @if (allotment.Property != null)
                                        {
                                            <strong class="pms-cell-truncate d-block" title="@allotment.Property.PlotNo">@allotment.Property.PlotNo</strong>
                                            <small class="text-muted">Block: @allotment.Property.Block | @allotment.Property.Size</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td data-label="Customer">
                                        @if (allotment.Customer != null)
                                        {
                                            <strong class="pms-cell-truncate d-block" title="@allotment.Customer.FullName">@allotment.Customer.FullName</strong>
                                            <small class="text-muted">@allotment.Customer.CustomerID</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td data-label="Project">
                                        @if (allotment.Property?.Project != null)
                                        {
                                            <span class="pms-pill pms-pill--info">@allotment.Property.Project.ProjectName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="pms-allotment-type-col" data-label="Type">
                                        <span class="pms-pill pms-pill--neutral">@allotment.AllottmentType</span>
                                    </td>
                                    <td data-label="Status">
                                        <span class="pms-pill @pillClass">@wf</span>
                                    </td>
                                    <td data-label="Date">
                                        <span class="text-nowrap">@allotment.AllotmentDate.ToString("MMM dd, yyyy")</span>
                                        <small class="text-muted d-block">@allotment.AllotmentDate.ToString("hh:mm tt")</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-inbox fs-1 mb-2 d-block" aria-hidden="true"></i>
                    <p class="mb-2">No allotments found.</p>
                    <a asp-action="Create" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Create Allotment
                    </a>
                </div>
            }
        </div>
    </div>

    <div class="card pms-listing-flat pms-registration-details">
        <div class="card-header">
            <h6 class="mb-0"><i class="fas fa-chart-bar me-1"></i>Property Allocation by Project</h6>
        </div>
        <div class="card-body">
            <canvas id="allocationChart" style="max-height: 320px;"></canvas>
        </div>
    </div>
</div>

<style>
    .pms-allotment-listing .pms-allotment-page-heading {
        font-size: 1.2rem;
        font-weight: 700;
        color: #0f172a;
    }

    .pms-allotment-listing .pms-saas-table thead th {
        font-size: 10.5px !important;
    }

    .pms-allotment-listing .pms-allotment-type-col {
        width: 8%;
        max-width: 100px;
        white-space: nowrap;
    }

    .pms-allotment-listing .pms-allotment-type-col .pms-pill {
        font-size: 0.7rem;
        padding: 0.15rem 0.4rem;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function () {
            if ($('#allotmentsTable').length) {
                PmsListingDataTable.init('#allotmentsTable', {
                    pageLength: 20,
                    order: [[5, 'desc']],
                    columnDefs: [
                        { width: '8%', targets: 3 }
                    ],
                    dom: 'rt<"pms-allotment-dt-footer d-flex flex-wrap align-items-center justify-content-between gap-2 mt-2"lip>'
                });
                PmsListingDataTable.bindRowNavigation('#allotmentsTable');
            }

            var chartData = @Html.Raw(ViewBag.ChartData);
            var ctx = document.getElementById('allocationChart');
            if (!ctx || !chartData || !chartData.length) return;

            var labels = chartData.map(function (d) { return d.projectName; });
            var allottedData = chartData.map(function (d) { return d.allotted; });
            var notAllottedData = chartData.map(function (d) { return d.notAllotted; });

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Allotted',
                            data: allottedData,
                            backgroundColor: 'rgba(37, 99, 235, 0.7)',
                            borderColor: '#2563eb',
                            borderWidth: 1,
                            borderRadius: 4
                        },
                        {
                            label: 'Not Allotted (Available)',
                            data: notAllottedData,
                            backgroundColor: 'rgba(71, 85, 105, 0.5)',
                            borderColor: '#475569',
                            borderWidth: 1,
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: { position: 'top' },
                        tooltip: {
                            callbacks: {
                                afterLabel: function (context) {
                                    var index = context.dataIndex;
                                    return 'Total Properties: ' + chartData[index].total;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { precision: 0 },
                            grid: { color: 'rgba(203, 213, 225, 0.5)' }
                        },
                        x: { grid: { display: false } }
                    }
                }
            });
        });
    </script>
}
