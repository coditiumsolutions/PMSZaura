@model IEnumerable<PMS.Models.User>

@{
    ViewData["Title"] = "User Management";
    ViewData["HidePageBanner"] = true;
    ViewData["ListingHideTitle"] = false;
    ViewData["ListingRecordCount"] = Model?.Count() ?? 0;
    ViewData["ListingAddUrl"] = Url.Action("CreateUser");
    ViewData["ListingAddText"] = "Add New User";
    ViewData["ListingExtraActions"] =
        "<a href=\"" + Url.Action("Index", "UserMac") + "\" class=\"btn btn-outline-primary btn-sm\">" +
        "<i class=\"bi bi-shield-check me-1\" aria-hidden=\"true\"></i>Manage mTLS Certificates</a>";
}

<div class="row g-2 mb-3 users-stats-compact">
    <div class="col-6 col-md-3">
        <div class="stats-card">
            <div class="stats-number">@Model.Count()</div>
            <div class="stats-label">Total Users</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stats-card">
            <div class="stats-number">@Model.Count(u => u.IsActive)</div>
            <div class="stats-label">Active Users</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stats-card">
            <div class="stats-number">@Model.Count(u => !u.IsActive)</div>
            <div class="stats-label">Inactive Users</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stats-card">
            <div class="stats-number">@Model.Select(u => u.RoleID).Distinct().Count()</div>
            <div class="stats-label">Total Roles</div>
        </div>
    </div>
</div>

<div class="card pms-grid-card pms-listing-flat pms-saas-grid pms-listing-page pms-users-listing">
    <div class="card-body">
        <partial name="Listing/_GridToolbar" />

        <div class="table-responsive pms-saas-table-wrap">
            <table class="table pms-saas-table" id="usersTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Desig</th>
                        <th>Dept</th>
                        <th>User Type</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th class="pms-saas-th-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.OrderBy(u => u.FullName))
                    {
                        <tr>
                            <td data-label="ID"><span class="pms-users-id">@user.UserID</span></td>
                            <td data-label="Name">
                                <span class="pms-cell-truncate" title="@user.FullName">@user.FullName</span>
                            </td>
                            <td data-label="Email"><span class="pms-cell-truncate" title="@user.Email">@user.Email</span></td>
                            <td data-label="Desig">@(user.Designation ?? "—")</td>
                            <td data-label="Dept">@(user.Department ?? "—")</td>
                            <td data-label="User Type">
                                @if (!string.IsNullOrEmpty(user.UserType))
                                {
                                    <span class="pms-pill pms-pill--info">@user.UserType</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td data-label="Role">
                                @if (user.Role != null)
                                {
                                    <span class="pms-pill pms-pill--info">@user.Role.RoleName</span>
                                }
                                else
                                {
                                    <span class="text-muted">No Role</span>
                                }
                            </td>
                            <td data-label="Status">
                                @if (user.IsActive)
                                {
                                    <span class="pms-pill pms-pill--success">Active</span>
                                }
                                else
                                {
                                    <span class="pms-pill pms-pill--danger">Inactive</span>
                                }
                            </td>
                            <td class="pms-saas-td-actions" data-label="Actions">
                                <div class="pms-row-actions" role="group">
                                    <a asp-action="EditUser"
                                       asp-route-id="@user.UserID"
                                       class="btn btn-sm btn-outline-secondary"
                                       title="View / Edit User">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                    </a>
                                    <a asp-action="EditUser"
                                       asp-route-id="@user.UserID"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Edit User">
                                        <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                    </a>
                                    <button type="button"
                                            class="btn btn-sm @(user.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                            onclick="toggleUserStatus('@user.UserID', @user.IsActive.ToString().ToLower())"
                                            title="@(user.IsActive ? "Deactivate" : "Activate")">
                                        <i class="bi bi-@(user.IsActive ? "slash-circle" : "check-circle")" aria-hidden="true"></i>
                                    </button>
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-controller="UserMac"
                                       asp-action="Index"
                                       asp-route-userId="@user.UserID"
                                       title="Manage mTLS certificates">
                                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .pms-users-listing .pms-grid-title {
        font-size: 0.8rem !important;
        font-weight: 600 !important;
        color: #334155 !important;
        letter-spacing: 0.01em;
        line-height: 1.25;
    }

    .pms-users-listing #usersTable thead th {
        background: #E8EAE4 !important;
        color: #334155 !important;
        font-size: 0.75rem !important;
        font-weight: 600 !important;
        padding-top: 0.35rem !important;
        padding-bottom: 0.35rem !important;
        border-bottom: 1px solid #d1d5db !important;
        white-space: nowrap;
    }

    .pms-users-listing #usersTable,
    .pms-users-listing #usersTable tbody td,
    .pms-users-listing #usersTable tbody td span,
    .pms-users-listing #usersTable tbody td strong {
        color: #000 !important;
    }

    .pms-users-listing #usersTable tbody td:first-child,
    .pms-users-listing #usersTable tbody td:first-child .pms-users-id {
        color: #1e3a8a !important;
        font-weight: 600;
    }

    .users-stats-compact .stats-card {
        background: #f8fafc;
        border-radius: 10px;
        padding: 0.65rem 0.75rem;
        text-align: center;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
        border: 1px solid #e2e8f0;
        min-height: 0;
    }

    .users-stats-compact .stats-number {
        font-size: 1.35rem;
        font-weight: 700;
        color: #000;
        margin-bottom: 0.15rem;
        line-height: 1.2;
    }

    .users-stats-compact .stats-label {
        font-size: 10px;
        color: #000;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.35px;
        margin: 0;
        line-height: 1.2;
    }

</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#usersTable').DataTable({
                pageLength: 25,
                order: [[1, 'asc']],
                columnDefs: [{ orderable: false, targets: 8 }],
                dom: '<"d-flex justify-content-end mb-2"f>rt<"d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2"lip>'
            });
        });

        function toggleUserStatus(userId, isActive) {
            var action = isActive ? 'deactivate' : 'activate';
            if (confirm('Are you sure you want to ' + action + ' this user?')) {
                $.ajax({
                    url: '@Url.Action("ToggleUserStatus", "Account")',
                    type: 'POST',
                    data: { userId: userId },
                    success: function(response) {
                        if (response.success) {
                            alert(response.message);
                            location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    },
                    error: function() {
                        alert('An error occurred while updating user status.');
                    }
                });
            }
        }
    </script>
}
