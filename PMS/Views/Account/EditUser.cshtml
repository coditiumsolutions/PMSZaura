@model PMS.Models.User
@{
    ViewData["Title"] = "Edit User";
    ViewData["HidePageBanner"] = true;
    var perms = ViewBag.ModulePermissions as Dictionary<string, string> ?? new Dictionary<string, string>();
}

<div class="pms-settings-edit pms-edit-user">
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <h5 class="mb-0 pms-settings-edit-title">
            <i class="fas fa-user-edit me-1"></i>Edit User
        </h5>
        <a asp-action="Users" class="btn btn-sm btn-outline-secondary py-0 px-2">
            <i class="fas fa-arrow-left me-1"></i>Back to Users
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger py-2 small">@ViewBag.Error</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success py-2 small">@TempData["Success"]</div>
    }

    <form asp-action="EditUser" method="post" id="editUserForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserID" />
        <input type="hidden" asp-for="PasswordHash" />
        <input type="hidden" asp-for="CreatedAt" />

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header py-1 px-3 pms-settings-edit-header">
                <h6 class="mb-0">User Information</h6>
            </div>
            <div class="card-body py-3 px-3 bg-white">
                <div class="pms-registration-4col-form">
                    <div class="row g-2 align-items-center mb-2">
                        <div class="col-12 col-lg-2">
                            <label class="form-label mb-0 fw-semibold">User ID</label>
                        </div>
                        <div class="col-12 col-lg-4">
                            <input type="text" class="form-control form-control-sm" value="@Model.UserID" disabled />
                            <small class="text-muted">Cannot be changed</small>
                        </div>
                        <div class="col-12 col-lg-2">
                            <label asp-for="FullName" class="form-label mb-0 fw-semibold">Full Name *</label>
                        </div>
                        <div class="col-12 col-lg-4">
                            <input asp-for="FullName" class="form-control form-control-sm" placeholder="Enter full name" required />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row g-2 align-items-center mb-2">
                        <div class="col-12 col-lg-2">
                            <label asp-for="Email" class="form-label mb-0 fw-semibold">Email *</label>
                        </div>
                        <div class="col-12 col-lg-4">
                            <input asp-for="Email" type="email" class="form-control form-control-sm" placeholder="user@example.com" required />
                            <small class="text-muted">Used for login</small>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-lg-2">
                            <label class="form-label mb-0 fw-semibold">Created</label>
                        </div>
                        <div class="col-12 col-lg-4">
                            <input type="text" class="form-control form-control-sm" value="@Model.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")" disabled />
                        </div>
                    </div>

                    <div class="row g-2 align-items-center mb-2">
                        <div class="col-12 col-lg-2">
                            <label asp-for="Designation" class="form-label mb-0 fw-semibold">Designation</label>
                        </div>
                        <div class="col-12 col-lg-4">
                            <select asp-for="Designation" class="form-select form-select-sm">
                                <option value="">Select designation</option>
                                @if (ViewBag.Designations != null)
                                {
                                    var designations = (IEnumerable<string>)ViewBag.Designations;
                                    var currentDesignation = Model.Designation;
                                    if (!string.IsNullOrEmpty(currentDesignation) && !designations.Contains(currentDesignation))
                                    {
                                        <option value="@currentDesignation" selected>@currentDesignation</option>
                                    }
                                    @foreach (var d in designations)
                                    {
                                        <option value="@d">@d</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-12 col-lg-2">
                            <label asp-for="Department" class="form-label mb-0 fw-semibold">Department</label>
                        </div>
                        <div class="col-12 col-lg-4">
                            <select asp-for="Department" class="form-select form-select-sm">
                                <option value="">Select department</option>
                                @if (ViewBag.Departments != null)
                                {
                                    var departments = (IEnumerable<string>)ViewBag.Departments;
                                    var currentDepartment = Model.Department;
                                    if (!string.IsNullOrEmpty(currentDepartment) && !departments.Contains(currentDepartment))
                                    {
                                        <option value="@currentDepartment" selected>@currentDepartment</option>
                                    }
                                    @foreach (var d in departments)
                                    {
                                        <option value="@d">@d</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 align-items-center mb-0">
                        <div class="col-12 col-lg-2">
                            <label asp-for="UserType" class="form-label mb-0 fw-semibold">User Type</label>
                        </div>
                        <div class="col-12 col-lg-4">
                            <select asp-for="UserType" class="form-select form-select-sm">
                                <option value="">Select type</option>
                                <option value="Admin">Admin</option>
                                <option value="Manager">Manager</option>
                                <option value="CRO">CRO</option>
                            </select>
                        </div>
                        <div class="col-12 col-lg-2">
                            <label class="form-label mb-0 fw-semibold">Status</label>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="form-check form-switch mb-0">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label asp-for="IsActive" class="form-check-label small">Active User</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header py-1 px-3 pms-settings-edit-header">
                <h6 class="mb-0">Module Rights</h6>
            </div>
            <div class="card-body py-3 px-3 bg-white">
                <p class="text-muted small mb-2">No Access = no access; Read = view only; Author = write/create only; Edit = Create + Edit + Read; Admin = full CRUD.</p>
                <div class="mb-2 d-flex flex-wrap gap-1 align-items-center">
                    <span class="small text-muted me-1">Quick:</span>
                    <button type="button" class="btn btn-outline-dark btn-sm py-0 px-2 js-set-all-permissions" data-permission="NoAccess">NoAccess</button>
                    <button type="button" class="btn btn-outline-info btn-sm py-0 px-2 js-set-all-permissions" data-permission="Read">Read</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 js-set-all-permissions" data-permission="Author">Author</button>
                    <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2 js-set-all-permissions" data-permission="Edit">Edit</button>
                    <button type="button" class="btn btn-outline-success btn-sm py-0 px-2 js-set-all-permissions" data-permission="Admin">Admin</button>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0 pms-edit-user-perms">
                        <thead>
                            <tr>
                                <th>Module</th>
                                <th style="width: 12rem;">Permission</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.ModuleKeys != null)
                            {
                                @foreach (var key in (string[])ViewBag.ModuleKeys)
                                {
                                    var current = perms.TryGetValue(key, out var p) ? p : "NoAccess";
                                    var displayName = key switch
                                    {
                                        "PaymentAudit" => "Audit",
                                        "DuplicateFileTransfer" => "Duplicate file transfer",
                                        "Account" => "User profile & login screens",
                                        "AccountsManagement" => "Accounts Management",
                                        _ => key
                                    };
                                    var permissionOptions = new List<string>();
                                    if (ViewBag.PermissionOptions != null)
                                    {
                                        permissionOptions.AddRange((string[])ViewBag.PermissionOptions);
                                    }
                                    if (!permissionOptions.Contains("Author"))
                                    {
                                        permissionOptions.Add("Author");
                                    }
                                    <tr>
                                        <td>@displayName</td>
                                        <td>
                                            <select name="ModulePermissions_@key" class="form-select form-select-sm module-permission-select">
                                                @foreach (var opt in permissionOptions)
                                                {
                                                    if (opt == current)
                                                    {
                                                        <option value="@opt" selected>@opt</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@opt">@opt</option>
                                                    }
                                                }
                                            </select>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-1 mb-3">
            <button type="submit" class="btn btn-sm btn-primary py-0 px-2">
                <i class="fas fa-save me-1"></i>Save Changes
            </button>
            <a asp-action="Users" class="btn btn-sm btn-outline-secondary py-0 px-2">Cancel</a>
        </div>
    </form>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header py-1 px-3 pms-settings-edit-header">
            <h6 class="mb-0">Reset Password</h6>
        </div>
        <div class="card-body py-3 px-3 bg-white">
            @if (TempData["ResetPasswordError"] != null)
            {
                <div class="alert alert-danger py-2 small">@TempData["ResetPasswordError"]</div>
            }
            <form asp-action="ResetUserPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" value="@Model.UserID" />
                <div class="pms-registration-4col-form">
                    <div class="row g-2 align-items-end">
                        <div class="col-12 col-lg-2">
                            <label class="form-label mb-0 fw-semibold">New Password</label>
                        </div>
                        <div class="col-12 col-lg-3">
                            <input type="password" name="newPassword" class="form-control form-control-sm" placeholder="Min 6 characters" minlength="6" />
                        </div>
                        <div class="col-12 col-lg-2">
                            <label class="form-label mb-0 fw-semibold">Confirm</label>
                        </div>
                        <div class="col-12 col-lg-3">
                            <input type="password" name="confirmPassword" class="form-control form-control-sm" placeholder="Re-enter password" minlength="6" />
                        </div>
                        <div class="col-12 col-lg-2">
                            <button type="submit" class="btn btn-sm btn-warning py-0 px-2 w-100">
                                <i class="fas fa-key me-1"></i>Reset
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-2">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header py-1 px-3 pms-settings-edit-header">
                    <h6 class="mb-0">Authenticator (2FA)</h6>
                </div>
                <div class="card-body py-3 px-3 bg-white">
                    <p class="small mb-2">
                        Status: <strong>@(Model.TwoFactorEnabled ? "Registered" : "Not registered")</strong>
                    </p>
                    <p class="small text-muted mb-2">Reset if the user lost their phone so they can scan a new QR on next login.</p>
                    <form asp-action="ResetTwoFactor" method="post" onsubmit="return confirm('Reset authenticator for this user?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@Model.UserID" />
                        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">
                            <i class="fas fa-undo me-1"></i>Reset 2FA
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header py-1 px-3 pms-settings-edit-header">
                    <h6 class="mb-0">User Statistics</h6>
                </div>
                <div class="card-body py-3 px-3 bg-white">
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="small text-muted">Total Sessions</div>
                            <div class="fw-semibold">@(Model.UserSessions?.Count ?? 0)</div>
                        </div>
                        <div class="col-6">
                            <div class="small text-muted">Total Activities</div>
                            <div class="fw-semibold">@(Model.ActivityLogs?.Count ?? 0)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .pms-settings-edit-title {
        font-size: 1.05rem;
        font-weight: 650;
        color: #000;
    }

    .pms-settings-edit-header {
        background: #E8EAE4 !important;
        border-bottom: 1px solid #d1d5db;
        color: #000;
    }

    .pms-settings-edit-header h6 {
        color: #000 !important;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .pms-edit-user .form-label,
    .pms-edit-user .form-control,
    .pms-edit-user .form-select,
    .pms-edit-user small,
    .pms-edit-user td {
        color: #000;
    }

    .pms-edit-user-perms thead th {
        background: #E8EAE4 !important;
        color: #334155 !important;
        font-size: 0.75rem;
        font-weight: 600;
        border-bottom: 1px solid #d1d5db;
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            $(document).on('click', '.js-set-all-permissions', function () {
                $('.module-permission-select').val($(this).data('permission'));
            });
        });
    </script>
}
