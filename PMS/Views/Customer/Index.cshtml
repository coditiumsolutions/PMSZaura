@model IEnumerable<PMS.Models.Customer>

@{
    ViewData["Title"] = "Search Customers";
    ViewData["ListingAddUrl"] = ViewBag.CanCreate == true ? Url.Action("Create") : null;
    ViewData["ListingShowAdd"] = false;
    ViewData["ListingHideRefresh"] = true;
    ViewData["ListingHideToolbarActions"] = true;

    var showBulkSelection = (ViewBag.StatusFilter as string) == "Pending" && ViewBag.CanEdit == true;
    ViewData["ShowBulkSelection"] = showBulkSelection;
    var customerCount = Model?.Count() ?? 0;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2 mb-2 small" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show py-2 mb-2 small" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="pms-customer-listing pms-listing-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h5 class="pms-grid-title pms-customer-page-heading mb-0">Customers</h5>
        <span class="badge rounded-pill pms-record-badge">@customerCount record@(customerCount == 1 ? "" : "s")</span>
    </div>

<form method="get" asp-action="Index" class="mb-2">
    <div class="pms-customer-search-wrap pms-listing-search-wrap pms-customer-search-panel">
        <div class="row g-1 align-items-center flex-lg-nowrap pms-customer-search-fields">
            <div class="col-12 col-md-6 col-lg-3">
                <div class="pms-compact-field pms-select-dropdown">
                    <label for="projectFilter" class="visually-hidden">Project</label>
                    <select name="projectFilter" id="projectFilter" class="form-select" onchange="this.form.submit()" aria-label="Project">
                        <option value="All" selected="@(ViewBag.ProjectFilter == "All")">All Projects</option>
                        @if (ViewBag.Projects != null)
                        {
                            @foreach (var project in ViewBag.Projects)
                            {
                                <option value="@project.ProjectID" selected="@(ViewBag.ProjectFilter == project.ProjectID)">
                                    @project.ProjectName
                                </option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-2">
                <div class="pms-compact-field pms-select-dropdown">
                    <label for="statusFilter" class="visually-hidden">Status</label>
                    <select name="statusFilter" id="statusFilter" class="form-select" onchange="this.form.submit()" aria-label="Status">
                        <option value="All" selected="@(ViewBag.StatusFilter == "All")">All Status</option>
                        <option value="Active" selected="@(ViewBag.StatusFilter == "Active")">Active</option>
                        <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending")">Pending</option>
                        <option value="Inactive" selected="@(ViewBag.StatusFilter == "Inactive")">Inactive</option>
                        <option value="Marked for Deletion" selected="@(ViewBag.StatusFilter == "Marked for Deletion")">Marked for Deletion</option>
                    </select>
                </div>
            </div>
            <div class="col-12 col-lg pms-customer-search-term-field">
                <div class="pms-compact-field">
                    <label for="searchTerm" class="visually-hidden">Search Customer</label>
                    <input type="text"
                           name="searchTerm"
                           id="searchTerm"
                           class="form-control"
                           placeholder="Search Customer"
                           aria-label="Search Customer"
                           value="@ViewBag.SearchTerm" />
                </div>
            </div>
            <div class="col-12 col-lg-auto">
                <div class="pms-compact-field pms-customer-search-actions pms-customer-inline-action">
                    <div class="d-flex flex-nowrap gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="bi bi-search me-1" aria-hidden="true"></i>Search
                        </button>
                        <partial name="_OperationsDropdown" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@if (showBulkSelection)
{
    <form asp-action="BulkUpdatePendingCustomers" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="projectFilter" value="@ViewBag.ProjectFilter" />
        <input type="hidden" name="searchTerm" value="@ViewBag.SearchTerm" />

        <div class="card pms-search-card mb-3">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="fw-bold">Pending Customer Actions:</span>
                    <select name="bulkAction" id="bulkAction" class="form-select form-select-sm" style="width: 240px;" required>
                        <option value="">Select Action</option>
                        <option value="Activate">Make Active</option>
                        <option value="MarkForDeletion">Mark for Deletion</option>
                    </select>
                    <button type="submit" class="btn btn-warning btn-sm" id="applyBulkActionBtn" disabled>
                        <i class="fas fa-check-double me-1"></i>Apply to Selected
                    </button>
                    <small class="text-muted">Select customers below, choose action, and enter comments.</small>
                </div>
                <div class="mt-2">
                    <label for="bulkActionComments" class="form-label fw-bold mb-1">Comments <span class="text-danger">*</span></label>
                    <textarea id="bulkActionComments"
                              name="comments"
                              class="form-control form-control-sm"
                              rows="2"
                              maxlength="1000"
                              placeholder="Enter reason/comments for this status change"
                              required></textarea>
                </div>
            </div>
        </div>

        <div class="card pms-grid-card pms-listing-flat pms-customer-listing pms-customer-grid-compact mb-2">
            <div class="card-body py-2">
                <partial name="_CustomerDataGrid" model="Model" />
            </div>
        </div>
    </form>
}
else
{
    <div class="card pms-grid-card pms-listing-flat pms-customer-listing pms-customer-grid-compact mb-2">
        <div class="card-body py-2">
            <partial name="_CustomerDataGrid" model="Model" />
        </div>
    </div>
}
</div>

<style>
    .pms-customer-page-heading {
        font-size: 1.2rem;
        font-weight: 700;
        color: #0f172a;
    }

    .pms-customer-search-panel {
        padding: 0.75rem 1rem !important;
        background: #e8eef8 !important;
        border: 1px solid #c5d0e0 !important;
        border-radius: 12px;
    }

    .pms-customer-search-fields {
        margin-top: 0 !important;
        align-items: center !important;
    }

    .pms-customer-listing .pms-customer-search-panel .form-label:not(.visually-hidden) {
        display: none !important;
    }

    .pms-customer-inline-action .btn {
        min-height: var(--pms-listing-control-h, 36px);
        white-space: nowrap;
    }

    .pms-customer-grid-compact > .card-body {
        padding-top: 0.25rem !important;
    }

    .pms-customer-listing .pms-customer-dt-footer {
        width: 100%;
        padding: 0.5rem 0.25rem 0.25rem;
    }

    .pms-customer-listing .pms-customer-dt-footer .dataTables_length,
    .pms-customer-listing .pms-customer-dt-footer .dataTables_info,
    .pms-customer-listing .pms-customer-dt-footer .dataTables_paginate {
        float: none !important;
        padding: 0 !important;
        margin: 0 !important;
        font-size: 0.8125rem;
        color: #64748b;
    }

    .pms-customer-listing .pms-customer-dt-footer .dataTables_length select {
        border-radius: 8px;
        border: 1px solid #94a3b8;
        padding: 0.2rem 1.75rem 0.2rem 0.5rem;
        min-height: 32px;
        height: 32px;
        font-size: 0.8125rem;
        margin: 0 0.35rem;
        background-color: #fff;
    }

    .pms-customer-listing .pms-customer-dt-footer .dataTables_paginate {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.15rem;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            var showBulkSelection = @showBulkSelection.ToString().ToLowerInvariant();
            var customerIdColumnIndex = showBulkSelection ? 1 : 0;

            if ($('#customersTable').length) {
                PmsListingDataTable.init('#customersTable', {
                    searching: false,
                    order: [[ customerIdColumnIndex, "desc" ]],
                    dom: 'rt<"pms-customer-dt-footer d-flex flex-wrap align-items-center justify-content-between gap-2 mt-2"lip>'
                });
                PmsListingDataTable.bindRowNavigation('#customersTable');
            }

            if (showBulkSelection) {
                var $selectAll = $('#selectAllPendingCustomers');
                var $rowChecks = $('.pending-customer-checkbox');
                var $applyBtn = $('#applyBulkActionBtn');
                var $bulkAction = $('#bulkAction');
                var $comments = $('#bulkActionComments');

                function refreshBulkButtonState() {
                    var anyChecked = $('.pending-customer-checkbox:checked').length > 0;
                    var hasAction = ($bulkAction.val() || '').trim().length > 0;
                    var hasComments = ($comments.val() || '').trim().length > 0;
                    $applyBtn.prop('disabled', !(anyChecked && hasAction && hasComments));
                }

                $selectAll.on('change', function() {
                    $rowChecks.prop('checked', this.checked);
                    refreshBulkButtonState();
                });

                $(document).on('change', '.pending-customer-checkbox', function() {
                    var total = $rowChecks.length;
                    var checked = $('.pending-customer-checkbox:checked').length;
                    $selectAll.prop('checked', total > 0 && total === checked);
                    refreshBulkButtonState();
                });

                $bulkAction.on('change', refreshBulkButtonState);
                $comments.on('input', refreshBulkButtonState);

                refreshBulkButtonState();
            }
        });
    </script>
}
