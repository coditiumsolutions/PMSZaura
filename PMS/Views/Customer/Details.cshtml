@model PMS.Models.Customer

@{
    ViewData["Title"] = "Customer Details";
    var canEdit = ViewBag.CanEdit as bool? == true;
    var canDelete = ViewBag.CanDelete as bool? == true;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center gap-4">
        <!-- <h2 class="mb-0">
            <i class="fas fa-user me-2"></i>Customer Details
        </h2> -->
        <div class="d-flex align-items-center gap-3 ms-4">
            <div class="badge bg-light text-dark px-3 py-2" style="font-size: 14px;">
                <i class="fas fa-calendar-check me-2" style="color: #6f42c1;"></i>
                <strong>Member Since:</strong> @Model.CreatedAt.ToString("MMMM yyyy")
                <span class="text-muted ms-2">(@((DateTime.Now - Model.CreatedAt).Days) days)</span>
            </div>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (canEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.CustomerID" class="btn btn-primary btn-sm">
                <i class="fas fa-edit me-1"></i>Edit
            </a>
        }
        @if (canDelete)
        {
            <a asp-action="Delete" asp-route-id="@Model.CustomerID" class="btn btn-outline-danger btn-sm">
                <i class="fas fa-trash me-1"></i>Delete
            </a>
        }
        <a asp-action="AccountStatement" asp-route-id="@Model.CustomerID" target="_blank" class="btn btn-outline-info btn-sm">
            <i class="fas fa-file-invoice-dollar me-1"></i>Account Statement
        </a>
        @if (Model.Allotments != null && Model.Allotments.Any())
        {
            <a asp-action="AllotmentLetter" asp-route-id="@Model.CustomerID" target="_blank" class="btn btn-outline-info btn-sm">
                <i class="fas fa-file-signature me-1"></i>Allotment Letter
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="fas fa-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>

<div class="row">
    <!-- Main Content with Tabs -->
    <div class="col-12">
        <div class="card pms-listing-flat pms-customer-details">
            <div class="card-header p-0">
                <ul class="nav nav-tabs customer-tabs" id="customerTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="personal-tab" data-bs-toggle="tab" data-bs-target="#personal" type="button" role="tab" aria-controls="personal" aria-selected="true">
                            <i class="fas fa-user-circle me-2"></i>Personal Info
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="contact-tab" data-bs-toggle="tab" data-bs-target="#contact" type="button" role="tab" aria-controls="contact" aria-selected="false">
                            <i class="fas fa-address-book me-2"></i>Contact Info
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="nominee-tab" data-bs-toggle="tab" data-bs-target="#nominee" type="button" role="tab" aria-controls="nominee" aria-selected="false">
                            <i class="fas fa-user-shield me-2"></i>Next of Kin
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="registration-tab" data-bs-toggle="tab" data-bs-target="#registration" type="button" role="tab" aria-controls="registration" aria-selected="false">
                            <i class="fas fa-file-contract me-2"></i>Registration & Plan
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="allotments-tab" data-bs-toggle="tab" data-bs-target="#allotments" type="button" role="tab" aria-controls="allotments" aria-selected="false">
                            <i class="fas fa-building me-2"></i>Allotments
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="activity-tab" data-bs-toggle="tab" data-bs-target="#activity" type="button" role="tab" aria-controls="activity" aria-selected="false">
                            <i class="fas fa-history me-2"></i>Activity
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="transfers-tab" data-bs-toggle="tab" data-bs-target="#transfers" type="button" role="tab" aria-controls="transfers" aria-selected="false">
                            <i class="fas fa-exchange-alt me-2"></i>Transfers
                            @if (Model.Transfers != null && Model.Transfers.Any())
                            {
                                <span class="badge bg-warning rounded-pill ms-1">@Model.Transfers.Count</span>
                            }
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="jointowners-tab" data-bs-toggle="tab" data-bs-target="#jointowners" type="button" role="tab" aria-controls="jointowners" aria-selected="false">
                            <i class="fas fa-users me-2"></i>JointOwners
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="attachments-tab" data-bs-toggle="tab" data-bs-target="#attachments" type="button" role="tab" aria-controls="attachments" aria-selected="false">
                            <i class="fas fa-paperclip me-2"></i>Attachments
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content" id="customerTabContent">
                    <!-- Personal Information Tab -->
                    <div class="tab-pane fade show active" id="personal" role="tabpanel" aria-labelledby="personal-tab">
                        <div class="pms-registration-4col-form">
                            <div class="row g-2 pms-registration-4col-row align-items-start">
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Customer ID</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value"><code>@Model.CustomerID</code></div></div>
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Status</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value"><span class="badge @(Model.Status == "Active" ? "bg-success" : "bg-warning")">@Model.Status</span></div></div>
                            </div>
                            <div class="row g-2 pms-registration-4col-row align-items-start">
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Full Name</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.FullName</div></div>
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">S/D/W/O</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.FatherName</div></div>
                            </div>
                            <div class="row g-2 pms-registration-4col-row align-items-start">
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">National ID</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.CNIC</div></div>
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Passport No</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@(Model.PassportNo ?? "N/A")</div></div>
                            </div>
                            <div class="row g-2 pms-registration-4col-row align-items-start">
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Date of Birth</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@(Model.DOB?.ToString("dd-MM-yyyy") ?? "N/A")</div></div>
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Gender</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.Gender</div></div>
                            </div>
                            <div class="row g-2 pms-registration-4col-row align-items-start">
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Nationality</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@(Model.Nationality ?? "N/A")</div></div>
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Form No</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@(Model.FormNo ?? "N/A")</div></div>
                            </div>
                        </div>
                    </div>

                    <!-- Contact Information Tab -->
                    <div class="tab-pane fade" id="contact" role="tabpanel" aria-labelledby="contact-tab">
                        <div class="pms-registration-4col-form">
                            <div class="row g-2 pms-registration-4col-row align-items-start">
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Phone</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.Phone</div></div>
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Mobile</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.MobileNo</div></div>
                            </div>
                            <div class="row g-2 pms-registration-4col-row align-items-start">
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Mobile 2</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@(string.IsNullOrWhiteSpace(Model.MobileNo2) ? "—" : Model.MobileNo2)</div></div>
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Email</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.Email</div></div>
                            </div>
                            <div class="row g-2 pms-registration-4col-row align-items-start">
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">City</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.City</div></div>
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Country</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.Country</div></div>
                            </div>
                            <div class="row g-2 pms-registration-4col-row align-items-start">
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Mailing Address</div></div>
                                <div class="col-12 col-lg-10"><div class="pms-registration-details-value">@Model.MailingAddress</div></div>
                            </div>
                            <div class="row g-2 pms-registration-4col-row align-items-start">
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Permanent Address</div></div>
                                <div class="col-12 col-lg-10"><div class="pms-registration-details-value">@Model.PermanentAddress</div></div>
                            </div>
                        </div>
                    </div>

                    <!-- Next of Kin Information Tab -->
                    <div class="tab-pane fade" id="nominee" role="tabpanel" aria-labelledby="nominee-tab">
                        <div class="pms-registration-4col-form">
                            <div class="row g-2 pms-registration-4col-row align-items-start">
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Next of Kin Name</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@(Model.NomineeName ?? "N/A")</div></div>
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Next of Kin ID</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@(Model.NomineeID ?? "N/A")</div></div>
                            </div>
                            <div class="row g-2 pms-registration-4col-row align-items-start">
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Relationship</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@(Model.NomineeRelation ?? "N/A")</div></div>
                            </div>
                        </div>
                    </div>

                    <!-- Registration & Plan Tab -->
                    <div class="tab-pane fade" id="registration" role="tabpanel" aria-labelledby="registration-tab">
                        @if (Model.Registration != null)
                        {
                            <h6 class="mb-3"><i class="fas fa-file-alt me-2"></i>Registration Information</h6>
                            <div class="pms-registration-4col-form mb-4">
                                <div class="row g-2 pms-registration-4col-row align-items-start">
                                    <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Registration ID</div></div>
                                    <div class="col-12 col-lg-4"><div class="pms-registration-details-value"><code>@Model.Registration.RegID</code></div></div>
                                    <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Registered On</div></div>
                                    <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.Registration.CreatedAt.ToString("MMM dd, yyyy")</div></div>
                                </div>
                                <div class="row g-2 pms-registration-4col-row align-items-start">
                                    <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Status</div></div>
                                    <div class="col-12 col-lg-4"><div class="pms-registration-details-value"><span class="badge bg-success">@Model.Registration.Status</span></div></div>
                                </div>
                            </div>
                        }

                        @if (Model.PaymentPlan != null)
                        {
                            <h6 class="mb-3 pms-customer-section-title"><i class="fas fa-credit-card me-2"></i>Payment Plan</h6>
                            <div class="pms-registration-4col-form mb-4">
                                <div class="row g-2 pms-registration-4col-row align-items-start">
                                    <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Plan Name</div></div>
                                    <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.PaymentPlan.PlanName</div></div>
                                    <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Total Amount</div></div>
                                    <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.PaymentPlan.TotalAmount.ToString("N2") PKR</div></div>
                                </div>
                                <div class="row g-2 pms-registration-4col-row align-items-start">
                                    <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Duration</div></div>
                                    <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@(Model.PaymentPlan.DurationMonths?.ToString() ?? "N/A") Months</div></div>
                                    <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Frequency</div></div>
                                    <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.PaymentPlan.Frequency</div></div>
                                </div>
                                @if (Model.PaymentPlan.PaymentSchedules != null && Model.PaymentPlan.PaymentSchedules.Any())
                                {
                                    var totalPaid = Model.PaymentPlan.PaymentSchedules
                                        .SelectMany(ps => ps.Payments ?? new List<PMS.Models.Payment>())
                                        .Where(p => p.Status == "Completed")
                                        .Sum(p => p.Amount);
                                    var totalDue = Model.PaymentPlan.TotalAmount;
                                    var percentage = totalDue > 0 ? (totalPaid / totalDue) * 100 : 0;

                                    <div class="row g-2 pms-registration-4col-row align-items-start">
                                        <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Payment Progress</div></div>
                                        <div class="col-12 col-lg-10">
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar" role="progressbar"
                                                     style="width: @percentage%; background: linear-gradient(135deg, var(--primary-green) 0%, var(--accent-gold) 100%);"
                                                     aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100">
                                                    @percentage.ToString("N1")%
                                                </div>
                                            </div>
                                            <small class="pms-registration-details-value mt-1 d-block">
                                                @totalPaid.ToString("N2") / @totalDue.ToString("N2") PKR
                                            </small>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <h6 class="mb-3 pms-customer-section-title"><i class="fas fa-project-diagram me-2"></i>Project Details</h6>
                        <div class="pms-registration-4col-form @(!string.IsNullOrEmpty(Model.AdditionalInfo) ? "mb-4" : "")">
                            <div class="row g-2 pms-registration-4col-row align-items-start">
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Sub Project</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@(Model.SubProject ?? "N/A")</div></div>
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Registered Size</div></div>
                                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@(Model.RegisteredSize ?? "N/A")</div></div>
                            </div>
                            <div class="row g-2 pms-registration-4col-row align-items-start">
                                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Dealer</div></div>
                                <div class="col-12 col-lg-10">
                                    <div class="pms-registration-details-value">
                                        @if (Model.IsDealerRegistered == 0 && !string.IsNullOrWhiteSpace(Model.DealerName))
                                        {
                                            @Model.DealerName <span class="badge bg-secondary ms-1">Not Registered</span>
                                        }
                                        else if (Model.Dealer != null)
                                        {
                                            @Model.Dealer.DealershipName <span class="badge bg-success ms-1">Registered</span>
                                        }
                                        else
                                        {
                                            <span>N/A</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.AdditionalInfo))
                        {
                            <h6 class="mb-3 pms-customer-section-title"><i class="fas fa-sticky-note me-2"></i>Additional Notes</h6>
                            <div class="pms-registration-details-value">@Model.AdditionalInfo</div>
                        }
                    </div>

                    <!-- Property Allotments Tab -->
                    <div class="tab-pane fade" id="allotments" role="tabpanel" aria-labelledby="allotments-tab">
                @if (Model.Allotments != null && Model.Allotments.Any())
                {
                    @foreach (var allotment in Model.Allotments)
                    {
                        <div class="mb-4">
                            <h6 class="mb-3 pms-customer-section-title">
                                <i class="fas fa-building me-2"></i>Allotment
                                <code class="ms-1">@allotment.AllotmentID</code>
                            </h6>
                            <div class="pms-registration-4col-form">
                                <div class="row g-2 pms-registration-4col-row align-items-start">
                                    <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Allotment ID</div></div>
                                    <div class="col-12 col-lg-4"><div class="pms-registration-details-value"><code>@allotment.AllotmentID</code></div></div>
                                    <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Status</div></div>
                                    <div class="col-12 col-lg-4">
                                        <div class="pms-registration-details-value">
                                            @if (allotment.WorkFlowStatus == "Approved")
                                            {
                                                <span class="badge bg-success">@allotment.WorkFlowStatus</span>
                                            }
                                            else if (allotment.WorkFlowStatus == "Pending" || allotment.WorkFlowStatus == "Pending Approval")
                                            {
                                                <span class="badge bg-warning">@allotment.WorkFlowStatus</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary">@(allotment.WorkFlowStatus ?? "N/A")</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="row g-2 pms-registration-4col-row align-items-start">
                                    <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Plot No</div></div>
                                    <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@(allotment.Property?.PlotNo ?? "N/A")</div></div>
                                    <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Block</div></div>
                                    <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@(allotment.Property?.Block ?? "N/A")</div></div>
                                </div>
                                <div class="row g-2 pms-registration-4col-row align-items-start">
                                    <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Size</div></div>
                                    <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@(allotment.Property?.Size ?? "N/A")</div></div>
                                    <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Type</div></div>
                                    <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@(allotment.AllottmentType ?? "N/A")</div></div>
                                </div>
                                <div class="row g-2 pms-registration-4col-row align-items-start">
                                    <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Allotment Date</div></div>
                                    <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@allotment.AllotmentDate.ToString("MMM dd, yyyy")</div></div>
                                    <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Property ID</div></div>
                                    <div class="col-12 col-lg-4"><div class="pms-registration-details-value"><code>@(allotment.PropertyID ?? "N/A")</code></div></div>
                                </div>
                                <div class="row g-2 pms-registration-4col-row align-items-start">
                                    <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Project</div></div>
                                    <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@(allotment.Property?.Project?.ProjectName ?? Model.PaymentPlan?.Project?.ProjectName ?? "N/A")</div></div>
                                    <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Street</div></div>
                                    <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@(string.IsNullOrWhiteSpace(allotment.Property?.Street) ? "N/A" : allotment.Property.Street)</div></div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(allotment.Comments))
                                {
                                    <div class="row g-2 pms-registration-4col-row align-items-start">
                                        <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Comments</div></div>
                                        <div class="col-12 col-lg-10"><div class="pms-registration-details-value">@allotment.Comments</div></div>
                                    </div>
                                }
                                <div class="row g-2 pms-registration-4col-row align-items-start">
                                    <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Actions</div></div>
                                    <div class="col-12 col-lg-10">
                                        <div class="pms-registration-details-value">
                                            <div class="btn-group" role="group">
                                                <a asp-controller="Allotment" asp-action="Details" asp-route-id="@allotment.AllotmentID"
                                                   class="btn btn-sm btn-outline-info" title="View Allotment">
                                                    <i class="fas fa-eye me-1"></i>View
                                                </a>
                                                @if (allotment.WorkFlowStatus == "Pending" || allotment.WorkFlowStatus == "Pending Approval")
                                                {
                                                    <a asp-controller="Allotment" asp-action="Details" asp-route-id="@allotment.AllotmentID"
                                                       class="btn btn-sm btn-outline-primary" title="Edit Allotment">
                                                        <i class="fas fa-edit me-1"></i>Edit
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a href="@Url.Action("UnAllot", "Allotment")"
                                                       class="btn btn-sm btn-outline-danger" title="Un-Allot Property">
                                                        <i class="fas fa-undo me-1"></i>Un-Allot
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div id="noAllotmentSection">
                        <div class="alert alert-info mb-4">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>No Allotment Found</strong><br>
                            This customer does not have a property allotted yet. You can start the allotment process below.
                        </div>

                        @if (Model.PaymentPlan == null || string.IsNullOrEmpty(Model.PaymentPlan.ProjectID) || string.IsNullOrEmpty(Model.RegisteredSize))
                        {
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                <strong>Cannot Create Allotment:</strong>
                                @if (Model.PaymentPlan == null || string.IsNullOrEmpty(Model.PaymentPlan.ProjectID))
                                {
                                    <p>Customer must have a Payment Plan with an assigned Project.</p>
                                }
                                @if (string.IsNullOrEmpty(Model.RegisteredSize))
                                {
                                    <p>Customer must have a Registered Size set.</p>
                                }
                                <a asp-action="Edit" asp-route-id="@Model.CustomerID" class="btn btn-sm btn-primary mt-2">
                                    <i class="fas fa-edit me-2"></i>Edit Customer to Set Required Information
                                </a>
                            </div>
                        }
                        else
                        {
                            <h6 class="mb-3 pms-customer-section-title">
                                <i class="fas fa-plus-circle me-2"></i>Start Allotment Process
                            </h6>
                            <form id="createAllotmentForm">
                                <input type="hidden" id="customerID" value="@Model.CustomerID" />
                                <input type="hidden" id="projectID" value="@Model.PaymentPlan.ProjectID" />
                                <input type="hidden" id="registeredSize" value="@Model.RegisteredSize" />

                                <div class="pms-registration-4col-form">
                                    <div class="row g-2 pms-registration-4col-row align-items-start">
                                        <div class="col-12 col-lg-2"><label class="form-label pms-registration-4col-label">Customer Project</label></div>
                                        <div class="col-12 col-lg-4">
                                            <input type="text" class="form-control" value="@(Model.PaymentPlan.Project?.ProjectName ?? "N/A")" readonly />
                                            <small class="text-muted d-block">Properties will be filtered by this project</small>
                                        </div>
                                        <div class="col-12 col-lg-2"><label class="form-label pms-registration-4col-label">Registered Size</label></div>
                                        <div class="col-12 col-lg-4">
                                            <input type="text" class="form-control" value="@Model.RegisteredSize" readonly />
                                            <small class="text-muted d-block">Properties will be filtered by this size</small>
                                        </div>
                                    </div>
                                    <div class="row g-2 pms-registration-4col-row align-items-start">
                                        <div class="col-12 col-lg-2"><label class="form-label pms-registration-4col-label" for="allotmentType">Allotment Type *</label></div>
                                        <div class="col-12 col-lg-4">
                                            <select id="allotmentType" class="form-select" required>
                                                <option value="">Select Type</option>
                                                <option value="Regular">Regular</option>
                                                <option value="Transfer">Transfer</option>
                                                <option value="Balloting">Balloting</option>
                                                <option value="Special">Special</option>
                                            </select>
                                        </div>
                                        <div class="col-12 col-lg-2"><label class="form-label pms-registration-4col-label" for="propertyID">Select Property *</label></div>
                                        <div class="col-12 col-lg-4">
                                            <select id="propertyID" class="form-select" required>
                                                <option value="">Loading properties...</option>
                                            </select>
                                            <small class="text-muted d-block">Only available properties matching project and size are shown</small>
                                        </div>
                                    </div>
                                    <div class="row g-2 pms-registration-4col-row align-items-start">
                                        <div class="col-12 col-lg-2"><label class="form-label pms-registration-4col-label" for="comments">Comments</label></div>
                                        <div class="col-12 col-lg-10">
                                            <textarea id="comments" class="form-control" rows="3" placeholder="Enter any comments or notes..."></textarea>
                                        </div>
                                    </div>
                                    <div class="row g-2 pms-registration-4col-row align-items-start">
                                        <div class="col-12 col-lg-2"></div>
                                        <div class="col-12 col-lg-10">
                                            <button type="submit" class="btn btn-success btn-sm">
                                                <i class="fas fa-check me-1"></i>Create Allotment
                                            </button>
                                            <button type="button" class="btn btn-secondary btn-sm" onclick="loadProperties()">
                                                <i class="fas fa-redo me-1"></i>Refresh Properties List
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        }
                    </div>
                }
                    </div>

                    <!-- Activity History Tab (ActivityLog where RefID = CustomerID) -->
                    <div class="tab-pane fade" id="activity" role="tabpanel" aria-labelledby="activity-tab">
                @{
                    var activityLogs = ViewBag.ActivityLogs as IEnumerable<PMS.Models.ActivityLog>;
                }
                @if (activityLogs != null && activityLogs.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>User</th>
                                    <th>Action</th>
                                    <th>Ref Type</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in activityLogs)
                                {
                                    <tr class="activity-log-row js-activity-log-row"
                                        data-created-at="@log.CreatedAt.ToString("MMM dd, yyyy HH:mm")"
                                        data-user="@(log.User?.FullName ?? log.UserID ?? "—")"
                                        data-action="@(log.Action ?? "—")"
                                        data-ref-type="@(log.RefType ?? "—")"
                                        data-ref-id="@(log.RefID ?? "—")"
                                        data-details="@(log.Details ?? "")">
                                        <td class="text-muted small">@log.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                        <td>@(log.User?.FullName ?? log.UserID ?? "—")</td>
                                        <td>
                                            <i class="fas fa-circle-notch me-2" style="font-size: 8px;"></i>
                                            @(log.Action ?? "—")
                                        </td>
                                        <td><span class="badge bg-secondary">@(log.RefType ?? "—")</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-3">
                        <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                        <p class="mb-0">No activity logs found for this customer.</p>
                    </div>
                }
                    </div>

                    <!-- Transfers Tab -->
                    <div class="tab-pane fade" id="transfers" role="tabpanel" aria-labelledby="transfers-tab">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0"><i class="fas fa-exchange-alt me-2"></i>Ownership Transfers</h6>
                            <a asp-controller="Transfer" asp-action="Create" asp-route-customerId="@Model.CustomerID" class="btn btn-sm btn-primary">
                                <i class="fas fa-plus me-1"></i>New Transfer
                            </a>
                        </div>
                        @if (Model.Transfers != null && Model.Transfers.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Transfer ID</th>
                                            <th>Seller</th>
                                            <th>Buyer</th>
                                            <th>Workflow</th>
                                            <th>Created</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var t in Model.Transfers.OrderByDescending(t => t.CreatedAt))
                                        {
                                            <tr>
                                                <td><code>@t.TransferID</code></td>
                                                <td>@(t.SellerName ?? "—")</td>
                                                <td>@(t.BuyerName ?? "—")</td>
                                                <td>
                                                    @if (t.WorkFlowStatus == "Approved")
                                                    { <span class="badge bg-success">@t.WorkFlowStatus</span> }
                                                    else
                                                    { <span class="badge bg-warning">@(t.WorkFlowStatus ?? "—")</span> }
                                                </td>
                                                <td>@t.CreatedAt.ToString("MMM dd, yyyy")</td>
                                                <td>
                                                    <a asp-controller="Transfer" asp-action="Details" asp-route-id="@t.TransferID" class="btn btn-sm btn-outline-info">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    @if (t.WorkFlowStatus != "Approved")
                                                    {
                                                        <a asp-controller="Transfer" asp-action="Edit" asp-route-id="@t.TransferID" class="btn btn-sm btn-outline-primary">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info mb-0">
                                <i class="fas fa-info-circle me-2"></i>No transfers for this customer file. <a asp-controller="Transfer" asp-action="Create" asp-route-customerId="@Model.CustomerID">Start a transfer</a>.
                            </div>
                        }
                    </div>

                    <!-- Joint Owners Tab -->
                    <div class="tab-pane fade" id="jointowners" role="tabpanel" aria-labelledby="jointowners-tab">
                        @Html.AntiForgeryToken()
                        <div class="pms-registration-4col-form mb-3">
                            <div class="row g-2 pms-registration-4col-row align-items-start">
                                <div class="col-12 col-lg-2">
                                    <label for="jointOwnerName" class="form-label pms-registration-4col-label">Joint Owner Name *</label>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <input type="text" id="jointOwnerName" class="form-control" placeholder="Enter joint owner name" />
                                    <small class="text-muted">Letters, spaces, dots and hyphens only.</small>
                                </div>
                                <div class="col-12 col-lg-2">
                                    <label for="jointOwnerFatherName" class="form-label pms-registration-4col-label">Son /D/W/o</label>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <input type="text" id="jointOwnerFatherName" class="form-control" placeholder="Enter father name" />
                                </div>
                            </div>
                            <div class="row g-2 pms-registration-4col-row align-items-start">
                                <div class="col-12 col-lg-2">
                                    <label for="jointOwnerCNIC" class="form-label pms-registration-4col-label">CNIC *</label>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <input type="text" id="jointOwnerCNIC" class="form-control" placeholder="XXXXX-XXXXXXX-X" maxlength="15" />
                                </div>
                                <div class="col-12 col-lg-2">
                                    <label for="jointOwnerContact" class="form-label pms-registration-4col-label">Contact *</label>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <input type="text" id="jointOwnerContact" class="form-control" placeholder="03XXXXXXXXX" />
                                    <small class="text-muted">Must be 11 to 13 digits.</small>
                                </div>
                            </div>
                            <div class="row g-2 pms-registration-4col-row align-items-start">
                                <div class="col-12 col-lg-2">
                                    <label for="jointOwnerAddress" class="form-label pms-registration-4col-label">Address</label>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <input type="text" id="jointOwnerAddress" class="form-control" placeholder="Address" />
                                </div>
                                <div class="col-12 col-lg-2">
                                    <label for="jointOwnerPercentage" class="form-label pms-registration-4col-label">Percentage</label>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <input type="number" id="jointOwnerPercentage" class="form-control" min="0" max="100" step="0.01" placeholder="e.g. 50" />
                                </div>
                            </div>
                            <div class="row g-2 pms-registration-4col-row align-items-start">
                                <div class="col-12 col-lg-2">
                                    <label for="jointOwnerDetails" class="form-label pms-registration-4col-label">Details</label>
                                </div>
                                <div class="col-12 col-lg-10">
                                    <textarea id="jointOwnerDetails" class="form-control" rows="2" placeholder="Any additional details"></textarea>
                                </div>
                            </div>
                            <div class="row g-2 pms-registration-4col-row align-items-center">
                                <div class="col-12 col-lg-2 d-none d-lg-block"></div>
                                <div class="col-12 col-lg-10">
                                    <button type="button" class="btn btn-primary btn-sm" onclick="addJointOwnerFromDetails()">
                                        <i class="fas fa-plus me-1"></i>Add Joint Owner
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover" id="jointOwnersTable">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Son /D/W/o</th>
                                        <th>CNIC</th>
                                        <th>Contact</th>
                                        <th>Percentage</th>
                                        <th>Address</th>
                                        <th>Created</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="7" class="text-muted text-center">Loading joint owners...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Attachments Tab -->
                    <div class="tab-pane fade" id="attachments" role="tabpanel" aria-labelledby="attachments-tab">
                        <div class="row">
                            <div class="col-12">
                                <h6 class="mb-3"><i class="fas fa-paperclip me-2"></i>Customer Attachments</h6>

                                <!-- Customer Picture Section -->
                                <div class="card mb-4" style="border-color: rgb(104, 167, 226);">
                                    <div class="card-header text-white" style="background: linear-gradient(135deg, rgb(104, 167, 226) 0%, rgb(72, 123, 165) 100%);">
                                        <h6 class="mb-0"><i class="fas fa-user-circle me-2"></i>Customer Picture</h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="text-center mb-3" id="customerPicturePreview">
                                                    <img id="customerPictureImg" src="" alt="Customer Picture" class="img-thumbnail" style="max-width: 200px; max-height: 200px; display: none;" />
                                                    <div id="customerPicturePlaceholder" class="text-muted">
                                                        <i class="fas fa-user-circle fa-5x"></i>
                                                        <p class="mt-2">No picture uploaded</p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-8">
                                                <div class="mb-3">
                                                    <label class="form-label" for="customerPictureFile">Upload Customer Picture</label>
                                                    <input type="file" id="customerPictureFile" class="form-control" accept="image/*" />
                                                    <small class="text-muted">Only image files (JPG, PNG, GIF, BMP). Max size: 8MB</small>
                                                </div>
                                                <button type="button" class="btn text-white" style="background: linear-gradient(135deg, rgb(104, 167, 226) 0%, rgb(72, 123, 165) 100%);" onclick="uploadAttachment('CustomerPicture', 'customerPictureFile')">
                                                    <i class="fas fa-upload me-2"></i>Upload Picture
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- ID Card Section -->
                                <div class="card mb-4" style="border-color: rgb(104, 167, 226);">
                                    <div class="card-header text-white" style="background: linear-gradient(135deg, rgb(104, 167, 226) 0%, rgb(72, 123, 165) 100%);">
                                        <h6 class="mb-0"><i class="fas fa-id-card me-2"></i>Customer ID Card</h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="text-center mb-3" id="idCardPreview">
                                                    <img id="idCardImg" src="" alt="ID Card" class="img-thumbnail" style="max-width: 200px; max-height: 200px; display: none;" />
                                                    <div id="idCardPlaceholder" class="text-muted">
                                                        <i class="fas fa-id-card fa-5x"></i>
                                                        <p class="mt-2">No ID card uploaded</p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-8">
                                                <div class="mb-3">
                                                    <label class="form-label" for="idCardFile">Upload ID Card</label>
                                                    <input type="file" id="idCardFile" class="form-control" accept="image/*,.pdf" multiple />
                                                    <small class="text-muted">Image files (JPG, PNG, GIF, BMP) or PDF. Max size: 8MB each. You can upload multiple files (e.g., front and back).</small>
                                                </div>
                                                <button type="button" class="btn text-white" style="background: linear-gradient(135deg, rgb(104, 167, 226) 0%, rgb(72, 123, 165) 100%);" onclick="uploadAttachment('IDCard', 'idCardFile')">
                                                    <i class="fas fa-upload me-2"></i>Upload ID Card
                                                </button>
                                                <div id="idCardFilesContainer" class="row mt-3"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Other Attachments Section -->
                                <div class="card mb-4" style="border-color: rgb(104, 167, 226);">
                                    <div class="card-header text-white" style="background: linear-gradient(135deg, rgb(104, 167, 226) 0%, rgb(72, 123, 165) 100%);">
                                        <h6 class="mb-0"><i class="fas fa-folder-open me-2"></i>Other Attachments</h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label class="form-label">Upload Additional Attachment</label>
                                            <div class="row g-2">
                                                <div class="col-md-6">
                                                    <input type="file" id="otherAttachmentFile" class="form-control" accept="image/*,.pdf" />
                                                    <small class="text-muted">Image files or PDF. Max size: 8MB</small>
                                                </div>
                                                <div class="col-md-4">
                                                    <input type="text" id="otherAttachmentDescription" class="form-control" placeholder="Description (optional)" />
                                                </div>
                                                <div class="col-md-2">
                                                    <button type="button" class="btn text-white w-100" style="background: linear-gradient(135deg, rgb(104, 167, 226) 0%, rgb(72, 123, 165) 100%);" onclick="uploadAttachment('Other', 'otherAttachmentFile', 'otherAttachmentDescription')">
                                                        <i class="fas fa-upload me-2"></i>Upload
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <div id="attachmentsList" class="mt-4">
                                            <h6 class="mb-3">Uploaded Attachments</h6>
                                            <div id="attachmentsContainer" class="row">
                                                <div class="col-12 text-center text-muted py-3">
                                                    <i class="fas fa-spinner fa-spin fa-2x mb-2"></i>
                                                    <p>Loading attachments...</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="activityLogDetailsModal" tabindex="-1" aria-labelledby="activityLogDetailsModalLabel" aria-hidden="true" data-bs-backdrop="false">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="activityLogDetailsModalLabel">
                    <i class="fas fa-file-alt me-2"></i>Log Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted small mb-1">Date</label>
                        <div class="form-control bg-light" id="logModalDate">—</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small mb-1">User</label>
                        <div class="form-control bg-light" id="logModalUser">—</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small mb-1">Action</label>
                        <div class="form-control bg-light" id="logModalAction">—</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small mb-1">Ref Type</label>
                        <div class="form-control bg-light" id="logModalRefType">—</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small mb-1">Ref ID</label>
                        <div class="form-control bg-light" id="logModalRefId">—</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label text-muted small mb-1">Details</label>
                        <pre class="form-control bg-light" id="logModalDetails" style="height: 220px; white-space: pre-wrap;">—</pre>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Card / form — no background */
    .pms-customer-details.card {
        background: transparent;
        border: none;
        box-shadow: none;
    }

    .pms-customer-details .card-body {
        background: transparent;
        padding-left: 0;
        padding-right: 0;
    }

    /* Tab Styling — keep all tabs on one row */
    .pms-customer-details .customer-tabs {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        white-space: nowrap;
        border-bottom: 1px solid #e5e7eb;
        background: transparent;
        padding: 0.35rem 0 0;
        gap: 0;
        scrollbar-width: thin;
    }

    .pms-customer-details .customer-tabs .nav-item {
        flex: 0 0 auto;
    }

    .pms-customer-details .customer-tabs .nav-link {
        color: #64748b;
        font-weight: 600;
        border: none;
        border-bottom: 2px solid transparent;
        padding: 0.45rem 0.55rem;
        transition: color 0.2s ease, border-color 0.2s ease;
        font-size: 0.78rem;
        background: transparent;
        white-space: nowrap;
        line-height: 1.2;
    }

    .pms-customer-details .customer-tabs .nav-link:hover {
        color: #2563eb;
        background: transparent;
        border-bottom-color: #cbd5e1;
    }

    .pms-customer-details .customer-tabs .nav-link.active {
        color: #2563eb;
        background: transparent;
        border-bottom-color: #2563eb;
        font-weight: 700;
    }

    .pms-customer-details .customer-tabs .nav-link i {
        font-size: 0.72rem;
        margin-right: 0.25rem !important;
    }

    .pms-customer-details .customer-tabs .nav-link .badge {
        font-size: 0.65rem;
        vertical-align: middle;
    }

    /* Tab Content — compact */
    .pms-customer-details .tab-content {
        padding-top: 0.5rem;
    }

    .pms-customer-details > .card-body {
        padding-top: 0.5rem !important;
        padding-bottom: 0.5rem !important;
    }

    /* Compact field / title rows across all tabs */
    .pms-customer-details .pms-registration-4col-form .pms-registration-4col-row,
    .pms-customer-details .pms-mp-header .pms-registration-4col-form .pms-registration-4col-row {
        --bs-gutter-y: 0.15rem;
        --bs-gutter-x: 0.5rem;
        margin-bottom: 0.2rem !important;
        padding-top: 0.15rem !important;
        padding-bottom: 0.2rem !important;
        border-bottom: 1px solid #e2e8f0 !important;
        align-items: center !important;
    }

    .pms-customer-details .pms-registration-4col-form .pms-registration-4col-row:last-child {
        margin-bottom: 0 !important;
        border-bottom: none;
        padding-bottom: 0 !important;
    }

