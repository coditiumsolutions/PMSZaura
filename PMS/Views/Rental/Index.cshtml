@model IEnumerable<PMS.Models.Rental>

@{
    ViewData["Title"] = "Rentals";
    ViewData["ListingHideToolbarActions"] = true;
    ViewData["ListingHideTitle"] = true;
    var statusSel = ViewBag.StatusFilter as string ?? "";
    var activeStatus = PMS.Models.Rental.StatusActive;
    var completedStatus = PMS.Models.Rental.StatusCompleted;
    var cancelledStatus = PMS.Models.Rental.StatusCancelled;
}

<div class="pms-rental-listing pms-listing-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h5 class="pms-grid-title mb-0">Rentals</h5>
        @if (Model != null)
        {
            <span class="badge rounded-pill pms-record-badge">@Model.Count() record@(Model.Count() == 1 ? "" : "s")</span>
        }
    </div>

    <div class="row g-2 mb-2">
        <div class="col-6 col-md-4">
            <a href="@Url.Action("Index", new { statusFilter = activeStatus })" class="text-decoration-none">
                <div class="card border-0 h-100" style="background:#d4edda;">
                    <div class="card-body text-center py-2 px-2">
                        <div class="small text-muted text-uppercase fw-semibold mb-0">@activeStatus</div>
                        <div class="fs-5 fw-bold text-success mb-0">@(ViewBag.ActiveCount ?? 0)</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4">
            <a href="@Url.Action("Index", new { statusFilter = completedStatus })" class="text-decoration-none">
                <div class="card border-0 h-100" style="background:#d1ecf1;">
                    <div class="card-body text-center py-2 px-2">
                        <div class="small text-muted text-uppercase fw-semibold mb-0">@completedStatus</div>
                        <div class="fs-5 fw-bold text-info mb-0">@(ViewBag.CompletedCount ?? 0)</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4">
            <a href="@Url.Action("Index", new { statusFilter = cancelledStatus })" class="text-decoration-none">
                <div class="card border-0 h-100" style="background:#f8d7da;">
                    <div class="card-body text-center py-2 px-2">
                        <div class="small text-muted text-uppercase fw-semibold mb-0">@cancelledStatus</div>
                        <div class="fs-5 fw-bold text-danger mb-0">@(ViewBag.CancelledCount ?? 0)</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <form method="get" asp-action="Index" class="mb-2">
        <div class="pms-listing-search-wrap">
            <div class="row g-1 align-items-end flex-lg-nowrap">
                <div class="col-12 col-md-4 col-lg-3">
                    <div class="pms-compact-field pms-select-dropdown">
                        <label for="statusFilter" class="form-label">Status</label>
                        <select name="statusFilter" id="statusFilter" class="form-select" onchange="this.form.submit()">
                            <option value="" selected="@(statusSel == "")">All</option>
                            @if (ViewBag.Statuses != null)
                            {
                                foreach (var s in (string[])ViewBag.Statuses)
                                {
                                    <option value="@s" selected="@(statusSel == s)">@s</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-12 col-md-8 col-lg-5">
                    <div class="pms-compact-field">
                        <label for="propertyIdFilter" class="form-label">Property ID</label>
                        <div class="input-group pms-inline-search-group">
                            <input type="text" name="propertyIdFilter" id="propertyIdFilter" class="form-control"
                                   placeholder="Search by property ID"
                                   value="@ViewBag.PropertyIdFilter" />
                            <button type="submit" class="btn btn-primary pms-inline-search-btn" title="Search">
                                <i class="bi bi-search" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row g-1 mt-1">
                <div class="col-12">
                    <div class="pms-listing-search-actions">
                        <partial name="_OperationsDropdown" />
                    </div>
                </div>
            </div>
        </div>
    </form>

    <div class="card pms-grid-card pms-listing-flat pms-saas-grid pms-listing-page mb-2">
        <div class="card-body py-2">
            <div class="table-responsive pms-saas-table-wrap">
                <table class="table pms-saas-table" id="rentalsTable">
                    <thead>
                        <tr>
                            <th>Rental ID</th>
                            <th>Property</th>
                            <th>Tenant</th>
                            <th>Start</th>
                            <th>Monthly Rent</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr class="pms-listing-row" data-href="@Url.Action("Details", new { id = r.RentalID })">
                                <td data-label="Rental ID">
                                    <a asp-action="Details" asp-route-id="@r.RentalID" class="text-decoration-none">
                                        <span class="badge bg-secondary">@r.RentalID</span>
                                    </a>
                                </td>
                                <td data-label="Property">
                                    <div>
                                        <code>@r.PropertyID</code>
                                        @if (!string.IsNullOrWhiteSpace(r.Property?.PlotNo))
                                        {
                                            <div class="text-muted small">Plot: @r.Property?.PlotNo (@(r.Property?.Block ?? "—"))</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(r.Property?.Project?.ProjectName))
                                        {
                                            <span class="pms-pill pms-pill--info mt-1">@r.Property.Project.ProjectName</span>
                                        }
                                    </div>
                                </td>
                                <td data-label="Tenant">
                                    <strong class="pms-cell-truncate d-block" title="@r.TenantName">@r.TenantName</strong>
                                    @if (!string.IsNullOrWhiteSpace(r.TenantPhone))
                                    {
                                        <div class="text-muted small">@r.TenantPhone</div>
                                    }
                                </td>
                                <td data-label="Start"><span class="text-nowrap">@r.StartDate.ToString("MMM dd, yyyy")</span></td>
                                <td data-label="Monthly Rent">
                                    <strong>@r.MonthlyRent.ToString("N0")</strong>
                                    <span class="text-muted small">@r.Currency</span>
                                </td>
                                <td data-label="Status">
                                    @if (r.Status == PMS.Models.Rental.StatusActive)
                                    { <span class="pms-pill pms-pill--success">@r.Status</span> }
                                    else if (r.Status == PMS.Models.Rental.StatusCompleted)
                                    { <span class="pms-pill pms-pill--neutral">@r.Status</span> }
                                    else
                                    { <span class="pms-pill pms-pill--warning">@r.Status</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            PmsListingDataTable.init('#rentalsTable', {
                order: [[0, 'desc']]
            });
            PmsListingDataTable.bindRowNavigation('#rentalsTable');
        });
    </script>
}
