@model IEnumerable<PMS.Models.Payment>

@{
    ViewData["Title"] = "Payment Audit";
    var paymentList = Model?.ToList() ?? new List<PMS.Models.Payment>();
    var auditFilter = ViewBag.AuditFilter as string ?? "";
    var customerFilter = ViewBag.CustomerFilter as string ?? "";
}

<div class="pms-payment-audit pms-listing-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h5 class="pms-grid-title mb-0"><i class="fas fa-search-dollar me-2"></i>Payment Audit</h5>
        <span class="badge rounded-pill pms-record-badge">@paymentList.Count record@(paymentList.Count == 1 ? "" : "s")</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 px-3 mb-2 small" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 px-3 mb-2 small" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="get" asp-action="Index" class="mb-2 pms-payment-audit-filters" id="auditFilterForm">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <div class="pms-compact-field pms-select-dropdown">
                    <label for="auditFilter" class="form-label">Audit Status</label>
                    <select name="auditFilter" id="auditFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="" selected="@(string.IsNullOrEmpty(auditFilter))">All</option>
                        <option value="Pending" selected="@(auditFilter == "Pending")">Pending</option>
                        <option value="Approved" selected="@(auditFilter == "Approved")">Approved</option>
                        <option value="Declined" selected="@(auditFilter == "Declined")">Declined</option>
                    </select>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="pms-compact-field">
                    <label for="customerFilter" class="form-label">Customer ID</label>
                    <div class="input-group input-group-sm">
                        <input type="text"
                               name="customerFilter"
                               id="customerFilter"
                               class="form-control"
                               placeholder="Filter by customer ID"
                               value="@customerFilter"
                               autocomplete="off" />
                        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <div class="pms-saas-grid pms-listing-flat mb-2">
        @if (paymentList.Any())
        {
            <div class="pms-saas-table-wrap pms-payment-audit-grid-wrap">
                <table id="auditTable" class="table pms-saas-table pms-payment-audit-grid-table">
                    <thead>
                        <tr>
                            <th>Customer No</th>
                            <th>Cust Name</th>
                            <th>Installment</th>
                            <th class="text-end">Amount (PKR)</th>
                            <th>Payment Date</th>
                            <th>Audit Status</th>
                            <th>Audited By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in paymentList)
                        {
                            var auditStatus = p.AuditStatus ?? "Pending";
                            var badgeClass = auditStatus == "Approved" ? "bg-success"
                                           : auditStatus == "Declined" ? "bg-danger"
                                           : "bg-warning text-dark";
                            <tr class="pms-payment-audit-row" data-href="@Url.Action("Audit", new { id = p.PaymentID })" style="cursor:pointer;">
                                <td data-label="Customer No"><code>@p.CustomerID</code></td>
                                <td data-label="Cust Name">@(p.Customer?.FullName ?? "—")</td>
                                <td data-label="Installment">
                                    @(p.PaymentSchedule?.PaymentDescription ?? "—")
                                    @if (p.PaymentSchedule?.InstallmentNo != null)
                                    {
                                        <span class="badge bg-light text-dark border">#@p.PaymentSchedule.InstallmentNo</span>
                                    }
                                </td>
                                <td class="text-end fw-semibold" data-label="Amount (PKR)">@p.Amount.ToString("N0")</td>
                                <td data-label="Payment Date">@p.PaymentDate.ToString("MMM dd, yyyy")</td>
                                <td data-label="Audit Status"><span class="badge @badgeClass">@auditStatus</span></td>
                                <td data-label="Audited By">
                                    @if (!string.IsNullOrEmpty(p.AuditedBy))
                                    {
                                        <span>@(p.AuditedByUser?.UserID ?? p.AuditedBy)</span>
                                        <span class="text-muted small d-block">@p.AuditedAt?.ToString("MMM dd, yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <i class="fas fa-search-dollar fa-2x mb-2 text-muted"></i>
                <h6 class="text-muted mb-1">No Payments Found</h6>
                <p class="text-muted small mb-0">Try adjusting the audit status or customer ID filter.</p>
            </div>
        }
    </div>
</div>

<style>
    .pms-payment-audit.pms-listing-page {
        --saas-row-h: 40px;
    }

    .pms-payment-audit .pms-grid-title {
        font-size: 1.25rem;
        color: #000;
        font-weight: 700;
    }

    .pms-payment-audit-filters {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        padding: 0;
    }

    .pms-payment-audit .pms-listing-flat,
    .pms-payment-audit .pms-saas-grid {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
    }

    .pms-payment-audit .pms-payment-audit-grid-wrap {
        overflow-x: hidden !important;
        overflow-y: visible !important;
        max-height: none !important;
        min-height: 0;
    }

    .pms-payment-audit .pms-saas-table-wrap {
        overflow-x: hidden !important;
        overflow-y: visible !important;
        max-height: none !important;
    }

    .pms-payment-audit .pms-payment-audit-grid-table {
        table-layout: fixed;
        width: 100% !important;
        margin-bottom: 0;
    }

    .pms-payment-audit .pms-payment-audit-grid-table th,
    .pms-payment-audit .pms-payment-audit-grid-table td,
    .pms-payment-audit .pms-payment-audit-grid-table td code {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        vertical-align: middle;
        font-size: 0.875rem !important;
        color: #000 !important;
        padding: 0.4rem 0.35rem !important;
        line-height: 1.25 !important;
    }

    .pms-payment-audit .pms-payment-audit-grid-table tbody td {
        height: auto !important;
        min-height: 0 !important;
        max-height: none !important;
        border-bottom: 1px solid #e2e8f0;
    }

    .pms-payment-audit .pms-payment-audit-grid-table tbody tr {
        height: auto !important;
    }

    .pms-payment-audit .pms-payment-audit-grid-table tbody td code {
        padding: 0 !important;
        line-height: inherit !important;
        background: transparent;
    }

    .pms-payment-audit .pms-payment-audit-grid-table thead th,
    .pms-payment-audit #auditTable thead th {
        font-size: 0.78rem !important;
        line-height: 1.35;
        padding-top: 0.45rem !important;
        padding-bottom: 0.45rem !important;
        min-height: 2.1rem;
        background-color: #6059A6 !important;
        color: #fff !important;
        border-color: #524c96 !important;
        cursor: default !important;
        pointer-events: none;
        background-image: none !important;
    }

    .pms-payment-audit .pms-payment-audit-grid-table thead th.sorting,
    .pms-payment-audit .pms-payment-audit-grid-table thead th.sorting_asc,
    .pms-payment-audit .pms-payment-audit-grid-table thead th.sorting_desc,
    .pms-payment-audit .pms-payment-audit-grid-table thead th.sorting_disabled {
        background-image: none !important;
        padding-right: 0.35rem !important;
    }

    .pms-payment-audit-row:hover {
        background-color: #f1f5f9 !important;
    }

    .pms-payment-audit .dataTables_wrapper .dataTables_scroll,
    .pms-payment-audit .dataTables_wrapper .dataTables_scrollBody {
        overflow: visible !important;
        max-height: none !important;
    }

    .pms-payment-audit .dataTables_wrapper .dataTables_length,
    .pms-payment-audit .dataTables_wrapper .dataTables_filter {
        display: none !important;
    }

    .pms-payment-audit .pms-payment-audit-dt-footer {
        margin-top: 0.5rem;
        width: 100%;
    }

    .pms-payment-audit .pms-payment-audit-dt-footer .dataTables_info,
    .pms-payment-audit .pms-payment-audit-dt-footer .dataTables_paginate {
        float: none !important;
        padding-top: 0;
    }

    .pms-payment-audit .pms-payment-audit-dt-footer .dataTables_paginate {
        margin-left: auto;
    }
</style>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />

    <script>
        $(document).ready(function () {
            @if (paymentList.Any())
            {
                <text>
                $('#auditTable').DataTable({
                    order: [],
                    ordering: false,
                    pageLength: 20,
                    lengthChange: false,
                    paging: true,
                    searching: false,
                    scrollX: false,
                    scrollY: false,
                    scrollCollapse: false,
                    autoWidth: false,
                    dom: 'rt<"pms-payment-audit-dt-footer d-flex flex-wrap align-items-center justify-content-between gap-2"ip>',
                    language: {
                        info: "Showing _START_ to _END_ of _TOTAL_ payments",
                        infoEmpty: "No payments",
                        paginate: {
                            first: "First",
                            last: "Last",
                            next: "Next",
                            previous: "Previous"
                        }
                    }
                });

                $('#auditTable tbody').on('click', 'tr.pms-payment-audit-row', function () {
                    var href = $(this).data('href');
                    if (href) {
                        window.location.href = href;
                    }
                });
                </text>
            }
        });
    </script>
}
