@model IEnumerable<PMS.Models.Configuration>
@using System.Linq
@{
    ViewData["Title"] = "Configuration Settings";
    ViewData["HidePageBanner"] = true;
    var allConfigs = Model?
        .Select(c => new
        {
            Config = c,
            Category = string.IsNullOrWhiteSpace(c.Category) ? "General" : c.Category!.Trim()
        })
        .OrderBy(x => x.Config.ConfigKey)
        .ThenBy(x => x.Category)
        .ToList() ?? new();
    var categories = allConfigs.GroupBy(x => x.Category).OrderBy(g => g.Key).ToList();
    var totalCount = allConfigs.Count;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h5 class="mb-0">Configuration Settings</h5>
        <small class="text-muted">All records from the Configuration table (@totalCount)</small>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add Configuration
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-2 mb-3 settings-stats-compact">
    <div class="col-6 col-md-3">
        <div class="stats-card">
            <div class="stats-number">@totalCount</div>
            <div class="stats-label">Total Configs</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stats-card">
            <div class="stats-number">@categories.Count</div>
            <div class="stats-label">Categories</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stats-card">
            <div class="stats-number">@allConfigs.Count(c => c.Category == "Cities")</div>
            <div class="stats-label">Cities</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stats-card">
            <div class="stats-number">@allConfigs.Count(c => c.Category == "Countries")</div>
            <div class="stats-label">Countries</div>
        </div>
    </div>
</div>

@if (allConfigs.Any())
{
    <div class="card pms-grid-card pms-listing-flat pms-saas-grid mb-3">
        <div class="card-body py-2">
            <div class="table-responsive pms-saas-table-wrap">
                <table class="table pms-saas-table mb-0" id="settingsConfigTable">
                    <thead>
                        <tr>
                            <th>Key</th>
                            <th>Category</th>
                            <th>Value</th>
                            <th class="pms-saas-th-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in allConfigs)
                        {
                            var config = item.Config;
                            <tr>
                                <td data-label="Key"><code class="pms-config-key">@config.ConfigKey</code></td>
                                <td data-label="Category">@item.Category</td>
                                <td data-label="Value"><span class="pms-config-value">@(config.ConfigValue ?? "")</span></td>
                                <td class="pms-saas-td-actions" data-label="Actions">
                                    <div class="pms-row-actions" role="group">
                                        <a asp-action="Edit"
                                           asp-route-id="@config.ConfigKey"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit">
                                            <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                        </a>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="deleteConfig('@config.ConfigKey')"
                                                title="Delete">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="fas fa-cogs fa-4x mb-3 text-muted"></i>
            <h5 class="text-muted">No Configurations Found</h5>
            <p class="text-muted">Add system configuration settings to get started.</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Add First Configuration
            </a>
        </div>
    </div>
}

<form id="deleteForm" asp-action="Delete" method="post" style="display: none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="deleteConfigKey" name="id" />
</form>

<style>
    .settings-stats-compact .stats-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 0.65rem 0.75rem;
        text-align: center;
        min-height: 0;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }

    .settings-stats-compact .stats-number {
        font-size: 1.35rem;
        font-weight: 700;
        color: #000;
        margin-bottom: 0.15rem;
        line-height: 1.2;
    }

    .settings-stats-compact .stats-label {
        font-size: 10px;
        color: #000;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.35px;
        margin: 0;
        line-height: 1.2;
    }

    #settingsConfigTable,
    #settingsConfigTable thead th,
    #settingsConfigTable tbody td,
    #settingsConfigTable tbody td span,
    #settingsConfigTable tbody td strong,
    #settingsConfigTable .pms-config-value {
        color: #000 !important;
    }

    #settingsConfigTable .pms-config-key,
    #settingsConfigTable td[data-label="Key"] code {
        color: #0d6efd !important;
        background: transparent;
        padding: 0;
        font-weight: 600;
    }

    #settingsConfigTable .pms-config-value {
        display: inline-block;
        max-width: 480px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        vertical-align: bottom;
        font-weight: 600;
    }

    /* Always show Edit/Delete (override hover-only grid actions) */
    #settingsConfigTable .pms-row-actions,
    .pms-saas-grid #settingsConfigTable tbody tr .pms-row-actions {
        opacity: 1 !important;
        transform: none !important;
        visibility: visible !important;
    }
</style>

@section Scripts {
    <script>
        function deleteConfig(configKey) {
            if (confirm('Are you sure you want to delete this configuration?\n\nKey: ' + configKey)) {
                document.getElementById('deleteConfigKey').value = configKey;
                document.getElementById('deleteForm').submit();
            }
        }

        $(document).ready(function () {
            if ($('#settingsConfigTable').length && $.fn.DataTable) {
                $('#settingsConfigTable').DataTable({
                    pageLength: 25,
                    order: [[0, 'asc']],
                    lengthMenu: [[25, 50, 100, -1], [25, 50, 100, 'All']],
                    columnDefs: [
                        { orderable: false, targets: 3 }
                    ],
                    language: {
                        search: 'Search:',
                        lengthMenu: 'Show _MENU_ records',
                        info: 'Showing _START_ to _END_ of _TOTAL_ configurations',
                        infoEmpty: 'No configurations',
                        paginate: {
                            first: 'First',
                            last: 'Last',
                            next: 'Next',
                            previous: 'Previous'
                        }
                    }
                });
            }
        });
    </script>
}
