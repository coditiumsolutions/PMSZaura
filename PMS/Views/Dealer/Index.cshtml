@model IEnumerable<PMS.Models.Dealer>

@{
    ViewData["Title"] = "Dealers";
    ViewData["ListingTitle"] = "Dealers List";
    ViewData["ListingDescription"] = "Registered dealers and incentives";
    ViewData["ListingRecordCount"] = Model?.Count() ?? 0;
    ViewData["ListingShowAdd"] = false;

    var canEdit = ViewBag.CanEdit == true;
    var canDelete = ViewBag.CanDelete == true;
    var toolbarButtons = "";
    if (canEdit)
    {
        toolbarButtons +=
            "<button type=\"button\" id=\"btnEditDealer\" class=\"btn btn-outline-primary btn-sm\" disabled title=\"Select a dealer first\">" +
            "<i class=\"bi bi-pencil-square me-1\" aria-hidden=\"true\"></i>Edit Dealer</button>";
    }
    if (canDelete)
    {
        toolbarButtons +=
            "<button type=\"button\" id=\"btnDeleteDealer\" class=\"btn btn-outline-danger btn-sm\" disabled title=\"Select a dealer first\">" +
            "<i class=\"bi bi-trash me-1\" aria-hidden=\"true\"></i>Delete Dealer</button>";
    }

    ViewData["ListingExtraActions"] =
        toolbarButtons +
        "<a href=\"" + Url.Action("Report") + "\" class=\"btn btn-outline-primary btn-sm\">" +
        "<i class=\"bi bi-bar-chart me-1\" aria-hidden=\"true\"></i>View Report</a>" +
        "<a href=\"" + Url.Action("Create") + "\" class=\"btn btn-primary btn-sm\">" +
        "<i class=\"bi bi-plus-lg me-1\" aria-hidden=\"true\"></i>Create New Dealer</a>";
}

@Html.AntiForgeryToken()

<div class="card pms-grid-card pms-listing-flat pms-saas-grid pms-listing-page pms-dealer-listing">
    <div class="card-body">
        <partial name="Listing/_GridToolbar" />

        <div class="table-responsive pms-saas-table-wrap">
            <table class="table pms-saas-table" id="dealersTable">
                <thead>
                    <tr>
                        <th class="pms-dealer-select-col text-center" aria-label="Select"></th>
                        <th>Dealer Name</th>
                        <th>Mobile No</th>
                        <th>Status</th>
                        <th>Incentive %</th>
                        <th>Customers</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dealer in Model)
                    {
                        var statusPill = dealer.Status == "Active" ? "pms-pill--success"
                            : dealer.Status == "Inactive" ? "pms-pill--danger" : "pms-pill--warning";
                        <tr class="pms-dealer-selectable-row"
                            data-dealer-id="@dealer.DealerID">
                            <td data-label="Select" class="text-center pms-dealer-select-col">
                                <input type="radio"
                                       name="selectedDealer"
                                       class="form-check-input dealer-select-radio m-0"
                                       value="@dealer.DealerID"
                                       aria-label="Select @dealer.DealershipName" />
                            </td>
                            <td data-label="Dealer Name">
                                <strong class="pms-cell-truncate" title="@dealer.DealershipName">@dealer.DealershipName</strong>
                            </td>
                            <td data-label="Mobile No">@dealer.MobileNo</td>
                            <td data-label="Status"><span class="pms-pill @statusPill">@dealer.Status</span></td>
                            <td data-label="Incentive %">@dealer.IncentivePercentage%</td>
                            <td data-label="Customers"><span class="pms-pill pms-pill--info">@(dealer.Customers?.Count ?? 0) Customers</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .pms-dealer-listing .pms-dealer-select-col {
        width: 2.75rem;
        min-width: 2.75rem;
    }

    .pms-dealer-listing .pms-dealer-selectable-row {
        cursor: pointer;
    }

    .pms-dealer-listing .pms-dealer-selectable-row.pms-row-selected,
    .pms-dealer-listing .pms-dealer-selectable-row.pms-row-selected > td {
        background-color: #e7f1ff !important;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            var canEdit = @canEdit.ToString().ToLowerInvariant();
            var canDelete = @canDelete.ToString().ToLowerInvariant();
            var editDealerBaseUrl = '@Url.Action("Edit", "Dealer")';
            var deleteDealerBaseUrl = '@Url.Action("Delete", "Dealer")';
            var selectedDealerId = null;

            var $editBtn = $('#btnEditDealer');
            var $deleteBtn = $('#btnDeleteDealer');

            function clearSelection() {
                selectedDealerId = null;
                $('#dealersTable tbody tr.pms-dealer-selectable-row').removeClass('pms-row-selected');
                $('.dealer-select-radio').prop('checked', false);
                if ($editBtn.length) {
                    $editBtn.prop('disabled', true).attr('title', 'Select a dealer first');
                }
                if ($deleteBtn.length) {
                    $deleteBtn.prop('disabled', true).attr('title', 'Select a dealer first');
                }
            }

            function setSelectedDealer($row) {
                if (!$row || !$row.length) {
                    clearSelection();
                    return;
                }

                selectedDealerId = String($row.data('dealer-id') || '');
                $('#dealersTable tbody tr.pms-dealer-selectable-row').removeClass('pms-row-selected');
                $row.addClass('pms-row-selected');
                $row.find('.dealer-select-radio').prop('checked', true);

                if ($editBtn.length) {
                    $editBtn.prop('disabled', false).attr('title', 'Edit selected dealer');
                }
                if ($deleteBtn.length) {
                    $deleteBtn.prop('disabled', false).attr('title', 'Delete selected dealer');
                }
            }

            $('#dealersTable').DataTable({
                pageLength: 25,
                order: [[1, 'asc']],
                columnDefs: [{ orderable: false, targets: 0 }],
                dom: '<"d-flex justify-content-end mb-2"f>rt<"d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2"lip>'
            });

            $('#dealersTable tbody').on('change', '.dealer-select-radio', function() {
                setSelectedDealer($(this).closest('tr'));
            });

            $('#dealersTable tbody').on('click', 'tr.pms-dealer-selectable-row', function(e) {
                if ($(e.target).closest('a, button, form, select, textarea, input').length) {
                    return;
                }
                var $row = $(this);
                if (selectedDealerId === String($row.data('dealer-id') || '')) {
                    clearSelection();
                } else {
                    setSelectedDealer($row);
                }
            });

            if (canEdit) {
                $editBtn.on('click', function() {
                    if (!selectedDealerId) return;
                    window.location.href = editDealerBaseUrl + '/' + encodeURIComponent(selectedDealerId);
                });
            }

            if (canDelete) {
                $deleteBtn.on('click', function() {
                    if (!selectedDealerId) return;
                    if (!confirm('Are you sure you want to delete this dealer? This cannot be undone.')) {
                        return;
                    }

                    var token = $('input[name="__RequestVerificationToken"]').val();
                    var $form = $('<form>', { method: 'post', action: deleteDealerBaseUrl + '/' + encodeURIComponent(selectedDealerId) });
                    $form.append($('<input>', { type: 'hidden', name: '__RequestVerificationToken', value: token }));
                    $('body').append($form);
                    $form.submit();
                });
            }
        });
    </script>
}
