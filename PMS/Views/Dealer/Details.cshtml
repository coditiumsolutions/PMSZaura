@model PMS.Models.Dealer

@{
    ViewData["Title"] = "Dealer Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center gap-3 ms-4">
        <div class="badge bg-light text-dark px-3 py-2" style="font-size: 14px;">
            <i class="fas fa-store me-2" style="color: #2563eb;"></i>
            <strong>Registered:</strong> @Model.RegisterationDate.ToString("MMMM dd, yyyy")
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.DealerID" class="btn btn-primary btn-sm">
            <i class="fas fa-edit me-1"></i>Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="fas fa-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card pms-listing-flat pms-registration-details">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Dealership Information</h5>
            </div>
            <div class="card-body">
                <div class="pms-registration-4col-form">
                    <div class="row g-2 pms-registration-4col-row align-items-start">
                        <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Dealer ID</div></div>
                        <div class="col-12 col-lg-4"><div class="pms-registration-details-value"><code>@Model.DealerID</code></div></div>
                        <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Dealership Name</div></div>
                        <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.DealershipName</div></div>
                    </div>
                    <div class="row g-2 pms-registration-4col-row align-items-start">
                        <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Status</div></div>
                        <div class="col-12 col-lg-4">
                            <div class="pms-registration-details-value">
                                <span class="badge @(Model.Status == "Active" ? "bg-success" : Model.Status == "Inactive" ? "bg-secondary" : "bg-warning")">@Model.Status</span>
                            </div>
                        </div>
                        <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Membership Type</div></div>
                        <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.MembershipType</div></div>
                    </div>
                    <div class="row g-2 pms-registration-4col-row align-items-start">
                        <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Incentive %</div></div>
                        <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.IncentivePercentage.ToString("F2")%</div></div>
                        <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Registration Date</div></div>
                        <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.RegisterationDate.ToString("MMM dd, yyyy")</div></div>
                    </div>
                    <div class="row g-2 pms-registration-4col-row align-items-start">
                        <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Owner Name</div></div>
                        <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.OwnerName</div></div>
                        <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Owner CNIC</div></div>
                        <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.OwnerCNIC</div></div>
                    </div>
                    <div class="row g-2 pms-registration-4col-row align-items-start">
                        <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Mobile No</div></div>
                        <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.MobileNo</div></div>
                        <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Phone Number</div></div>
                        <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.PhoneNumber</div></div>
                    </div>
                    <div class="row g-2 pms-registration-4col-row align-items-start">
                        <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Email</div></div>
                        <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.Email</div></div>
                        <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Address</div></div>
                        <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.Address</div></div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.OwnerDetails))
                    {
                        <div class="row g-2 pms-registration-4col-row align-items-start">
                            <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Owner Details</div></div>
                            <div class="col-12 col-lg-10"><div class="pms-registration-details-value">@Model.OwnerDetails</div></div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Details))
                    {
                        <div class="row g-2 pms-registration-4col-row align-items-start">
                            <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Additional Details</div></div>
                            <div class="col-12 col-lg-10"><div class="pms-registration-details-value">@Model.Details</div></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card pms-listing-flat pms-registration-details">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Statistics</h5>
            </div>
            <div class="card-body">
                <div class="pms-registration-4col-form">
                    <div class="row g-2 pms-registration-4col-row align-items-start">
                        <div class="col-12 col-lg-5"><div class="pms-registration-4col-label">Total Customers</div></div>
                        <div class="col-12 col-lg-7"><div class="pms-registration-details-value">@(Model.Customers?.Count ?? 0)</div></div>
                    </div>
                    <div class="row g-2 pms-registration-4col-row align-items-start">
                        <div class="col-12 col-lg-5"><div class="pms-registration-4col-label">Total Properties</div></div>
                        <div class="col-12 col-lg-7"><div class="pms-registration-details-value">@(Model.Properties?.Count ?? 0)</div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.Customers?.Any() == true)
{
    <div class="card pms-listing-flat pms-registration-details mt-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-users me-2"></i>Customers</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive pms-saas-table-wrap">
                <table class="table pms-saas-table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Customer ID</th>
                            <th>Full Name</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model.Customers.Take(10))
                        {
                            <tr>
                                <td><code>@customer.CustomerID</code></td>
                                <td>@customer.FullName</td>
                                <td>@customer.Phone</td>
                                <td>@customer.Email</td>
                                <td>
                                    <span class="badge @(customer.Status == "Active" ? "bg-success" : "bg-secondary")">@customer.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.Customers.Count > 10)
            {
                <small class="text-muted d-block mt-2">Showing first 10 of @Model.Customers.Count customers</small>
            }
        </div>
    </div>
}

@if (Model.Properties?.Any() == true)
{
    <div class="card pms-listing-flat pms-registration-details mt-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-home me-2"></i>Properties</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive pms-saas-table-wrap">
                <table class="table pms-saas-table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Property ID</th>
                            <th>Plot No</th>
                            <th>Block</th>
                            <th>Type</th>
                            <th>Size</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var property in Model.Properties.Take(10))
                        {
                            <tr>
                                <td><code>@property.PropertyID</code></td>
                                <td>@property.PlotNo</td>
                                <td>@property.Block</td>
                                <td>@property.PropertyType</td>
                                <td>@property.Size</td>
                                <td>
                                    <span class="badge @(property.Status == "Available" ? "bg-success" : "bg-primary")">@property.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.Properties.Count > 10)
            {
                <small class="text-muted d-block mt-2">Showing first 10 of @Model.Properties.Count properties</small>
            }
        </div>
    </div>
}
