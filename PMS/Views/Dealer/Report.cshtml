@model IEnumerable<PMS.Models.Dealer>

@{
    ViewData["Title"] = "Dealers Report";
    var totalCustomers = Model.Sum(d => d.Customers?.Count ?? 0);
    var totalProperties = Model.Sum(d => d.Properties?.Count ?? 0);
    var maxAssets = Model.Any() ? Model.Max(d => (d.Customers?.Count ?? 0) + (d.Properties?.Count ?? 0)) : 1;
    var orderedDealers = Model.OrderByDescending(d => (d.Customers?.Count ?? 0) + (d.Properties?.Count ?? 0)).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center gap-3 ms-4">
        <div class="badge bg-light text-dark px-3 py-2" style="font-size: 14px;">
            <i class="fas fa-chart-bar me-2" style="color: #2563eb;"></i>
            <strong>Report generated:</strong> @DateTime.Now.ToString("MMMM dd, yyyy")
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="fas fa-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>

<div class="card pms-listing-flat pms-registration-details mb-4">
    <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-chart-pie me-2"></i>Summary</h5>
    </div>
    <div class="card-body">
        <div class="pms-registration-4col-form">
            <div class="row g-2 pms-registration-4col-row align-items-start">
                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Total Dealers</div></div>
                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.Count()</div></div>
                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Total Customers</div></div>
                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@totalCustomers</div></div>
            </div>
            <div class="row g-2 pms-registration-4col-row align-items-start">
                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Total Properties</div></div>
                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@totalProperties</div></div>
                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Combined Assets</div></div>
                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@(totalCustomers + totalProperties)</div></div>
            </div>
        </div>
    </div>
</div>

<div class="card pms-grid-card pms-listing-flat pms-saas-grid pms-listing-page mb-4">
    <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-store me-2"></i>Dealer Performance</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive pms-saas-table-wrap">
            <table class="table pms-saas-table table-sm mb-0" id="dealerReportTable">
                <thead>
                    <tr>
                        <th class="pms-saas-th-actions">Actions</th>
                        <th>Dealer ID</th>
                        <th>Dealership Name</th>
                        <th>Status</th>
                        <th>Customers</th>
                        <th>Properties</th>
                        <th>Total Assets</th>
                        <th>Performance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dealer in orderedDealers)
                    {
                        var dealerCustomers = dealer.Customers?.Count ?? 0;
                        var dealerProperties = dealer.Properties?.Count ?? 0;
                        var totalAssets = dealerCustomers + dealerProperties;
                        var percentage = maxAssets > 0 ? (totalAssets * 100 / maxAssets) : 0;
                        var statusPill = dealer.Status == "Active" ? "pms-pill--success"
                            : dealer.Status == "Inactive" ? "pms-pill--danger" : "pms-pill--warning";

                        <tr>
                            <td class="pms-saas-td-actions" data-label="Actions">
                                <div class="pms-row-actions" role="group">
                                    <a asp-action="Details" asp-route-id="@dealer.DealerID" class="btn btn-sm btn-outline-secondary" title="Details">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@dealer.DealerID" class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                    </a>
                                </div>
                            </td>
                            <td data-label="Dealer ID"><code>@dealer.DealerID</code></td>
                            <td data-label="Dealership Name"><strong class="pms-cell-truncate" title="@dealer.DealershipName">@dealer.DealershipName</strong></td>
                            <td data-label="Status"><span class="pms-pill @statusPill">@dealer.Status</span></td>
                            <td data-label="Customers"><span class="pms-registration-details-value">@dealerCustomers</span></td>
                            <td data-label="Properties"><span class="pms-registration-details-value">@dealerProperties</span></td>
                            <td data-label="Total Assets"><strong>@totalAssets</strong></td>
                            <td data-label="Performance">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 6px;">
                                        <div class="progress-bar" role="progressbar" style="width: @percentage%; background-color: #2563eb;" aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <small class="text-muted text-nowrap">@percentage%</small>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card pms-listing-flat pms-registration-details">
    <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Dealer Distribution Chart</h5>
    </div>
    <div class="card-body">
        <canvas id="dealerChart" height="100"></canvas>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        $(document).ready(function() {
            var dealerData = [
                @foreach (var dealer in orderedDealers.Take(10))
                {
                    <text>{
                        label: '@Html.Raw(dealer.DealershipName.Replace("'", "\\'"))',
                        customers: @(dealer.Customers?.Count ?? 0),
                        properties: @(dealer.Properties?.Count ?? 0)
                    },</text>
                }
            ];

            var ctx = document.getElementById('dealerChart');
            if (ctx) {
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: dealerData.map(d => d.label.length > 20 ? d.label.substring(0, 20) + '...' : d.label),
                        datasets: [
                            {
                                label: 'Customers',
                                data: dealerData.map(d => d.customers),
                                backgroundColor: 'rgba(37, 99, 235, 0.7)',
                                borderColor: '#2563eb',
                                borderWidth: 1,
                                borderRadius: 4
                            },
                            {
                                label: 'Properties',
                                data: dealerData.map(d => d.properties),
                                backgroundColor: 'rgba(71, 85, 105, 0.5)',
                                borderColor: '#475569',
                                borderWidth: 1,
                                borderRadius: 4
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        plugins: {
                            legend: {
                                display: true,
                                position: 'top'
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { stepSize: 1 },
                                grid: { color: 'rgba(203, 213, 225, 0.5)' }
                            },
                            x: {
                                grid: { display: false }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
