@model IEnumerable<PMS.Models.Project>

@{
    ViewData["Title"] = "Projects";
    ViewData["ListingHideToolbarActions"] = true;
    var projectCount = Model?.Count() ?? 0;
    var canDelete = ViewBag.CanDelete == true;
    var canEdit = ViewBag.CanEdit == true;
    var showDelete = canDelete || canEdit;
}

<div class="pms-listing-page pms-project-listing">
    <div class="d-flex flex-wrap justify-content-end align-items-center gap-2 mb-2 pms-project-toolbar">
        <span class="badge rounded-pill pms-record-badge me-auto">@projectCount record@(projectCount == 1 ? "" : "s")</span>
        <div class="d-flex flex-wrap align-items-stretch gap-2 pms-project-actions">
            @if (showDelete)
            {
                <button type="button"
                        id="btnDeleteProject"
                        class="btn btn-sm pms-project-main-btn pms-project-main-btn--delete"
                        disabled
                        title="Select a project first">
                    <i class="bi bi-trash me-1" aria-hidden="true"></i>Delete Project
                </button>
            }
            <a href="@Url.Action("FloorPlan")" class="btn btn-sm pms-project-main-btn pms-project-main-btn--floor">
                <i class="bi bi-layers me-1" aria-hidden="true"></i>Floor Plan
            </a>
            <a href="@Url.Action("Create")" class="btn btn-sm pms-project-main-btn pms-project-main-btn--create">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Create New Project
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @Html.AntiForgeryToken()

    <div class="card pms-grid-card pms-listing-flat pms-saas-grid pms-listing-page mb-2">
        <div class="card-body py-2">
            <div class="table-responsive pms-saas-table-wrap">
                <table class="table pms-saas-table" id="projectsTable">
                    <thead>
                        <tr>
                            <th class="pms-project-select-col text-center" scope="col">Select</th>
                            <th scope="col">Project</th>
                            <th scope="col">Type</th>
                            <th scope="col">Location</th>
                            <th scope="col">Properties</th>
                            <th scope="col">Customers</th>
                            <th scope="col">Created On</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var project in Model)
                        {
                            var customerCount = ViewBag.CustomerCounts != null && ViewBag.CustomerCounts.ContainsKey(project.ProjectID)
                                ? ViewBag.CustomerCounts[project.ProjectID]
                                : 0;
                            <tr class="pms-project-selectable-row"
                                data-project-id="@project.ProjectID"
                                data-href="@Url.Action("Details", new { id = project.ProjectID })">
                                <td data-label="Select" class="text-center pms-project-select-col">
                                    <input type="radio"
                                           name="selectedProject"
                                           class="form-check-input project-select-radio m-0"
                                           value="@project.ProjectID"
                                           aria-label="Select @project.ProjectName" />
                                </td>
                                <td data-label="Project">
                                    <a asp-action="Details" asp-route-id="@project.ProjectID" class="text-decoration-none pms-cell-primary">
                                        <span class="pms-cell-primary-title pms-cell-truncate" title="@project.ProjectName">@project.ProjectName</span>
                                        <span class="pms-cell-primary-sub" title="@project.ProjectID">@project.ProjectID</span>
                                    </a>
                                </td>
                                <td data-label="Type">
                                    <span class="pms-project-type">@(string.IsNullOrWhiteSpace(project.Type) ? "—" : project.Type)</span>
                                </td>
                                <td data-label="Location">
                                    <span class="pms-cell-truncate" title="@project.Location">@(string.IsNullOrWhiteSpace(project.Location) ? "—" : project.Location)</span>
                                </td>
                                <td data-label="Properties">
                                    <span class="pms-project-metric">@(project.Properties?.Count ?? 0)</span>
                                </td>
                                <td data-label="Customers">
                                    <span class="pms-project-metric">@customerCount</span>
                                </td>
                                <td data-label="Created On">
                                    <span class="pms-project-date text-nowrap">@project.CreatedAt.ToString("dd MMM yyyy")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .content-body:has(.pms-project-listing) {
        padding-top: 0.5rem !important;
    }

    .pms-project-listing {
        margin-top: 0;
    }

    .pms-project-listing .pms-record-badge {
        background: #e2e8f0;
        color: #0f172a;
        font-weight: 600;
    }

    /* Match Customer Details: rectangle, equal height, navy / periwinkle / gold */
    .pms-project-actions {
        align-items: stretch;
    }

    .pms-project-main-btn {
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        height: 38px !important;
        min-height: 38px !important;
        min-width: 8.5rem;
        padding: 0.4rem 1rem !important;
        border-radius: 0 !important;
        font-weight: 600;
        font-size: 0.875rem;
        line-height: 1.2;
        border: 1px solid transparent;
        box-shadow: none;
        white-space: nowrap;
    }

    .pms-project-main-btn--delete {
        background-color: #3E348D !important;
        border-color: #342c78 !important;
        color: #fff !important;
    }

    .pms-project-main-btn--delete:hover:not(:disabled),
    .pms-project-main-btn--delete:focus:not(:disabled) {
        background-color: #342c78 !important;
        border-color: #2c2566 !important;
        color: #fff !important;
    }

    .pms-project-main-btn--delete:disabled {
        background-color: #9ca3af !important;
        border-color: #9ca3af !important;
        color: #fff !important;
        opacity: 0.75;
    }

    .pms-project-main-btn--floor {
        background-color: #7679EE !important;
        border-color: #6366e0 !important;
        color: #fff !important;
    }

    .pms-project-main-btn--floor:hover,
    .pms-project-main-btn--floor:focus {
        background-color: #6366e0 !important;
        border-color: #5558d4 !important;
        color: #fff !important;
    }

    .pms-project-main-btn--create {
        background-color: #F6B801 !important;
        border-color: #dda500 !important;
        color: #1f1700 !important;
    }

    .pms-project-main-btn--create:hover,
    .pms-project-main-btn--create:focus {
        background-color: #dda500 !important;
        border-color: #c79400 !important;
        color: #140f00 !important;
    }

    .pms-project-listing .pms-project-select-col {
        width: 4.25rem;
        min-width: 4.25rem;
    }

    .pms-project-listing .pms-saas-table-wrap {
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
    }

    .pms-project-listing .pms-saas-table {
        table-layout: fixed;
        margin-bottom: 0;
        color: #000 !important;
    }

    .pms-project-listing .pms-saas-table thead th {
        background: #6059A6 !important;
        color: #fff !important;
        font-size: 0.68rem !important;
        font-weight: 700 !important;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        border-bottom: 1px solid #524c96 !important;
        border-top: none !important;
        padding: 0.85rem 1rem !important;
        white-space: nowrap;
        vertical-align: middle;
    }

    .pms-project-listing .pms-saas-table thead th:hover {
        background: #524c96 !important;
        color: #fff !important;
    }

    .pms-project-listing .pms-saas-table tbody td,
    .pms-project-listing .pms-saas-table tbody td a,
    .pms-project-listing .pms-cell-primary-title,
    .pms-project-listing .pms-cell-primary-sub,
    .pms-project-listing .pms-project-type,
    .pms-project-listing .pms-project-metric,
    .pms-project-listing .pms-project-date {
        color: #000 !important;
    }

    .pms-project-listing .pms-saas-table tbody td {
        font-size: 0.875rem;
        padding: 0.85rem 1rem !important;
        height: auto;
        min-height: 3.25rem;
        border-bottom: 1px solid #eef2f7 !important;
        vertical-align: middle;
        white-space: normal;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: none;
    }

    .pms-project-listing .pms-saas-table tbody tr:nth-child(even) {
        background-color: #fafbfc;
    }

    .pms-project-listing .pms-saas-table tbody tr:hover {
        background-color: #f1f5f9 !important;
        box-shadow: inset 3px 0 0 #2563eb;
    }

    .pms-project-listing .pms-project-selectable-row {
        cursor: pointer;
    }

    .pms-project-listing .pms-project-selectable-row.pms-row-selected,
    .pms-project-listing .pms-project-selectable-row.pms-row-selected > td {
        background-color: #e8f1ff !important;
    }

    .pms-project-listing .pms-cell-primary {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        min-width: 0;
    }

    .pms-project-listing .pms-cell-primary-title {
        font-size: 0.92rem;
        font-weight: 700;
        line-height: 1.25;
    }

    .pms-project-listing .pms-cell-primary-sub {
        font-size: 0.75rem;
        font-weight: 500;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        letter-spacing: 0.02em;
    }

    .pms-project-listing .pms-project-type {
        display: inline-block;
        font-weight: 600;
    }

    .pms-project-listing .pms-project-metric {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 2rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

    .pms-project-listing .pms-project-date {
        font-weight: 500;
        font-size: 0.84rem;
    }

    .pms-project-listing .dataTables_wrapper .dataTables_info,
    .pms-project-listing .dataTables_wrapper .dataTables_paginate {
        color: #475569;
        font-size: 0.8125rem;
        padding-top: 0.75rem;
    }

    .pms-project-listing .dataTables_length {
        display: none !important;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            var canDelete = @showDelete.ToString().ToLowerInvariant();
            var deleteProjectBaseUrl = '@Url.Action("Delete", "Project")';
            var selectedProjectId = null;
            var $deleteBtn = $('#btnDeleteProject');

            function clearSelection() {
                selectedProjectId = null;
                $('#projectsTable tbody tr.pms-project-selectable-row').removeClass('pms-row-selected');
                $('.project-select-radio').prop('checked', false);
                if ($deleteBtn.length) {
                    $deleteBtn.prop('disabled', true).attr('title', 'Select a project first');
                }
            }

            function setSelectedProject($row) {
                if (!$row || !$row.length) {
                    clearSelection();
                    return;
                }

                selectedProjectId = String($row.data('project-id') || '');
                $('#projectsTable tbody tr.pms-project-selectable-row').removeClass('pms-row-selected');
                $row.addClass('pms-row-selected');
                $row.find('.project-select-radio').prop('checked', true);

                if ($deleteBtn.length) {
                    $deleteBtn.prop('disabled', false).attr('title', 'Delete selected project');
                }
            }

            PmsListingDataTable.init('#projectsTable', {
                order: [[6, 'desc']],
                columnDefs: [{ orderable: false, targets: 0 }],
                lengthChange: false,
                pageLength: 20,
                dom: 'rtip'
            });

            $('#projectsTable tbody').on('change', '.project-select-radio', function() {
                setSelectedProject($(this).closest('tr'));
            });

            $('#projectsTable tbody').on('click', 'tr.pms-project-selectable-row', function(e) {
                if ($(e.target).closest('a, button, form, select, textarea, input').length) {
                    return;
                }
                var $row = $(this);
                if (selectedProjectId === String($row.data('project-id') || '')) {
                    clearSelection();
                } else {
                    setSelectedProject($row);
                }
            });

            $('#projectsTable tbody').on('dblclick', 'tr.pms-project-selectable-row', function() {
                var href = $(this).data('href');
                if (href) {
                    window.location.href = href;
                }
            });

            if (canDelete) {
                $deleteBtn.on('click', function() {
                    if (!selectedProjectId) return;
                    if (!confirm('Are you sure you want to delete this project? This cannot be undone.')) {
                        return;
                    }

                    var token = $('input[name="__RequestVerificationToken"]').val();
                    var $form = $('<form>', { method: 'post', action: deleteProjectBaseUrl + '/' + encodeURIComponent(selectedProjectId) });
                    $form.append($('<input>', { type: 'hidden', name: '__RequestVerificationToken', value: token }));
                    $('body').append($form);
                    $form.submit();
                });
            }
        });
    </script>
}
