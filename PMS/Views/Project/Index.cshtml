@model IEnumerable<PMS.Models.Project>

@{
    ViewData["Title"] = "Projects";
    ViewData["ListingHideToolbarActions"] = true;
    var projectCount = Model?.Count() ?? 0;
}

<div class="pms-listing-page pms-project-listing">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h5 class="pms-grid-title pms-project-page-heading mb-0">Projects</h5>
        <span class="badge rounded-pill pms-record-badge">@projectCount record@(projectCount == 1 ? "" : "s")</span>
    </div>

    <div class="mb-2">
        <div class="d-flex flex-wrap gap-2">
            <a href="@Url.Action("FloorPlan")" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-layers me-1" aria-hidden="true"></i>Floor Plan
            </a>
            <a href="@Url.Action("Create")" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Create New Project
            </a>
        </div>
    </div>

    <div class="card pms-grid-card pms-listing-flat pms-saas-grid mb-2">
        <div class="card-body py-2">
            <div class="table-responsive pms-saas-table-wrap">
                <table class="table pms-saas-table" id="projectsTable">
                    <thead>
                        <tr>
                            <th>Project ID</th>
                            <th>Project Name</th>
                            <th>Type</th>
                            <th>Location</th>
                            <th>Properties</th>
                            <th>Customers</th>
                            <th>Created Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var project in Model)
                        {
                            var customerCount = ViewBag.CustomerCounts != null && ViewBag.CustomerCounts.ContainsKey(project.ProjectID)
                                ? ViewBag.CustomerCounts[project.ProjectID]
                                : 0;
                            <tr class="pms-listing-row" data-href="@Url.Action("Details", new { id = project.ProjectID })">
                                <td data-label="Project ID">
                                    <a asp-action="Details" asp-route-id="@project.ProjectID" class="text-decoration-none">
                                        <span class="badge bg-secondary">@project.ProjectID</span>
                                    </a>
                                </td>
                                <td data-label="Project Name">
                                    <strong class="pms-cell-truncate" title="@project.ProjectName">@project.ProjectName</strong>
                                    @if (!string.IsNullOrEmpty(project.Description))
                                    {
                                        <br><small class="text-muted pms-cell-truncate d-block" title="@project.Description">@project.Description</small>
                                    }
                                </td>
                                <td data-label="Type"><span class="pms-pill pms-pill--info">@project.Type</span></td>
                                <td data-label="Location"><span class="pms-cell-truncate" title="@project.Location">@project.Location</span></td>
                                <td data-label="Properties"><span class="pms-pill pms-pill--success">@(project.Properties?.Count ?? 0) Properties</span></td>
                                <td data-label="Customers"><span class="pms-pill pms-pill--info">@customerCount Customers</span></td>
                                <td data-label="Created"><span class="text-nowrap">@project.CreatedAt.ToString("MMM dd, yyyy")</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .pms-project-listing .pms-project-page-heading {
        font-size: 1.1rem;
        font-weight: 700;
        color: #0f172a;
    }

    .pms-project-listing .pms-saas-table thead th {
        font-size: 11.5px !important;
    }

    .pms-project-listing .pms-saas-table,
    .pms-project-listing .pms-saas-table tbody td,
    .pms-project-listing .pms-saas-table tbody td span,
    .pms-project-listing .pms-saas-table tbody td strong,
    .pms-project-listing .pms-saas-table tbody td a {
        color: #000 !important;
    }

    .pms-project-listing .pms-saas-table tbody td:first-child,
    .pms-project-listing .pms-saas-table tbody td:first-child span,
    .pms-project-listing .pms-saas-table tbody td:first-child a {
        color: #1e3a8a !important;
        font-weight: 600;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            PmsListingDataTable.init('#projectsTable', {
                order: [[6, 'desc']]
            });
            PmsListingDataTable.bindRowNavigation('#projectsTable');
        });
    </script>
}
