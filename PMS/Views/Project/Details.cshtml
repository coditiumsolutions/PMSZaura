@model PMS.Models.Project

@{
    ViewData["Title"] = "Project Details";
}

<div class="pms-project-details">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="pms-project-details-title mb-0"><i class="fas fa-building me-2"></i>Project Details</h2>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.ProjectID" class="btn btn-outline-primary btn-sm pms-project-action-btn me-2">
                <i class="fas fa-edit me-1"></i>Edit Project
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm pms-project-action-btn">
                <i class="fas fa-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card pms-project-info-card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Project Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row mb-0">
                                <dt class="col-sm-4">Project ID:</dt>
                                <dd class="col-sm-8">@Model.ProjectID</dd>

                                <dt class="col-sm-4">Project Name:</dt>
                                <dd class="col-sm-8">@Model.ProjectName</dd>

                                <dt class="col-sm-4">Type:</dt>
                                <dd class="col-sm-8">@Model.Type</dd>

                                <dt class="col-sm-4">Location:</dt>
                                <dd class="col-sm-8">@Model.Location</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row mb-0">
                                <dt class="col-sm-4">Created Date:</dt>
                                <dd class="col-sm-8">@Model.CreatedAt.ToString("MMM dd, yyyy")</dd>

                                <dt class="col-sm-4">Total Properties:</dt>
                                <dd class="col-sm-8">@(Model.Properties?.Count ?? 0) Properties</dd>

                                <dt class="col-sm-4">Payment Plans:</dt>
                                <dd class="col-sm-8">@(Model.PaymentPlans?.Count ?? 0) Plans</dd>

                                <dt class="col-sm-4">Balloting Records:</dt>
                                <dd class="col-sm-8">@(Model.Ballotings?.Count ?? 0) Ballotings</dd>
                            </dl>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <hr>
                        <h6>Description:</h6>
                        <p class="pms-project-field-value mb-0">@Model.Description</p>
                    }

                    @{
                        var subProjectMappings = (ViewBag.SubProjectMappings as IEnumerable<PMS.Models.ProjectSubProject>)?.ToList()
                            ?? new List<PMS.Models.ProjectSubProject>();
                    }
                    <hr>
                    <h6>Sub Projects with Prefixes</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered mb-0">
                            <thead class="pms-project-grid-head">
                                <tr>
                                    <th>SubProject</th>
                                    <th>Prefix</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (subProjectMappings.Any())
                                {
                                    foreach (var mapping in subProjectMappings)
                                    {
                                        <tr>
                                            <td>@mapping.SubProjectName</td>
                                            <td class="pms-project-prefix-value">@mapping.Prefix</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="2" class="text-muted text-center">No subprojects configured.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Create", "Property", new { projectId = Model.ProjectID })" class="btn btn-success btn-sm">
                            <i class="fas fa-plus me-2"></i>Add Property
                        </a>
                        <a href="@Url.Action("Index", "Property", new { projectId = Model.ProjectID })" class="btn btn-info btn-sm">
                            <i class="fas fa-home me-2"></i>View Properties
                        </a>
                        <a href="@Url.Action("ConductBalloting", "Project", new { id = Model.ProjectID })" class="btn btn-warning btn-sm">
                            <i class="fas fa-vote-yea me-2"></i>Conduct Balloting
                        </a>
                        <a href="@Url.Action("Create", "PaymentPlan", new { projectId = Model.ProjectID })" class="btn btn-primary btn-sm">
                            <i class="fas fa-credit-card me-2"></i>Create Payment Plan
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Properties?.Any() == true)
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card pms-project-properties-card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Properties in this Project</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>Property ID</th>
                                        <th>Plot No</th>
                                        <th>Block</th>
                                        <th>Unit type (category)</th>
                                        <th>Size</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var property in Model.Properties.Take(10))
                                    {
                                        <tr>
                                            <td>@property.PropertyID</td>
                                            <td>@property.PlotNo</td>
                                            <td>@property.Block</td>
                                            <td>@(property.PlotType ?? "—")</td>
                                            <td>@property.Size</td>
                                            <td>@property.Status</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (Model.Properties.Count > 10)
                            {
                                <div class="text-center mt-3">
                                    <a href="@Url.Action("Index", "Property", new { projectId = Model.ProjectID })" class="btn btn-outline-primary btn-sm">
                                        View All @Model.Properties.Count Properties
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .pms-project-details .pms-project-details-title {
        font-size: 1.35rem;
        font-weight: 700;
        color: #0f172a;
    }

    .pms-project-details .pms-project-action-btn {
        font-size: 0.78rem;
        padding: 0.28rem 0.65rem;
        line-height: 1.25;
    }

    .pms-project-details .pms-project-prefix-value {
        color: #2563eb !important;
        font-weight: 500;
        background: transparent !important;
    }

    .pms-project-details .pms-project-info-card,
    .pms-project-details .pms-project-properties-card {
        background: #ffffff !important;
        border: 1px solid #e2e8f0;
        box-shadow: none;
    }

    .pms-project-details .pms-project-info-card > .card-header,
    .pms-project-details .pms-project-info-card > .card-body,
    .pms-project-details .pms-project-properties-card > .card-header,
    .pms-project-details .pms-project-properties-card > .card-body {
        background: #ffffff !important;
    }

    .pms-project-details .pms-project-info-card .card-title,
    .pms-project-details .pms-project-properties-card .card-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #0f172a;
    }

    .pms-project-details .pms-project-info-card dt {
        font-size: 0.75rem;
        font-weight: 600;
        color: #334155;
        line-height: 1.35;
    }

    .pms-project-details .pms-project-info-card dd,
    .pms-project-details .pms-project-info-card .pms-project-field-value {
        font-size: 0.875rem;
        font-weight: 500;
        color: #2563eb !important;
        background: transparent !important;
        line-height: 1.35;
    }

    .pms-project-details .pms-project-info-card h6 {
        font-size: 0.85rem;
        font-weight: 700;
        color: #0f172a;
    }

    .pms-project-details .pms-project-info-card .table,
    .pms-project-details .pms-project-properties-card .table {
        background: #ffffff;
        font-size: 0.8125rem;
    }

    .pms-project-details .pms-project-properties-card .table td {
        color: #2563eb;
        background: transparent !important;
    }

    .pms-project-details .pms-project-info-card .table thead th,
    .pms-project-details .pms-project-properties-card .table thead th,
    .pms-project-details .table thead th {
        background: #6059A6 !important;
        color: #fff !important;
        font-size: 0.75rem;
        border-color: #524c96 !important;
    }

    .pms-project-details .pms-project-properties-card .table th {
        font-size: 0.75rem;
        color: #fff !important;
        background: #6059A6 !important;
    }
</style>
