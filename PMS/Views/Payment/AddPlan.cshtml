        padding-bottom: 0 !important;
        border-bottom: none !important;
    }

    .pms-create-payment-plan .pms-addplan-schedule-config .form-label,
    .pms-create-payment-plan .pms-addplan-schedule-config .pms-registration-4col-label {
        padding-top: 0 !important;
        margin-bottom: 0 !important;
    }

    .pms-create-payment-plan .pms-addplan-schedule-config .text-danger {
        display: block;
