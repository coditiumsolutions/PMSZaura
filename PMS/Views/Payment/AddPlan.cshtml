    .pms-addplan-schedule-grid th:nth-child(5),
    .pms-addplan-schedule-grid td:nth-child(5) { width: 8%; }  /* Sur Applied */
    .pms-addplan-schedule-grid th:nth-child(6),
    .pms-addplan-schedule-grid td:nth-child(6) { width: 8%; }  /* Sur Rate */
    .pms-addplan-schedule-grid th:nth-child(7),
