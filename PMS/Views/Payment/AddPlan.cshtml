    .pms-create-payment-plan .pms-cpp-form .form-select-sm:focus {
        color: #1e3a8a !important;
        background-color: #fff !important;
        border-color: #3b82f6 !important;
        box-shadow: none !important;
    }

    .pms-create-payment-plan .pms-cpp-form .form-control:disabled,
    .pms-create-payment-plan .pms-cpp-form .form-control[readonly],
    .pms-create-payment-plan .pms-cpp-form .form-select:disabled {
        color: #1d4ed8 !important;
        background-color: #f8fafc !important;
        opacity: 1;
    }

    .pms-create-payment-plan .pms-cpp-form .form-check-label {
        font-size: 0.8125rem;
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            const maxAmountPkr = 1000000000;
            const planSaved = @(planSaved ? "true" : "false");

            var $scheduleToggle = $('.pms-addplan-schedule-toggle');
            var $scheduleHint = $scheduleToggle.find('.pms-addplan-schedule-toggle-hint');
            var scheduleCollapseEl = document.getElementById('addPlanScheduleConfigCollapse');

            function syncScheduleToggleHint(expanded) {
                if ($scheduleHint.length) {
                    $scheduleHint.text(expanded ? 'Click to collapse' : 'Click to expand');
                }
                $scheduleToggle.attr('aria-expanded', expanded ? 'true' : 'false');
            }

            if (scheduleCollapseEl) {
                syncScheduleToggleHint(scheduleCollapseEl.classList.contains('show'));
                scheduleCollapseEl.addEventListener('shown.bs.collapse', function () { syncScheduleToggleHint(true); });
                scheduleCollapseEl.addEventListener('hidden.bs.collapse', function () { syncScheduleToggleHint(false); });
            }

            $scheduleToggle.on('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    $(this).trigger('click');
                }
            });

            function normalizeNumericText(raw) {
                var text = String(raw || '').trim().replace(/,/g, '');
                if (!text) return '';
                var n = parseFloat(text);
                if (!isFinite(n)) return '';
                return String(n);
            }

            function parseDecimalText(selector) {
                var n = parseFloat(normalizeNumericText($(selector).val()));
                return isFinite(n) ? n : 0;
            }

            function autoFillTotalAmount() {
                var size = parseDecimalText('#Size');
                var pricePerUnit = parseDecimalText('#PricePerUnit');
                if (size > 0 && pricePerUnit > 0) {
                    var computed = Math.round(size * pricePerUnit);
                    if (computed > maxAmountPkr) computed = maxAmountPkr;
                    if (computed < 1) computed = 1;
                    $('#TotalAmount').val(computed);
                }
            }

            if (!planSaved) {
                $('#Size, #PricePerUnit').on('input blur change', function () {
                    $(this).val(normalizeNumericText($(this).val()));
                    autoFillTotalAmount();
                });

                $('#TotalAmount').on('blur', function () {
                    var raw = String($(this).val() || '').trim();
                    if (raw === '') return;
                    var amount = Math.round(parseFloat(raw));
                    if (!isFinite(amount) || amount < 1) amount = 1;
                    if (amount > maxAmountPkr) amount = maxAmountPkr;
                    $(this).val(amount);
                });
            }

            $('#SurchargePolicyStatus').on('change', function () {
                $('#SurchargeRate').prop('disabled', !$(this).is(':checked'));
            }).trigger('change');
        });
    </script>
}
