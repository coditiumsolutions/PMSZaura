    }

    .pms-create-payment-plan .pms-cpp-form .pms-registration-4col-row:last-child {
        border-bottom: none;
        margin-bottom: 0 !important;
        padding-bottom: 0;
    }

    .pms-create-payment-plan .pms-cpp-form .form-label,
    .pms-create-payment-plan .pms-cpp-form .pms-registration-4col-label,
    .pms-create-payment-plan .pms-cpp-form .form-check-label,
    .pms-create-payment-plan .pms-mp-header .pms-cpp-form .pms-registration-4col-row > .col-lg-2 .form-label,
    .pms-create-payment-plan .pms-mp-header .pms-cpp-form .pms-registration-4col-row > .col-lg-2 .pms-registration-4col-label,
    .pms-create-payment-plan .pms-mp-header .pms-cpp-form .pms-registration-4col-row > .col-md-2 .form-label,
    .pms-create-payment-plan .pms-mp-header .pms-cpp-form .pms-registration-4col-row > .col-md-2 .pms-registration-4col-label,
    .pms-create-payment-plan .pms-mp-header .form-label,
    .pms-create-payment-plan .pms-mp-header label.form-label {
        color: #000 !important;
        font-weight: 600 !important;
        font-size: 0.75rem;
        margin-bottom: 0;
        padding-top: 0.2rem;
        line-height: 1.2;
