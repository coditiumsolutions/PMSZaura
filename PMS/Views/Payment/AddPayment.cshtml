@model IEnumerable<PMS.Models.Customer>
@{
    ViewData["Title"] = "Add Payment";
    var customerCount = Model?.Count() ?? 0;
    var projectFilter = ViewBag.ProjectFilter as string ?? "All";
    var statusFilter = ViewBag.StatusFilter as string ?? "All";
    var searchTerm = ViewBag.SearchTerm as string ?? "";
    var recordPaymentUrl = Url.Action("RecordPayment", "Payment");
}

<div class="pms-payment-listing pms-listing-page pms-customer-listing">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <div class="d-flex flex-wrap align-items-baseline gap-2 min-w-0">
            <h5 class="pms-grid-title pms-customer-page-heading mb-0">Add Payment</h5>
            <small class="pms-add-payment-subtitle mb-0">Search customers, then double-click a row to add payment.</small>
        </div>
        <span class="badge rounded-pill pms-record-badge">@customerCount record@(customerCount == 1 ? "" : "s")</span>
    </div>

    <form method="get" asp-action="AddPayment" class="mb-2" id="addPaymentSearchForm">
        <div class="pms-customer-search-wrap pms-listing-search-wrap pms-customer-search-panel">
            <div class="row g-2 pms-customer-search-fields">
                <div class="col-12 col-md-4">
                    <div class="pms-compact-field pms-customer-equal-field">
                        <label for="searchTerm" class="visually-hidden">Search Customer</label>
                        <input type="text"
                               name="searchTerm"
                               id="searchTerm"
                               class="form-control"
                               placeholder="Search Customer"
                               aria-label="Search Customer"
                               value="@searchTerm" />
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="pms-compact-field pms-select-dropdown pms-customer-equal-field">
                        <label for="projectFilter" class="visually-hidden">Project</label>
                        <select name="projectFilter" id="projectFilter" class="form-select" onchange="this.form.submit()" aria-label="Project">
                            <option value="All" selected="@(projectFilter == "All")">All Projects</option>
                            @if (ViewBag.Projects != null)
                            {
                                @foreach (var project in ViewBag.Projects)
                                {
                                    <option value="@project.ProjectID" selected="@(projectFilter == project.ProjectID)">
                                        @project.ProjectName
                                    </option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="pms-compact-field pms-select-dropdown pms-customer-equal-field">
                        <label for="statusFilter" class="visually-hidden">Status</label>
                        <select name="statusFilter" id="statusFilter" class="form-select" onchange="this.form.submit()" aria-label="Status">
                            <option value="All" selected="@(statusFilter == "All")">All Status</option>
                            <option value="Active" selected="@(statusFilter == "Active")">Active</option>
                            <option value="Pending" selected="@(statusFilter == "Pending")">Pending</option>
                            <option value="Inactive" selected="@(statusFilter == "Inactive")">Inactive</option>
                            <option value="Marked for Deletion" selected="@(statusFilter == "Marked for Deletion")">Marked for Deletion</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="row g-2 mt-2 pms-customer-search-actions-row">
                <div class="col-12 col-md-4">
                    <button type="submit" class="btn btn-sm pms-customer-action-btn pms-customer-action-btn--search pms-customer-action-btn--row">
                        <i class="bi bi-search me-1" aria-hidden="true"></i>Search
                    </button>
                </div>
                <div class="col-12 col-md-4">
                    <button type="button"
                            id="btnContinueAddPayment"
                            class="btn btn-sm pms-customer-action-btn pms-customer-action-btn--operations pms-customer-action-btn--row"
                            title="Open Add Payment form">
                        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add Payment
                    </button>
                </div>
                <div class="col-12 col-md-4">
                    <a asp-action="CustomerPayments"
                       class="btn btn-sm pms-customer-action-btn pms-customer-action-btn--report pms-customer-action-btn--row">
                        Cancel
                    </a>
                </div>
            </div>
            <small class="pms-add-payment-hint d-block mt-2">* Double-click a row to open Add Payment with that Customer ID, or click Add Payment to enter a Customer ID manually.</small>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <div class="card pms-grid-card pms-listing-flat pms-saas-grid mb-3">
            <div class="card-body py-2">
                <div class="table-responsive pms-saas-table-wrap">
                    <table class="table pms-saas-table mb-0" id="addPaymentCustomersTable">
                        <thead>
                            <tr>
                                <th>Customer ID</th>
                                <th>Full Name</th>
                                <th>Project</th>
                                <th>Allotment Status</th>
                                <th>CNIC</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model)
                            {
                                var projectName = customer.PaymentPlan?.Project?.ProjectName
                                    ?? customer.Project?.ProjectName;
                                var custStatus = customer.Status ?? "Active";
                                var customerId = (customer.CustomerID ?? "").Trim();
                                <tr class="pms-listing-row pms-add-payment-row"
                                    data-customer-id="@customerId"
                                    title="Double-click to add payment">
                                    <td data-label="Customer ID">@customerId</td>
                                    <td data-label="Full Name">@customer.FullName</td>
                                    <td data-label="Project">@(string.IsNullOrWhiteSpace(projectName) ? "No project" : projectName)</td>
                                    <td data-label="Allotment Status">@(customer.Allotments != null && customer.Allotments.Any() ? "Allotted" : "Not allotted")</td>
                                    <td data-label="CNIC">@(customer.CNIC ?? "")</td>
                                    <td data-label="Status">@custStatus</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="fas fa-users fa-3x mb-3 text-muted"></i>
                <h5 class="text-muted">No customers found</h5>
                <p class="text-muted mb-0">Try adjusting Project, Status, or Search Customer.</p>
            </div>
        </div>
    }
</div>

<style>
    .pms-customer-page-heading {
        font-size: 1.2rem;
        font-weight: 700;
        color: #0f172a;
    }

    .pms-add-payment-subtitle {
        color: #000;
        font-size: 0.8125rem;
        font-weight: 500;
    }

    .pms-payment-listing .pms-customer-search-panel {
        padding: 0.75rem 1rem !important;
        background: #e8eef8 !important;
        border: 1px solid #c5d0e0 !important;
        border-radius: 12px;
    }

    .pms-customer-equal-field .form-select,
    .pms-customer-equal-field .form-control {
        width: 100% !important;
        border-radius: 0 !important;
        min-height: var(--pms-listing-control-h, 36px);
        height: var(--pms-listing-control-h, 36px);
    }

    .pms-customer-search-actions-row .pms-customer-action-btn--row {
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        width: 100% !important;
        border-radius: 0 !important;
        font-weight: 600;
        min-height: var(--pms-listing-control-h, 36px);
        height: var(--pms-listing-control-h, 36px);
        padding: 0.35rem 0.5rem !important;
        border: 1px solid transparent;
        white-space: nowrap;
        box-sizing: border-box;
        text-decoration: none;
    }

    .pms-customer-action-btn--search {
        background-color: #a8dadc !important;
        border-color: #8fc9cc !important;
        color: #1d3557 !important;
    }

    .pms-customer-action-btn--search:hover,
    .pms-customer-action-btn--search:focus {
        background-color: #95d0d3 !important;
        color: #1d3557 !important;
    }

    .pms-customer-action-btn--operations {
        background-color: #457b9d !important;
        border-color: #457b9d !important;
        color: #fff !important;
    }

    .pms-customer-action-btn--operations:hover,
    .pms-customer-action-btn--operations:focus {
        background-color: #3a6a88 !important;
        color: #fff !important;
    }

    .pms-customer-action-btn--report {
        background-color: #1d3557 !important;
        border-color: #1d3557 !important;
        color: #fff !important;
    }

    .pms-customer-action-btn--report:hover,
    .pms-customer-action-btn--report:focus {
        background-color: #162843 !important;
        color: #fff !important;
    }

    .pms-add-payment-hint {
        color: #000 !important;
        font-weight: 600;
        font-size: 0.8125rem;
    }

    .pms-payment-listing #addPaymentCustomersTable thead th,
    .pms-payment-listing .pms-saas-table thead th {
        background-color: #6059A6 !important;
        color: #fff !important;
        border-color: #524c96 !important;
        font-weight: 600;
    }

    .pms-payment-listing #addPaymentCustomersTable tbody td {
        color: #000 !important;
        font-weight: 400 !important;
        font-size: 0.875rem;
        background-color: transparent;
    }

    .pms-payment-listing #addPaymentCustomersTable tbody tr:nth-child(odd) {
        background-color: #ffffff !important;
    }

    .pms-payment-listing #addPaymentCustomersTable tbody tr:nth-child(even) {
        background-color: #f0f4f8 !important;
    }

    .pms-add-payment-row {
        cursor: pointer;
    }

    .pms-payment-listing #addPaymentCustomersTable tbody tr.pms-add-payment-row:hover {
        background-color: #dbe7f3 !important;
    }
</style>

@section Scripts {
    <script>
        (function () {
            var recordUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(recordPaymentUrl));
            var btn = document.getElementById('btnContinueAddPayment');

            function openPaymentForm(customerId) {
                var id = (customerId || '').trim();
                if (id) {
                    window.location.href = recordUrl + (recordUrl.indexOf('?') >= 0 ? '&' : '?') + 'customerId=' + encodeURIComponent(id);
                } else {
                    window.location.href = recordUrl;
                }
            }

            document.querySelectorAll('.pms-add-payment-row').forEach(function (row) {
                row.addEventListener('dblclick', function (e) {
                    if (e.target.closest('a, button')) return;
                    openPaymentForm(row.getAttribute('data-customer-id'));
                });
            });

            if (btn) {
                btn.addEventListener('click', function () {
                    openPaymentForm('');
                });
            }
        })();
    </script>
}
