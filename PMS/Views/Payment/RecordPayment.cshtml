@using System.Globalization
@using System.Linq
@{
    ViewData["Title"] = "Add Payment";
    var preSelectedCustomerId = (ViewBag.PreSelectedCustomerId as string)?.Trim();
    var preSelectedScheduleId = ViewBag.PreSelectedScheduleId as string;
    var schedule = ViewBag.Schedule as PMS.Models.PaymentSchedule;
    decimal scheduleOutstanding = ViewBag.ScheduleOutstanding != null ? (decimal)ViewBag.ScheduleOutstanding : 0m;
}

<div class="pms-record-payment">
    <div class="d-flex justify-content-end align-items-center mb-2 flex-wrap gap-2">
        <a asp-action="AddPayment" class="btn btn-outline-secondary btn-sm py-0 px-2">
            <i class="fas fa-users me-1"></i>Select Customer
        </a>
        <a asp-action="CustomerPayments" class="btn btn-outline-secondary btn-sm py-0 px-2">
            <i class="fas fa-arrow-left me-1"></i>Back to Payments
        </a>
    </div>

    @if (schedule != null)
    {
        <div class="card border-0 shadow-sm pms-mp-header mb-3">
            <div class="card-header py-1 px-3 pms-mp-header-bar">
                <h6 class="mb-0">
                    <i class="fas fa-calendar-alt me-2"></i>Installment #@(schedule.InstallmentNo?.ToString() ?? "N/A") - @schedule.PaymentDescription
                </h6>
            </div>
            <div class="card-body py-2 px-3">
                <div class="pms-registration-4col-form">
                    <div class="row g-1 g-lg-2 pms-registration-4col-row align-items-center">
                        <div class="col-12 col-lg-2">
                            <div class="form-label pms-registration-4col-label mb-0">Plan Name</div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="fw-semibold small">@schedule.PaymentPlan?.PlanName <span class="text-muted">(@schedule.PlanID)</span></div>
                        </div>
                        <div class="col-12 col-lg-2">
                            <div class="form-label pms-registration-4col-label mb-0">Due Date</div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="fw-semibold small @(schedule.DueDate < DateTime.Now ? "text-danger" : "text-success")">
                                @schedule.DueDate.ToString("dd-MM-yyyy")
                                @if (schedule.DueDate < DateTime.Now)
                                {
                                    <span class="text-danger"> — Overdue by @((DateTime.Now - schedule.DueDate).Days) days</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="row g-1 g-lg-2 pms-registration-4col-row align-items-center">
                        <div class="col-12 col-lg-2">
                            <div class="form-label pms-registration-4col-label mb-0">Outstanding</div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="fw-semibold small text-primary">PKR @scheduleOutstanding.ToString("N0")
                                <span class="text-muted fw-normal">(Total @schedule.Amount.ToString("N0") / Paid @((schedule.Amount - scheduleOutstanding).ToString("N0")))</span>
                            </div>
                        </div>
                        <div class="col-12 col-lg-2">
                            <div class="form-label pms-registration-4col-label mb-0">Surcharge Rate</div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="fw-semibold small">
                                @if (schedule.SurchargeApplied && schedule.DueDate < DateTime.Now)
                                {
                                    <span class="text-warning">@((schedule.SurchargeRate * 100).ToString("N1"))%</span>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm pms-mp-header mb-3">
        <div class="card-body py-2 px-3">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
                </div>
            }

            <form asp-action="RecordPayment" method="post" id="paymentForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" id="preSelectedScheduleId" value="@(preSelectedScheduleId ?? "")" />

                <div class="pms-registration-4col-form pms-record-payment-form">
                    <div class="row g-1 pms-registration-4col-row align-items-center">
                        <div class="col-auto pms-rp-label">
                            <label for="customerIdInput" class="form-label pms-registration-4col-label mb-0">Customer ID *</label>
                        </div>
                        <div class="col-auto pms-rp-field">
                            <div class="d-flex gap-1 align-items-center">
                                <input type="text" id="customerIdInput" class="form-control form-control-sm" placeholder="Enter Customer ID" value="@preSelectedCustomerId" autocomplete="off" />
                                <button type="button" id="btnSearchCustomer" class="btn btn-primary btn-sm flex-shrink-0 py-0">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                            <input type="hidden" name="customerId" id="customerId" value="" />
                        </div>
                        <div class="col-auto pms-rp-label">
                            <label for="scheduleId" class="form-label pms-registration-4col-label mb-0">Installment *</label>
                        </div>
                        <div class="col-auto pms-rp-field pms-rp-field-wide">
                            <select name="scheduleId" id="scheduleId" class="form-select form-select-sm" required disabled>
                                <option value="">Search by Customer ID first</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-0 pms-registration-4col-row pms-rp-status-row align-items-center">
                        <div class="col-12">
                            <div id="customerStatusRow" class="pms-rp-status-space small mb-0">
                                <span id="customerSearchMessage" class="fw-semibold text-success"></span>
                                <span id="customerNameDisplay" class="text-success" style="display: none;">
                                    <span id="customerNameText"></span>
                                    <span id="customerPlanText" class="ms-1 text-primary fw-semibold"></span>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-1 pms-registration-4col-row align-items-center">
                        <div class="col-auto pms-rp-label">
                            <label for="amount" class="form-label pms-registration-4col-label mb-0">Amount (PKR) *</label>
                        </div>
                        <div class="col-auto pms-rp-field">
                            <input type="text" name="amount" id="amount" class="form-control form-control-sm"
                                   placeholder="Enter amount" value="" required disabled inputmode="numeric" />
                            <div id="amountValidationError" class="invalid-feedback d-block" style="display: none !important;"></div>
                        </div>
                        <div class="col-auto pms-rp-label">
                            <label for="method" class="form-label pms-registration-4col-label mb-0">Payment Method *</label>
                        </div>
                        <div class="col-auto pms-rp-field">
                            <select name="method" id="method" class="form-select form-select-sm" required>
                                <option value="">Select Payment Method</option>
                                <option value="DD/DS" selected>DD/DS</option>
                                <option value="Cash">Cash</option>
                                <option value="Bank Transfer">Bank Transfer</option>
                                <option value="Cheque">Cheque</option>
                                <option value="Online">Online Payment</option>
                                <option value="Mobile Money">Mobile Money</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-1 pms-registration-4col-row align-items-center">
                        <div class="col-auto pms-rp-label">
                            <label for="referenceNo" class="form-label pms-registration-4col-label mb-0">Reference Number *</label>
                        </div>
                        <div class="col-auto pms-rp-field">
                            <input type="text" name="referenceNo" id="referenceNo" class="form-control form-control-sm"
                                   placeholder="Transaction/Receipt/Cheque Number" required />
                        </div>
                        <div class="col-auto pms-rp-label">
                            <label for="bankName" class="form-label pms-registration-4col-label mb-0">Bank Name *</label>
                        </div>
                        <div class="col-auto pms-rp-field">
                            <select name="bankName" id="bankName" class="form-select form-select-sm" required>
                                <option value="">Select Bank</option>
                                @foreach (var bank in (ViewBag.BankNames as IEnumerable<string> ?? Array.Empty<string>()))
                                {
                                    <option value="@bank">@bank</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row g-1 pms-registration-4col-row align-items-center">
                        <div class="col-auto pms-rp-label">
                            <label for="depositDate" class="form-label pms-registration-4col-label mb-0">Deposit Date *</label>
                        </div>
                        <div class="col-auto pms-rp-field">
                            <input type="date" name="depositDate" id="depositDate" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-auto pms-rp-label">
                            <label for="status" class="form-label pms-registration-4col-label mb-0">Payment Status *</label>
                        </div>
                        <div class="col-auto pms-rp-field">
                            <select name="status" id="status" class="form-select form-select-sm" required>
                                @{ var paymentStatusList = ViewBag.PaymentStatuses as IEnumerable<string> ?? new[] { "Pending", "Paid", "Partially Paid" }; }
                                @foreach (var s in paymentStatusList)
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row g-1 pms-registration-4col-row align-items-center">
                        <div class="col-auto pms-rp-label">
                            <label for="remarks" class="form-label pms-registration-4col-label mb-0">Remarks</label>
                        </div>
                        <div class="col-auto pms-rp-field">
                            <textarea name="remarks" id="remarks" class="form-control form-control-sm" rows="1"
                                      placeholder="Additional notes"></textarea>
                        </div>
                        <div class="col-auto pms-rp-label">
                            <label for="proofAttachment" class="form-label pms-registration-4col-label mb-0">Payment Proof</label>
                        </div>
                        <div class="col-auto pms-rp-field">
                            <input type="file" name="proofAttachment" id="proofAttachment" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.gif,.bmp,.pdf" />
                        </div>
                    </div>

                    <div class="row g-1 pms-registration-4col-row align-items-center">
                        <div class="col-auto pms-rp-label">
                            <label for="proofDescription" class="form-label pms-registration-4col-label mb-0">Proof Title</label>
                        </div>
                        <div class="col-auto pms-rp-field">
                            <input type="text" name="proofDescription" id="proofDescription" class="form-control form-control-sm" maxlength="500" placeholder="e.g. Deposit Slip" />
                        </div>
                        <div class="col-auto pms-rp-label">
                            <label class="form-label pms-registration-4col-label mb-0">Extra Payment</label>
                        </div>
                        <div class="col-auto pms-rp-field">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" id="addExtraPayment" name="addExtraPayment" value="true" />
                                    <label class="form-check-label small" for="addExtraPayment">Extra</label>
                                </div>
                                <div class="input-group input-group-sm" style="max-width: 9rem;">
                                    <span class="input-group-text py-0">PKR</span>
                                    <input type="text" name="extraAmount" id="extraAmount" class="form-control form-control-sm"
                                           inputmode="numeric" placeholder="Amount" disabled />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="scheduleInfo" class="alert mt-2 mb-2 py-1 px-2 small" style="background: rgba(37, 99, 235, 0.06); border: 1px solid rgba(37, 99, 235, 0.2); display: none;">
                    <div class="row g-1">
                        <div class="col-md-4">
                            <span class="pms-registration-4col-label d-block">Installment</span>
                            <strong id="infoDescription">-</strong>
                        </div>
                        <div class="col-md-4">
                            <span class="pms-registration-4col-label d-block">Due Date</span>
                            <strong id="infoDueDate">-</strong>
                        </div>
                        <div class="col-md-4">
                            <span class="pms-registration-4col-label d-block">Outstanding</span>
                            <strong id="infoAmount" class="text-primary">-</strong>
                            <small class="text-muted d-block">Total: <span id="infoTotal">-</span> · Paid: <span id="infoPaid">-</span></small>
                        </div>
                    </div>
                    <div id="surchargeWarning" class="mt-1 p-1 rounded" style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.4); display: none;">
                        <i class="fas fa-exclamation-triangle text-warning me-1"></i>
                        <span id="surchargeWarningText"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-2 pt-2 border-top">
                    <button type="submit" id="btnSubmitPayment" class="btn btn-sm fw-semibold pms-mp-btn-save" disabled>
                        <i class="fas fa-check me-1"></i>Record Payment
                    </button>
                    <a asp-action="CustomerPayments" class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-times me-1"></i>Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>

    @if (schedule != null && schedule.SurchargeApplied && schedule.DueDate < DateTime.Now)
    {
        var daysLate = (DateTime.Now - schedule.DueDate).Days;
        var surchargeAmount = schedule.Amount * schedule.SurchargeRate;
        var totalWithSurcharge = schedule.Amount + surchargeAmount;

        <div class="card border-0 shadow-sm pms-mp-header mb-3" style="border-left: 4px solid #f59e0b !important;">
            <div class="card-header py-1 px-3 pms-mp-header-bar">
                <h6 class="mb-0">
                    <i class="fas fa-exclamation-triangle me-2"></i>Late Payment Surcharge Applied
                </h6>
            </div>
            <div class="card-body py-2 px-3">
                <div class="pms-registration-4col-form">
                    <div class="row g-1 g-lg-2 pms-registration-4col-row align-items-center">
                        <div class="col-12 col-lg-2">
                            <div class="form-label pms-registration-4col-label mb-0">Days Overdue</div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="fw-semibold small text-danger">@daysLate days</div>
                        </div>
                        <div class="col-12 col-lg-2">
                            <div class="form-label pms-registration-4col-label mb-0">Surcharge (@((schedule.SurchargeRate * 100).ToString("N1"))%)</div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="fw-semibold small text-warning">PKR @surchargeAmount.ToString("N0")</div>
                        </div>
                    </div>
                    <div class="row g-1 g-lg-2 pms-registration-4col-row align-items-center">
                        <div class="col-12 col-lg-2">
                            <div class="form-label pms-registration-4col-label mb-0">Total Amount Due</div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="fw-semibold small text-primary">PKR @totalWithSurcharge.ToString("N0")</div>
                        </div>
                        <div class="col-12 col-lg-2"></div>
                        <div class="col-12 col-lg-4"></div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .pms-record-payment .pms-registration-4col-label,
    .pms-record-payment .pms-registration-4col-form .form-label {
        color: #2563eb !important;
        font-weight: 600 !important;
        font-size: 0.75rem !important;
        line-height: 1.2;
    }

    .pms-record-payment .card-body {
        padding: 0.5rem 0.75rem !important;
    }

    .pms-record-payment-form .pms-registration-4col-row {
        margin-bottom: 0.25rem !important;
        padding-bottom: 0.25rem !important;
        border-bottom: 1px solid #e2e8f0;
    }

    .pms-record-payment-form .pms-registration-4col-row:last-child {
        border-bottom: none;
        margin-bottom: 0 !important;
        padding-bottom: 0 !important;
    }

    .pms-record-payment-form .pms-rp-status-row {
        min-height: 1.35rem;
        border-bottom: none !important;
        margin-bottom: 0.15rem !important;
        padding-bottom: 0.15rem !important;
    }

    .pms-record-payment-form .pms-rp-status-space {
        min-height: 1.2rem;
        line-height: 1.2rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .pms-record-payment-form .pms-rp-label {
        flex: 0 0 auto;
        width: 8.75rem;
        max-width: 8.75rem;
    }

    .pms-record-payment-form .pms-rp-field {
        flex: 0 0 20%;
        width: 20%;
        max-width: 20%;
    }

    .pms-record-payment-form .pms-rp-field-wide {
        flex: 0 0 28%;
        width: 28%;
        max-width: 28%;
    }

    .pms-record-payment-form .pms-rp-field .form-control,
    .pms-record-payment-form .pms-rp-field .form-select,
    .pms-record-payment-form .pms-rp-field .input-group {
        width: 100%;
        max-width: 100%;
    }

    .pms-record-payment-form .form-control-sm,
    .pms-record-payment-form .form-select-sm {
        min-height: 1.7rem;
        padding-top: 0.15rem;
        padding-bottom: 0.15rem;
        font-size: 0.8125rem;
    }

    @@media (max-width: 991.98px) {
        .pms-record-payment-form .pms-rp-label,
        .pms-record-payment-form .pms-rp-field,
        .pms-record-payment-form .pms-rp-field-wide {
            flex: 0 0 100%;
            width: 100%;
            max-width: 100%;
        }
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            var formatCurrency = function(value) {
                var numeric = Number(value || 0);
                return numeric.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 });
            };

            var schedulesData = []; // store schedule objects from last search for schedule change handler
            function parseWhole(value) {
                var digits = String(value || '').replace(/[^\d]/g, '');
                return digits ? parseInt(digits, 10) : 0;
            }
            function sanitizeWholeInput($input, minValue) {
                var n = parseWhole($input.val());
                if (n > 0) {
                    if (minValue && n < minValue) n = minValue;
                    $input.val(String(n));
                } else {
                    $input.val('');
                }
                return n;
            }

            function setSubmitState() {
                var hasCustomer = $('#customerId').val();
                var hasSchedule = $('#scheduleId').val() && !$('#scheduleId').prop('disabled');
                var hasAmount = parseWhole($('#amount').val()) > 0;
                $('#btnSubmitPayment').prop('disabled', !hasCustomer || !hasSchedule || !hasAmount);
            }

            // Search customer
            $('#btnSearchCustomer').on('click', function() {
                var input = $('#customerIdInput').val().trim();
                $('#customerIdInput').val(input);
                var $msg = $('#customerSearchMessage');
                var $nameDisplay = $('#customerNameDisplay');
                var $scheduleSelect = $('#scheduleId');
                var $amount = $('#amount');

                $msg.removeClass('text-danger text-success').text('');
                $nameDisplay.hide();
                $('#customerNameText').text('');
                $('#customerPlanText').text('').hide();
                $('#customerId').val('');
                $scheduleSelect.prop('disabled', true).find('option:not(:first)').remove();
                $scheduleSelect.find('option:first').text('Search by Customer ID first');
                $amount.val('').prop('disabled', true);
                $('#scheduleInfo').hide();
                schedulesData = [];
                setSubmitState();

                if (!input) {
                    $msg.addClass('text-danger').text('Please enter a Customer ID.');
                    return;
                }

                $('#btnSearchCustomer').prop('disabled', true);
                $.get('@Url.Action("GetCustomerPaymentInfo", "Payment")', { customerId: input })
                    .done(function(data) {
                        if (data.found) {
                            $('#customerId').val(data.customerId);
                            $('#customerIdInput').val(data.customerId);
                            $msg.removeClass('text-danger').addClass('text-success').text('Customer Exist');
                            var namePart = (data.fullName || '') + ' (' + data.customerId + ')';
                            $('#customerNameText').text(namePart);
                            if (data.planName) {
                                $('#customerPlanText').text('Plan: ' + data.planName).show();
                            } else {
                                $('#customerPlanText').text('').hide();
                            }
                            $nameDisplay.css('display', 'inline').addClass('ms-2');
                            schedulesData = data.schedules || [];
                            $scheduleSelect.prop('disabled', false);
                            if (schedulesData.length === 0) {
                                $scheduleSelect.find('option:first').text('No due installments');
                            } else {
                                $scheduleSelect.find('option:first').text('Select Installment');
                                var totalDueSurcharge = parseFloat(data.totalDueSurcharge) || 0;
                                if (totalDueSurcharge > 0) {
                                    var surchargeOpt = $('<option></option>')
                                        .val('SURCHARGE_PAYMENT')
                                        .text('Surcharge Payment - PKR ' + formatCurrency(totalDueSurcharge))
                                        .data('amount', totalDueSurcharge)
                                        .data('total', totalDueSurcharge)
                                        .data('paid', 0)
                                        .data('description', 'Surcharge Payment')
                                        .data('duedate', '-')
                                        .data('surchargeApplied', false)
                                        .data('surchargeRate', 0)
                                        .data('isOverdue', false)
                                        .data('isSurchargePayment', true);
                                    $scheduleSelect.append(surchargeOpt);
                                }
                                var customerPlanName = data.planName || '';
                                schedulesData.forEach(function(s) {
                                    // Only show rows that belong to this customer's plan
                                    if (data.planId && s.planId && String(s.planId).trim() !== String(data.planId).trim()) {
                                        return;
                                    }
                                    var displayPlan = (s.planName || customerPlanName || '').trim();
                                    var outstandingLabel = (s.isOverdue ? ' (Outstanding)' : '');
                                    var optText = '[' + displayPlan + '] Installment #' + (s.installmentNo != null ? s.installmentNo : 'N/A') + ' - ' + (s.paymentDescription || '') + ' - Due ' + (s.dueDate || '') + ' - PKR ' + formatCurrency(s.outstanding) + outstandingLabel;
                                    var opt = $('<option></option>')
                                        .val(s.scheduleId)
                                        .text(optText)
                                        .data('amount', s.outstanding)
                                        .data('total', s.amount)
                                        .data('paid', s.paid)
                                        .data('description', s.paymentDescription)
                                        .data('duedate', s.dueDate)
                                        .data('surchargeApplied', s.surchargeApplied)
                                        .data('surchargeRate', s.surchargeRate)
                                        .data('isOverdue', s.isOverdue)
                                        .data('isSurchargePayment', false);
                                    $scheduleSelect.append(opt);
                                });
                                var preSel = $('#preSelectedScheduleId').val();
                                if (preSel) {
                                    $scheduleSelect.val(preSel);
                                    if ($scheduleSelect.val() === preSel) $scheduleSelect.trigger('change');
                                }
                            }
                        } else {
                            $msg.removeClass('text-success').addClass('text-danger').text(data.message || 'Customer not found.');
                            $nameDisplay.hide();
                        }
                    })
                    .fail(function(jqXHR, textStatus, errorThrown) {
                        $msg.addClass('text-danger').text('Search failed. Please try again.');
                    })
                    .always(function() {
                        $('#btnSearchCustomer').prop('disabled', false);
                    });
            });

            $('#customerIdInput').on('keypress', function(e) {
                if (e.which === 13) {
                    e.preventDefault();
                    $('#btnSearchCustomer').click();
                }
            });

            // Schedule selection: show info, pre-fill amount (editable), enable amount
            $('#scheduleId').on('change', function() {
                var val = $(this).val();
                if (!val) {
                    $('#scheduleInfo').hide();
                    $('#amount').val('').prop('disabled', true);
                    setSubmitState();
                    return;
                }
                var selected = $(this).find('option:selected');
                var amount = parseFloat(selected.data('amount')) || 0;
                var total = parseFloat(selected.data('total')) || 0;
                var paid = parseFloat(selected.data('paid')) || 0;
                var description = selected.data('description');
                var dueDate = selected.data('duedate');
                var surchargeApplied = selected.data('surchargeApplied');
                var surchargeRate = selected.data('surchargeRate');
                var isOverdue = selected.data('isOverdue');
                var isSurchargePayment = selected.data('isSurchargePayment') === true;

                $('#scheduleInfo').show();
                $('#infoDescription').text(description || '-');
                $('#infoDueDate').text(dueDate || '-');
                $('#infoAmount').text('PKR ' + formatCurrency(amount));
                $('#infoTotal').text('PKR ' + formatCurrency(total));
                $('#infoPaid').text('PKR ' + formatCurrency(paid));

                if (!isSurchargePayment && surchargeApplied && isOverdue && surchargeRate > 0) {
                    var surchargeAmount = total * surchargeRate;
                    var totalWithSurcharge = total + surchargeAmount;
                    $('#surchargeWarning').show();
                    $('#surchargeWarningText').text('Late payment surcharge ' + (surchargeRate * 100).toFixed(1) + '% may apply. Total with surcharge: PKR ' + formatCurrency(totalWithSurcharge));
                } else {
                    $('#surchargeWarning').hide();
                }

                $('#amount').prop('disabled', false).attr('max', amount).removeClass('is-invalid');
                $('#amountValidationError').hide().removeClass('text-danger').text('');
                if (amount > 0) {
                    $('#amount').val(Math.round(amount));
                }
                updateStatusOptions();
                setSubmitState();
            });

            function updateStatusOptions() {
                var maxDue = parseFloat($('#scheduleId').find('option:selected').data('amount')) || 0;
                var amount = parseWhole($('#amount').val());
                var isSurchargePayment = $('#scheduleId').val() === 'SURCHARGE_PAYMENT';
                var $status = $('#status');
                $status.find('option').prop('disabled', false).end().removeClass('is-invalid');
                if (isSurchargePayment) {
                    $status.val('Surcharge Paid');
                    $status.find('option:not([value="Surcharge Paid"])').prop('disabled', true);
                    return;
                }
                if (maxDue <= 0) return;
                var isFullPayment = (amount >= maxDue);
                if (isFullPayment) {
                    if (!$status.val() || $status.val() === 'Pending') {
                        $status.val('Paid');
                    }
                } else {
                    if (!$status.val() || $status.val() === 'Pending') {
                        $status.val('Partially Paid');
                    }
                }
            }

            $('#amount').on('input', function() {
                sanitizeWholeInput($(this), 1);
                setSubmitState();
                var maxDue = parseFloat($('#scheduleId').find('option:selected').data('amount')) || 0;
                var val = parseWhole($(this).val());
                var $err = $('#amountValidationError');
                if (maxDue > 0 && val > maxDue) {
                    $err.css('display', 'block').addClass('text-danger').text('Amount must not exceed Total Due (PKR ' + formatCurrency(maxDue) + ').');
                    $('#amount').addClass('is-invalid');
                } else {
                    $err.hide().removeClass('text-danger').text('');
                    $('#amount').removeClass('is-invalid');
                }
                updateStatusOptions();
            });

            $('#addExtraPayment').on('change', function() {
                var enabled = $(this).is(':checked');
                $('#extraAmount').prop('disabled', !enabled);
                if (!enabled) {
                    $('#extraAmount').val('').removeClass('is-invalid');
                }
                setSubmitState();
            });

            $('#extraAmount').on('input', function() {
                sanitizeWholeInput($(this), 1);
                setSubmitState();
            });

            // Form submit: ensure amount does not exceed Total Due
            $('#paymentForm').on('submit', function(e) {
                var $schedule = $('#scheduleId').find('option:selected');
                var maxDue = parseFloat($schedule.data('amount')) || 0;
                var amount = parseWhole($('#amount').val());
                var addExtraPayment = $('#addExtraPayment').is(':checked');
                var extraAmount = parseWhole($('#extraAmount').val());
                var isSurchargePayment = $('#scheduleId').val() === 'SURCHARGE_PAYMENT';
                if (maxDue > 0 && amount > maxDue) {
                    e.preventDefault();
                    $('#amountValidationError').css('display', 'block').addClass('text-danger')
                        .text((isSurchargePayment ? 'Amount must not exceed Total Due Surcharge (PKR ' : 'Amount must not exceed Total Due (PKR ') + formatCurrency(maxDue) + ').');
                    $('#amount').addClass('is-invalid').focus();
                    return false;
                }
                if (addExtraPayment && extraAmount <= 0) {
                    e.preventDefault();
                    $('#extraAmount').addClass('is-invalid').focus();
                    alert('Enter extra amount greater than zero, or uncheck Add Extra Payment.');
                    return false;
                }
                if (!addExtraPayment) {
                    $('#extraAmount').val('');
                }
            });

            // Payment method placeholder
            $('#method').on('change', function() {
                var method = $(this).val();
                var refInput = $('#referenceNo');
                if (method === 'Cash') refInput.attr('placeholder', 'Receipt Number (optional)');
                else if (method === 'DD/DS') refInput.attr('placeholder', 'DD/DS Reference Number');
                else if (method === 'Bank Transfer') refInput.attr('placeholder', 'Transaction Reference Number');
                else if (method === 'Cheque') refInput.attr('placeholder', 'Cheque Number');
                else if (method === 'Online') refInput.attr('placeholder', 'Online Transaction ID');
                else if (method === 'Mobile Money') refInput.attr('placeholder', 'Mobile Money Transaction ID');
                else refInput.attr('placeholder', 'Transaction/Receipt/Cheque Number');
            });
            $('#method').trigger('change'); // set default DD/DS placeholder on load

            // Pre-fill from URL (e.g. from Payment Schedule link)
            @if (!string.IsNullOrEmpty(preSelectedCustomerId))
            {
                <text>
                $('#customerIdInput').val('@Html.Raw(System.Net.WebUtility.HtmlEncode(preSelectedCustomerId))');
                $('#btnSearchCustomer').click();
                </text>
            }
        });
    </script>
}
