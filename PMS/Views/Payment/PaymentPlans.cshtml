@model IEnumerable<PMS.Models.PaymentPlan>
@using System.Globalization

@{
    ViewData["Title"] = "Payment Plans (Batches)";
    var EnUs = CultureInfo.GetCultureInfo("en-US");
    var plansOrdered = Model?.OrderBy(p => p.PlanName).ToList() ?? new List<PMS.Models.PaymentPlan>();
    var totalCount = plansOrdered.Count;
    var totalCustomers = plansOrdered.Sum(p => p.Customers?.Count ?? 0);
    var totalValueSsp = plansOrdered.Sum(p => p.TotalAmount);
    var totalSchedules = plansOrdered.Sum(p => p.PaymentSchedules?.Count ?? 0);
    var deleteSummaryUrl = Url.Action("GetPaymentPlanDeleteSummary", "Payment");
}

<div class="pms-payment-listing pms-listing-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h5 class="pms-grid-title mb-0">Payment Plans</h5>
        <span class="badge rounded-pill pms-record-badge">@totalCount plan@(totalCount == 1 ? "" : "s")</span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-1 px-2 mb-2 small" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-1 px-2 mb-2 small" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-2 mb-2">
        <div class="col-6 col-md-3">
            <div class="card border-0 h-100" style="background:#e8f0fe;">
                <div class="card-body text-center py-2 px-2">
                    <div class="small text-muted text-uppercase fw-semibold mb-0">Total Plans</div>
                    <div class="fs-5 fw-bold text-primary mb-0">@totalCount</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 h-100" style="background:#d1ecf1;">
                <div class="card-body text-center py-2 px-2">
                    <div class="small text-muted text-uppercase fw-semibold mb-0">Customers</div>
                    <div class="fs-5 fw-bold text-info mb-0">@totalCustomers</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 h-100" style="background:#d4edda;">
                <div class="card-body text-center py-2 px-2">
                    <div class="small text-muted text-uppercase fw-semibold mb-0">Total Value</div>
                    <div class="fs-6 fw-bold text-success mb-0">@totalValueSsp.ToString("N0", EnUs)</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 h-100" style="background:#fff3cd;">
                <div class="card-body text-center py-2 px-2">
                    <div class="small text-muted text-uppercase fw-semibold mb-0">Schedules</div>
                    <div class="fs-5 fw-bold text-warning mb-0">@totalSchedules</div>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-2">
        <div class="pms-listing-search-wrap">
            <div class="d-flex flex-wrap gap-2 pms-listing-search-actions">
                <partial name="_PaymentPlansOperationsDropdown" />
            </div>
        </div>
    </div>

    <div class="card pms-grid-card pms-listing-flat pms-saas-grid mb-2">
        <div class="card-body">
            <div class="table-responsive pms-saas-table-wrap">
                <table class="table pms-saas-table" id="plansTable">
                    <thead>
                        <tr>
                            <th class="pms-saas-th-actions">Actions</th>
                            <th>Plan ID</th>
                            <th>Plan Name</th>
                            <th>Project</th>
                            <th class="text-end">Total (PKR)</th>
                            <th>Curr.</th>
                            <th>Duration</th>
                            <th>Freq.</th>
                            <th>Cust.</th>
                            <th>Sched.</th>
                            <th class="text-end">Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var plan in plansOrdered)
                        {
                            var schedulesSumPkr = plan.PaymentSchedules?.Sum(s => s.Amount) ?? 0m;
                            var balancePkr = plan.TotalAmount - schedulesSumPkr;
                            var hasBalanceRemaining = balancePkr > 0.0000001m;
                            <tr class="@(hasBalanceRemaining ? "plan-balance-remaining" : null)">
                                <td class="pms-saas-td-actions" data-label="Actions">
                                    <div class="pms-row-actions" role="group">
                                        <a asp-action="PaymentSchedule" asp-route-planId="@plan.PlanID"
                                           class="btn btn-sm btn-outline-primary" title="View Schedules">
                                            <i class="bi bi-calendar-check" aria-hidden="true"></i>
                                        </a>
                                        <a asp-action="PaymentPlanDetails"
                                           asp-route-planId="@plan.PlanID"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="View Details">
                                            <i class="bi bi-eye" aria-hidden="true"></i>
                                        </a>
                                        @if (ViewBag.CanDelete == true)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger js-delete-payment-plan"
                                                    title="Delete payment plan"
                                                    data-plan-id="@plan.PlanID"
                                                    data-plan-name="@plan.PlanName">
                                                <i class="bi bi-trash" aria-hidden="true"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                                <td data-label="Plan ID"><code>@plan.PlanID</code></td>
                                <td data-label="Plan Name">
                                    <div>@plan.PlanName</div>
                                    @if (!string.IsNullOrEmpty(plan.Description))
                                    {
                                        <div class="small text-muted">@(plan.Description.Length > 40 ? plan.Description.Substring(0, 40) + "…" : plan.Description)</div>
                                    }
                                </td>
                                <td data-label="Project">
                                    @if (plan.Project != null)
                                    {
                                        <span class="pms-pill pms-pill--info">@plan.Project.ProjectName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-end fw-semibold text-success" data-label="Total (PKR)">
                                    @plan.TotalAmount.ToString("N0", EnUs)
                                </td>
                                <td data-label="Curr.">
                                    <span class="pms-pill pms-pill--neutral text-uppercase">@plan.Currency</span>
                                </td>
                                <td data-label="Duration">@(plan.DurationMonths?.ToString() ?? "—") mo</td>
                                <td data-label="Freq.">
                                    <span class="pms-pill pms-pill--neutral">@plan.Frequency</span>
                                </td>
                                <td data-label="Cust.">
                                    <span class="pms-pill pms-pill--info">@(plan.Customers?.Count ?? 0)</span>
                                </td>
                                <td data-label="Sched.">
                                    <span class="pms-pill @(plan.PaymentSchedules?.Any() == true ? "pms-pill--success" : "pms-pill--warning")">
                                        @(plan.PaymentSchedules?.Count ?? 0)
                                    </span>
                                </td>
                                <td class="text-end" data-label="Balance">
                                    <span class="fw-semibold @(hasBalanceRemaining ? "text-success" : balancePkr < -0.0000001m ? "text-danger" : "text-muted")">
                                        @balancePkr.ToString("N0", EnUs)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.CanDelete == true)
{
    <div class="modal fade" id="deletePaymentPlanModal" tabindex="-1" aria-labelledby="deletePaymentPlanModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white py-2">
                    <h6 class="modal-title mb-0" id="deletePaymentPlanModalLabel">
                        <i class="fas fa-exclamation-triangle me-1"></i>Delete payment plan
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-2 small">
                    <p class="fw-semibold mb-2" id="deletePlanTitle"></p>
                    <div id="deletePlanSummaryBody" class="text-muted"></div>
                    <div id="deletePlanCustomerBlock" class="mt-2 d-none">
                        <div class="alert alert-warning mb-2 py-1 px-2">
                            <strong id="deletePlanCustomerCountText"></strong> These customers will lose this plan assignment (their Plan ID will be cleared).
                        </div>
                        <div class="border rounded p-2 bg-light" style="max-height: 160px; overflow-y: auto;">
                            <ul class="mb-0" id="deletePlanCustomerList"></ul>
                        </div>
                    </div>
                    <p class="text-danger mt-2 mb-0">
                        This removes the plan and all installment rows. It cannot be undone. You cannot delete a plan that still has payments recorded against any installment.
                    </p>
                </div>
                <div class="modal-footer py-2">
                    <form asp-action="DeletePaymentPlan" method="post" id="deletePaymentPlanForm" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="planId" id="deletePaymentPlanFormPlanId" value="" />
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger btn-sm" id="deletePaymentPlanConfirmBtn">
                            <i class="fas fa-trash-alt me-1"></i>Delete plan
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .pms-payment-listing #plansTable tbody tr.plan-balance-remaining {
        box-shadow: inset 3px 0 0 0 var(--accent-gold, #f59e0b);
        background-color: rgba(245, 158, 11, 0.1);
    }

    .pms-payment-listing #plansTable tbody tr.plan-balance-remaining:hover {
        background-color: rgba(245, 158, 11, 0.16);
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#plansTable').DataTable({
                pageLength: 25,
                order: [[2, 'asc']],
                columnDefs: [{ orderable: false, targets: 0 }],
                language: {
                    search: 'Search:',
                    lengthMenu: 'Show _MENU_',
                    info: '_START_–_END_ of _TOTAL_',
                    infoEmpty: 'No plans',
                    infoFiltered: '(filtered from _MAX_)'
                }
            });

            var deleteSummaryUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(deleteSummaryUrl));
            var deleteModalEl = document.getElementById('deletePaymentPlanModal');
            var deleteModal = deleteModalEl ? new bootstrap.Modal(deleteModalEl) : null;

            $('#plansTable').on('click', '.js-delete-payment-plan', function () {
                var $btn = $(this);
                var planId = $btn.data('plan-id');
                var planName = $btn.data('plan-name') || '';
                if (!planId || !deleteModal) {
                    return;
                }
                $btn.prop('disabled', true);
                var url = deleteSummaryUrl + (deleteSummaryUrl.indexOf('?') >= 0 ? '&' : '?') + 'planId=' + encodeURIComponent(planId);
                fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
                    .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
                    .then(function (res) {
                        if (!res.data || res.data.found === false) {
                            alert(res.data && res.data.message ? res.data.message : 'Could not load plan details for delete.');
                            return;
                        }
                        if (!res.data.canDelete) {
                            alert(res.data.message || 'This plan cannot be deleted because payments are linked to its installments.');
                            return;
                        }
                        $('#deletePlanTitle').text('Delete “' + (res.data.planName || planName) + '” (' + res.data.planId + ')?');
                        var lines = [];
                        lines.push('Installment rows to remove: ' + (res.data.scheduleCount || 0));
                        lines.push('Payments linked to installments: ' + (res.data.paymentCount || 0) + ' (must be zero to delete).');
                        $('#deletePlanSummaryBody').html(lines.join('<br />'));

                        var cc = res.data.customerCount || 0;
                        if (cc > 0) {
                            $('#deletePlanCustomerCountText').text(cc + ' customer(s) are assigned to this plan.');
                            var $ul = $('#deletePlanCustomerList').empty();
                            (res.data.customers || []).forEach(function (c) {
                                var name = (c.fullName || '').trim() || '(no name)';
                                $ul.append($('<li></li>').text((c.customerId || '') + ' — ' + name));
                            });
                            if (cc > (res.data.customers || []).length) {
                                $ul.append($('<li class="text-muted"></li>').text('… and ' + (cc - (res.data.customers || []).length) + ' more (see Activity Log after delete for full snapshot in audit JSON).'));
                            }
                            $('#deletePlanCustomerBlock').removeClass('d-none');
                        } else {
                            $('#deletePlanCustomerBlock').addClass('d-none');
                        }

                        $('#deletePaymentPlanFormPlanId').val(res.data.planId);
                        $('#deletePaymentPlanConfirmBtn').prop('disabled', false);
                        deleteModal.show();
                    })
                    .catch(function () {
                        alert('Could not load delete preview. Check your connection or permissions.');
                    })
                    .finally(function () {
                        $btn.prop('disabled', false);
                    });
            });

            if (deleteModalEl) {
                deleteModalEl.addEventListener('hidden.bs.modal', function () {
                    $('#deletePaymentPlanFormPlanId').val('');
                    $('#deletePlanCustomerList').empty();
                });
            }
        });
    </script>
}
