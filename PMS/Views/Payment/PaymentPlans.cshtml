@model IEnumerable<PMS.Models.PaymentPlan>
@using System.Globalization

@{
    ViewData["Title"] = "Payment Plans (Batches)";
    var EnUs = CultureInfo.GetCultureInfo("en-US");
    var plansOrdered = Model?.OrderBy(p => p.PlanName).ToList() ?? new List<PMS.Models.PaymentPlan>();
    var totalCount = plansOrdered.Count;
}

<div class="pms-payment-listing pms-listing-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h4 class="pms-grid-title pms-payment-plans-heading mb-0">Payment Plans</h4>
        <span class="badge rounded-pill pms-record-badge">@totalCount plan@(totalCount == 1 ? "" : "s")</span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-1 px-2 mb-2 small" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-1 px-2 mb-2 small" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="pms-payment-plans-search mb-2">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-6">
                <label for="planSearchTerm" class="visually-hidden">Search plans</label>
                <input type="text"
                       id="planSearchTerm"
                       class="form-control"
                       placeholder="Search by Plan Name or Frequency"
                       aria-label="Search by Plan Name or Frequency" />
            </div>
        </div>
    </div>

    <div class="card pms-grid-card pms-listing-flat pms-saas-grid mb-2">
        <div class="card-body py-2">
            <div class="pms-saas-table-wrap pms-payment-plans-grid-wrap">
                <table class="table pms-saas-table" id="plansTable">
                    <thead>
                        <tr>
                            <th>Plan Name</th>
                            <th class="text-end">Total (PKR)</th>
                            <th>Curr.</th>
                            <th>Duration</th>
                            <th>Freq.</th>
                            <th>Sched.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var plan in plansOrdered)
                        {
                            <tr class="pms-plan-row"
                                data-plan-id="@plan.PlanID"
                                data-open-url="@Url.Action("AddPlan", "Payment", new { planId = plan.PlanID })"
                                title="Double-click to open plan and schedules">
                                <td data-label="Plan Name">
                                    <a asp-action="AddPlan"
                                       asp-route-planId="@plan.PlanID"
                                       class="text-decoration-none fw-semibold">
                                        @plan.PlanName
                                    </a>
                                </td>
                                <td class="text-end fw-semibold" data-label="Total (PKR)">
                                    @plan.TotalAmount.ToString("N0", EnUs)
                                </td>
                                <td data-label="Curr.">
                                    <span class="pms-pill pms-pill--neutral text-uppercase">@(string.IsNullOrWhiteSpace(plan.Currency) ? "—" : plan.Currency)</span>
                                </td>
                                <td data-label="Duration">
                                    @(plan.DurationMonths.HasValue
                                        ? (plan.DurationMonths.Value == 1 ? "1 Month" : $"{plan.DurationMonths.Value} Months")
                                        : "—")
                                </td>
                                <td data-label="Freq.">
                                    <span class="pms-pill pms-pill--neutral">@(string.IsNullOrWhiteSpace(plan.Frequency) ? "—" : plan.Frequency)</span>
                                </td>
                                <td data-label="Sched.">
                                    @(plan.PaymentSchedules?.Count ?? 0)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .pms-payment-listing .pms-payment-plans-heading {
        font-size: 1.2rem;
        font-weight: 700;
        color: #0f172a;
    }

    .pms-payment-listing .pms-payment-plans-search {
        border: none !important;
        border-radius: 0 !important;
        padding: 0 !important;
        background: transparent !important;
    }

    .pms-payment-listing .pms-payment-plans-search .form-control {
        min-height: var(--pms-listing-control-h, 36px);
        height: var(--pms-listing-control-h, 36px);
        border-radius: 0 !important;
        border: 1px solid #94a3b8;
    }

    .pms-payment-listing {
        --saas-row-h: 64px;
    }

    .pms-payment-listing .pms-payment-plans-grid-wrap {
        overflow-x: hidden;
        overflow-y: visible;
        max-height: none;
        min-height: 420px;
    }

    .pms-payment-listing #plansTable {
        table-layout: fixed;
        width: 100% !important;
        margin-bottom: 0;
        color: #000 !important;
    }

    .pms-payment-listing #plansTable,
    .pms-payment-listing #plansTable tbody td,
    .pms-payment-listing #plansTable tbody td a,
    .pms-payment-listing #plansTable tbody td .fw-semibold {
        color: #000 !important;
    }

    .pms-payment-listing #plansTable thead th {
        background-color: #6059A6 !important;
        color: #fff !important;
        border-color: #524c96 !important;
        font-size: 0.8125rem !important;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 0.65rem 1rem !important;
        line-height: 1.2;
        vertical-align: middle;
        white-space: nowrap;
        cursor: default !important;
    }

    .pms-payment-listing #plansTable thead th.sorting,
    .pms-payment-listing #plansTable thead th.sorting_asc,
    .pms-payment-listing #plansTable thead th.sorting_desc,
    .pms-payment-listing #plansTable thead th.sorting_asc_disabled,
    .pms-payment-listing #plansTable thead th.sorting_desc_disabled {
        background-image: none !important;
    }

    .pms-payment-listing #plansTable tbody td {
        height: var(--saas-row-h) !important;
        padding: 0 1rem !important;
        vertical-align: middle;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 0.875rem;
        border-bottom: 1px solid #e2e8f0 !important;
        max-width: none;
    }

    .pms-payment-listing #plansTable tbody tr:nth-child(even) {
        background-color: #f8fafc;
    }

    .pms-payment-listing #plansTable tbody tr {
        cursor: pointer;
        transition: background-color 0.15s ease;
    }

    .pms-payment-listing #plansTable tbody tr:hover {
        background-color: #f1f5f9 !important;
        box-shadow: inset 3px 0 0 #2563eb;
    }

    .pms-payment-listing #plansTable .pms-pill {
        font-size: 0.78rem;
        padding: 0.15rem 0.45rem;
        line-height: 1.2;
        border-radius: 999px;
        color: #000 !important;
    }

    .pms-payment-listing .pms-plans-dt-footer {
        width: 100%;
        padding: 0.5rem 0.25rem 0.25rem;
    }

    .pms-payment-listing .pms-plans-dt-footer .dataTables_length,
    .pms-payment-listing .pms-plans-dt-footer .dataTables_info,
    .pms-payment-listing .pms-plans-dt-footer .dataTables_paginate {
        float: none !important;
        padding: 0 !important;
        margin: 0 !important;
        font-size: 0.8125rem;
        color: #64748b;
    }

    .pms-payment-listing .pms-plans-dt-footer .dataTables_length select {
        border-radius: 8px;
        border: 1px solid #94a3b8;
        padding: 0.2rem 1.75rem 0.2rem 0.5rem;
        min-height: 32px;
        height: 32px;
        font-size: 0.8125rem;
        margin: 0 0.35rem;
        background-color: #fff;
    }

    .pms-payment-listing .pms-plans-dt-footer .dataTables_paginate {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.15rem;
    }

    .pms-payment-listing .dataTables_wrapper .dataTables_scroll,
    .pms-payment-listing .dataTables_wrapper .dataTables_scrollBody {
        overflow-x: hidden !important;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            var table = $('#plansTable').DataTable({
                pageLength: 10,
                ordering: false,
                order: [],
                lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                paging: true,
                scrollX: false,
                autoWidth: false,
                searching: true,
                dom: 'rt<"pms-plans-dt-footer d-flex flex-wrap align-items-center justify-content-between gap-2 mt-2"lip>',
                columnDefs: [
                    { width: '36%', searchable: true, targets: 0 },   // Plan Name
                    { width: '16%', searchable: false, targets: 1 },  // Total
                    { width: '10%', searchable: false, targets: 2 },  // Curr.
                    { width: '16%', searchable: false, targets: 3 },  // Duration
                    { width: '14%', searchable: true, targets: 4 },   // Freq.
                    { width: '8%', searchable: false, targets: 5 }    // Sched.
                ],
                language: {
                    search: 'Search:',
                    lengthMenu: 'Show _MENU_ per page',
                    info: 'Showing _START_ to _END_ of _TOTAL_ plans',
                    infoEmpty: 'No plans',
                    infoFiltered: '(filtered from _MAX_)',
                    paginate: {
                        first: 'First',
                        last: 'Last',
                        next: 'Next',
                        previous: 'Previous'
                    }
                }
            });

            $('#planSearchTerm').on('keyup input', function () {
                table.search(this.value || '').draw();
            });

            $('#plansTable tbody').on('dblclick', 'tr.pms-plan-row', function (e) {
                if ($(e.target).closest('a,button').length) {
                    return;
                }
                var url = $(this).data('open-url');
                if (url) {
                    window.location.href = url;
                }
            });
        });
    </script>
}
