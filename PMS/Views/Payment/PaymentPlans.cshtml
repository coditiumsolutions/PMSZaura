@model IEnumerable<PMS.Models.PaymentPlan>
@using System.Globalization

@{
    ViewData["Title"] = "Payment Plans (Batches)";
    var EnUs = CultureInfo.GetCultureInfo("en-US");
    var plansOrdered = Model?.OrderBy(p => p.PlanName).ToList() ?? new List<PMS.Models.PaymentPlan>();
    var totalCount = plansOrdered.Count;
    var totalCustomers = plansOrdered.Sum(p => p.Customers?.Count ?? 0);
    var totalValueSsp = plansOrdered.Sum(p => p.TotalAmount);
    var totalSchedules = plansOrdered.Sum(p => p.PaymentSchedules?.Count ?? 0);
}

<div class="pms-payment-listing pms-listing-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h5 class="pms-grid-title mb-0">Payment Plans</h5>
        <span class="badge rounded-pill pms-record-badge">@totalCount plan@(totalCount == 1 ? "" : "s")</span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-1 px-2 mb-2 small" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-1 px-2 mb-2 small" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-2 mb-2">
        <div class="col-6 col-md-3">
            <div class="card border-0 h-100" style="background:#e8f0fe;">
                <div class="card-body text-center py-2 px-2">
                    <div class="small text-muted text-uppercase fw-semibold mb-0">Total Plans</div>
                    <div class="fs-5 fw-bold text-primary mb-0">@totalCount</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 h-100" style="background:#d1ecf1;">
                <div class="card-body text-center py-2 px-2">
                    <div class="small text-muted text-uppercase fw-semibold mb-0">Customers</div>
                    <div class="fs-5 fw-bold text-info mb-0">@totalCustomers</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 h-100" style="background:#d4edda;">
                <div class="card-body text-center py-2 px-2">
                    <div class="small text-muted text-uppercase fw-semibold mb-0">Total Value</div>
                    <div class="fs-6 fw-bold text-success mb-0">@totalValueSsp.ToString("N0", EnUs)</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 h-100" style="background:#fff3cd;">
                <div class="card-body text-center py-2 px-2">
                    <div class="small text-muted text-uppercase fw-semibold mb-0">Schedules</div>
                    <div class="fs-5 fw-bold text-warning mb-0">@totalSchedules</div>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-2">
        <div class="pms-listing-search-wrap">
            <div class="d-flex flex-wrap gap-2 pms-listing-search-actions">
                <partial name="_PaymentPlansOperationsDropdown" />
            </div>
        </div>
    </div>

    <div class="card pms-grid-card pms-listing-flat pms-saas-grid mb-2">
        <div class="card-body py-2">
            <div class="pms-saas-table-wrap pms-payment-plans-grid-wrap">
                <table class="table pms-saas-table" id="plansTable">
                    <thead>
                        <tr>
                            <th>Plan Name</th>
                            <th>Project</th>
                            <th class="text-end">Total (PKR)</th>
                            <th>Curr.</th>
                            <th>Duration</th>
                            <th>Freq.</th>
                            <th>Cust.</th>
                            <th>Sched.</th>
                            <th class="text-end">Balance</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var plan in plansOrdered)
                        {
                            var schedulesSumPkr = plan.PaymentSchedules?.Sum(s => s.Amount) ?? 0m;
                            var balancePkr = plan.TotalAmount - schedulesSumPkr;
                            var hasBalanceRemaining = balancePkr > 0.0000001m;
                            <tr class="@(hasBalanceRemaining ? "plan-balance-remaining" : null)">
                                <td data-label="Plan Name">
                                    <div>
                                        <a asp-action="PaymentSchedule"
                                           asp-route-planId="@plan.PlanID"
                                           class="text-decoration-none fw-semibold">
                                            @plan.PlanName
                                        </a>
                                    </div>
                                    @if (!string.IsNullOrEmpty(plan.Description))
                                    {
                                        <div class="small text-muted">@(plan.Description.Length > 40 ? plan.Description.Substring(0, 40) + "…" : plan.Description)</div>
                                    }
                                </td>
                                <td data-label="Project">
                                    @if (plan.Project != null)
                                    {
                                        <span class="pms-pill pms-pill--info">@plan.Project.ProjectName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-end fw-semibold text-success" data-label="Total (PKR)">
                                    @plan.TotalAmount.ToString("N0", EnUs)
                                </td>
                                <td data-label="Curr.">
                                    <span class="pms-pill pms-pill--neutral text-uppercase">@plan.Currency</span>
                                </td>
                                <td data-label="Duration">@(plan.DurationMonths?.ToString() ?? "—") mo</td>
                                <td data-label="Freq.">
                                    <span class="pms-pill pms-pill--neutral">@plan.Frequency</span>
                                </td>
                                <td data-label="Cust.">
                                    <span class="pms-pill pms-pill--info">@(plan.Customers?.Count ?? 0)</span>
                                </td>
                                <td data-label="Sched.">
                                    <span class="pms-pill @(plan.PaymentSchedules?.Any() == true ? "pms-pill--success" : "pms-pill--warning")">
                                        @(plan.PaymentSchedules?.Count ?? 0)
                                    </span>
                                </td>
                                <td class="text-end" data-label="Balance">
                                    <span class="fw-semibold @(hasBalanceRemaining ? "text-success" : balancePkr < -0.0000001m ? "text-danger" : "text-muted")">
                                        @balancePkr.ToString("N0", EnUs)
                                    </span>
                                </td>
                                <td class="text-center" data-label="Actions">
                                    <a asp-action="PaymentSchedule"
                                       asp-route-planId="@plan.PlanID"
                                       class="btn btn-sm btn-outline-primary py-0 px-2"
                                       title="Edit plan and view installments">
                                        <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .pms-payment-listing .pms-saas-table thead th {
        font-size: 11.5px !important;
    }

    .pms-payment-listing #plansTable tbody tr.plan-balance-remaining {
        box-shadow: inset 3px 0 0 0 var(--accent-gold, #f59e0b);
        background-color: rgba(245, 158, 11, 0.1);
    }

    .pms-payment-listing #plansTable tbody tr.plan-balance-remaining:hover {
        background-color: rgba(245, 158, 11, 0.16);
    }

    .pms-payment-listing .pms-payment-plans-grid-wrap {
        overflow-x: hidden;
        overflow-y: visible;
        max-height: none;
        min-height: 486px;
    }

    .pms-payment-listing #plansTable {
        table-layout: fixed;
        width: 100% !important;
    }

    .pms-payment-listing #plansTable th,
    .pms-payment-listing #plansTable td {
        white-space: normal;
        overflow: hidden;
        text-overflow: ellipsis;
        vertical-align: middle;
        font-size: 0.8125rem;
        padding: 0.5rem 0.35rem;
    }

    .pms-payment-listing #plansTable thead th {
        font-size: 11.5px !important;
    }

    .pms-payment-listing #plansTable .pms-pill {
        font-size: 0.7rem;
        padding: 0.15rem 0.4rem;
    }

    .pms-payment-listing .dataTables_wrapper .dataTables_scroll,
    .pms-payment-listing .dataTables_wrapper .dataTables_scrollBody {
        overflow-x: hidden !important;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#plansTable').DataTable({
                pageLength: 10,
                order: [[0, 'asc']],
                lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                paging: true,
                scrollX: false,
                autoWidth: false,
                columnDefs: [
                    { width: '18%', targets: 0 },  // Plan Name
                    { width: '14%', targets: 1 },  // Project
                    { width: '12%', targets: 2 },  // Total
                    { width: '7%', targets: 3 },   // Curr.
                    { width: '8%', targets: 4 },   // Duration
                    { width: '8%', targets: 5 },   // Freq.
                    { width: '6%', targets: 6 },   // Cust.
                    { width: '6%', targets: 7 },   // Sched.
                    { width: '10%', targets: 8 },  // Balance
                    { width: '11%', orderable: false, targets: 9 }  // Actions
                ],
                language: {
                    search: 'Search:',
                    lengthMenu: 'Show _MENU_ per page',
                    info: 'Showing _START_ to _END_ of _TOTAL_ plans',
                    infoEmpty: 'No plans',
                    infoFiltered: '(filtered from _MAX_)',
                    paginate: {
                        first: 'First',
                        last: 'Last',
                        next: 'Next',
                        previous: 'Previous'
                    }
                }
            });

        });
    </script>
}
