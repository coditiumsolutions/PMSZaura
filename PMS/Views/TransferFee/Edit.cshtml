@model PMS.Models.TransferFee

@{
    ViewData["Title"] = "Edit Transfer Fee";
    var projects = ViewBag.Projects as IEnumerable<PMS.Models.Project> ?? Enumerable.Empty<PMS.Models.Project>();
    var subProjects = ViewBag.SubProjects as IList<string> ?? new List<string>();
    var transferTypes = ViewBag.TransferTypes as IList<string> ?? new List<string>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0 pms-registration-page-title">Edit Transfer Fee</h2>
    <div class="d-flex gap-2">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info btn-sm">
            <i class="fas fa-eye me-1"></i>View Details
        </a>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="fas fa-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>

<div class="card pms-listing-flat pms-registration-create">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="pms-registration-4col-form">
                <div class="row g-2 pms-registration-4col-row align-items-start">
                    <div class="col-12 col-lg-2">
                        <label asp-for="ProjectID" class="form-label pms-registration-4col-label">Project *</label>
                    </div>
                    <div class="col-12 col-lg-4">
                        <select asp-for="ProjectID" class="form-select" id="projectId" required>
                            <option value="">-- Select Project --</option>
                            @foreach (var p in projects)
                            {
                                <option value="@p.ProjectID" selected="@(Model.ProjectID == p.ProjectID)">@p.ProjectName</option>
                            }
                        </select>
                        <span asp-validation-for="ProjectID" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-lg-2">
                        <label asp-for="SubProject" class="form-label pms-registration-4col-label">SubProject *</label>
                    </div>
                    <div class="col-12 col-lg-4">
                        <select asp-for="SubProject" class="form-select" id="subProject" required>
                            <option value="">-- Select SubProject --</option>
                            @foreach (var s in subProjects)
                            {
                                <option value="@s" selected="@(Model.SubProject == s)">@s</option>
                            }
                        </select>
                        <span asp-validation-for="SubProject" class="text-danger"></span>
                    </div>
                </div>

                <div class="row g-2 pms-registration-4col-row align-items-start">
                    <div class="col-12 col-lg-2">
                        <label asp-for="TransferType" class="form-label pms-registration-4col-label">Transfer Type *</label>
                    </div>
                    <div class="col-12 col-lg-4">
                        <select asp-for="TransferType" class="form-select" required>
                            <option value="">-- Select Transfer Type --</option>
                            @foreach (var t in transferTypes)
                            {
                                <option value="@t" selected="@(Model.TransferType == t)">@t</option>
                            }
                        </select>
                        <span asp-validation-for="TransferType" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-lg-2">
                        <label asp-for="TransferPriority" class="form-label pms-registration-4col-label">Transfer Priority</label>
                    </div>
                    <div class="col-12 col-lg-4">
                        <select asp-for="TransferPriority" class="form-select">
                            <option value="Normal" selected="@(Model.TransferPriority == "Normal")">Normal</option>
                            <option value="Urgent" selected="@(Model.TransferPriority == "Urgent")">Urgent</option>
                        </select>
                        <span asp-validation-for="TransferPriority" class="text-danger"></span>
                    </div>
                </div>

                <div class="row g-2 pms-registration-4col-row align-items-start">
                    <div class="col-12 col-lg-2">
                        <label asp-for="AmountPerUnit" class="form-label pms-registration-4col-label">Amount Per Unit *</label>
                    </div>
                    <div class="col-12 col-lg-4">
                        <input asp-for="AmountPerUnit" class="form-control" type="number" step="0.01" min="0.01" required />
                        <span asp-validation-for="AmountPerUnit" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-lg-2">
                        <div class="pms-registration-4col-label">Transfer Fee ID</div>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="form-control-plaintext py-1"><code>@Model.Id</code></div>
                    </div>
                </div>

                <div class="row g-2 pms-registration-4col-row align-items-start">
                    <div class="col-12 col-lg-2">
                        <label asp-for="Details" class="form-label pms-registration-4col-label">Details</label>
                    </div>
                    <div class="col-12 col-lg-10">
                        <textarea asp-for="Details" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Details" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pms-registration-create-actions mt-3">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-sm btn-primary">
                    <i class="fas fa-save me-1"></i>Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        (function () {
            var projectSelect = document.getElementById('projectId');
            var subProjectSelect = document.getElementById('subProject');

            function refreshSubProjects(projectId, selectedValue) {
                if (!projectId) {
                    subProjectSelect.innerHTML = '<option value="">-- Select SubProject --</option>';
                    return;
                }

                fetch('@Url.Action("GetProjectSubProjects", "TransferFee")?projectId=' + encodeURIComponent(projectId))
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        subProjectSelect.innerHTML = '<option value="">-- Select SubProject --</option>';
                        if (!data || !data.success || !Array.isArray(data.subProjects)) return;
                        data.subProjects.forEach(function (sp) {
                            var opt = document.createElement('option');
                            opt.value = sp;
                            opt.text = sp;
                            if (selectedValue && selectedValue.toLowerCase() === sp.toLowerCase()) {
                                opt.selected = true;
                            }
                            subProjectSelect.appendChild(opt);
                        });
                    });
            }

            projectSelect.addEventListener('change', function () {
                refreshSubProjects(this.value, '');
            });
        })();
    </script>
}
