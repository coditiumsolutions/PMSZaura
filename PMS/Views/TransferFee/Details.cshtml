@model PMS.Models.TransferFee

@{
    ViewData["Title"] = "Transfer Fee Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center gap-3 ms-4">
        <div class="badge bg-light text-dark px-3 py-2" style="font-size: 14px;">
            <i class="fas fa-calendar-check me-2" style="color: #2563eb;"></i>
            <strong>Created:</strong> @Model.CreatedOn.ToString("MMMM dd, yyyy")
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (ViewBag.CanEdit == true)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
                <i class="fas fa-edit me-1"></i>Edit
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="fas fa-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>

<div class="card pms-listing-flat pms-registration-details">
    <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Transfer Fee Information</h5>
    </div>
    <div class="card-body">
        <div class="pms-registration-4col-form">
            <div class="row g-2 pms-registration-4col-row align-items-start">
                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Transfer Fee ID</div></div>
                <div class="col-12 col-lg-4"><div class="pms-registration-details-value"><code>@Model.Id</code></div></div>
                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Project</div></div>
                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@(Model.Project?.ProjectName ?? Model.ProjectID)</div></div>
            </div>
            <div class="row g-2 pms-registration-4col-row align-items-start">
                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">SubProject</div></div>
                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@(Model.SubProject ?? "—")</div></div>
                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Transfer Type</div></div>
                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@(Model.TransferType ?? "—")</div></div>
            </div>
            <div class="row g-2 pms-registration-4col-row align-items-start">
                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Transfer Priority</div></div>
                <div class="col-12 col-lg-4">
                    <div class="pms-registration-details-value">
                        <span class="pms-pill pms-pill--info">@(Model.TransferPriority ?? "—")</span>
                    </div>
                </div>
                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Amount Per Unit</div></div>
                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@Model.AmountPerUnit.ToString("N2")</div></div>
            </div>
            <div class="row g-2 pms-registration-4col-row align-items-start">
                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Created By</div></div>
                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@(Model.CreatedBy ?? "—")</div></div>
                <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Modified By</div></div>
                <div class="col-12 col-lg-4"><div class="pms-registration-details-value">@(Model.ModifiedBy ?? "—")</div></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Details))
            {
                <div class="row g-2 pms-registration-4col-row align-items-start">
                    <div class="col-12 col-lg-2"><div class="pms-registration-4col-label">Details</div></div>
                    <div class="col-12 col-lg-10"><div class="pms-registration-details-value">@Model.Details</div></div>
                </div>
            }
        </div>
    </div>
</div>
