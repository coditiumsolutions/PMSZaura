<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Body>
    <ReportItems>
      <Textbox Name="CustomerInfo">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Customer Information</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="Customer ID: " &amp; First(Fields!CustomerCode.Value, "AccountStatementHeader") &amp; vbCrLf &amp;
                          "Customer Name: " &amp; First(Fields!CustomerName.Value, "AccountStatementHeader") &amp; vbCrLf &amp;
                          "Address: " &amp; First(Fields!CustomerAddress.Value, "AccountStatementHeader") &amp; vbCrLf &amp;
                          "Phone: " &amp; First(Fields!CustomerPhone.Value, "AccountStatementHeader") &amp; vbCrLf &amp;
                          "Mobile: " &amp; First(Fields!CustomerMobile.Value, "AccountStatementHeader")</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>9pt</FontSize>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <Top>0.05in</Top>
        <Left>0in</Left>
        <Height>0.68in</Height>
        <Width>3.7in</Width>
        <Style>
