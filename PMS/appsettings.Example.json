{
  "ConnectionStrings": {
    "DefaultConnection": "Server=<host>,<port>;Database=<database>;User Id=<user>;Password=<password>;Encrypt=Mandatory;TrustServerCertificate=true;Connect Timeout=60;"
  },
  "DataProtection": {
    "KeysPath": "C:\\ProgramData\\PMS\\DataProtectionKeys"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AmsIntegration": {
    "Enabled": true
  },
  "AmsBackgroundJobs": {
    "Enabled": false,
    "StartupDelaySeconds": 120,
    "IntervalMinutes": 1440
  },
  "AmsAccCompat": {
    "MapVoucherBankAccountColumn": false
  },
  "ReportService": {
    "BaseUrl": "http://127.0.0.1:8000",
    "TimeoutSeconds": 15,
    "PreferLocalRdlc": false
  },
  "Groq": {
    "ApiKeys": []
  }
}
