<div class="dropdown pms-listing-operations-dropdown">
    <button class="btn btn-sm dropdown-toggle pms-listing-operations-btn pms-pair-action-btn pms-pair-action-btn--operations"
            type="button"
            id="paymentOperationsDropdown"
            data-bs-toggle="dropdown"
            aria-expanded="false">
        Operations
    </button>
    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="paymentOperationsDropdown">
        @if (ViewBag.CanCreate == true)
        {
            <li>
                <a class="dropdown-item" asp-action="RecordPayment">
                    <i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Add Payment
                </a>
            </li>
            <li>
                <a class="dropdown-item" asp-action="MultiplePayments">
                    <i class="bi bi-layers me-2" aria-hidden="true"></i>Multiple Payments
                </a>
            </li>
            <li><hr class="dropdown-divider" /></li>
        }
        <li>
            <button type="button" class="dropdown-item" id="btnPaymentReceiptOps">
                <i class="bi bi-printer me-2" aria-hidden="true"></i>Payment Receipt
            </button>
        </li>
    </ul>
</div>
