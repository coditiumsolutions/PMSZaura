@{
    Layout = null;
    ViewData["Title"] = "Coditium";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" href="~/favicon.ico" type="image/x-icon" />
    <style>
        :root {
            color-scheme: dark;
            --bg: #04111d;
            --surface: rgba(6, 18, 31, 0.68);
            --surface-strong: rgba(6, 18, 31, 0.84);
            --border: rgba(255, 255, 255, 0.14);
            --text: #f8fafc;
            --muted: #cbd5e1;
            --accent: #38bdf8;
            --accent-2: #0ea5e9;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Inter, "Segoe UI", Arial, sans-serif;
            color: var(--text);
            background: var(--bg);
        }

        .hero {
            position: relative;
            min-height: 100vh;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 20px;
        }

        .hero video {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                linear-gradient(135deg, rgba(2, 6, 23, 0.82), rgba(3, 37, 65, 0.55)),
                radial-gradient(circle at top right, rgba(56, 189, 248, 0.22), transparent 35%);
        }

        .content {
            position: relative;
            z-index: 1;
            width: min(1040px, 100%);
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 28px;
            align-items: stretch;
        }

        .panel,
        .card {
            border: 1px solid var(--border);
            background: var(--surface);
            backdrop-filter: blur(14px);
            border-radius: 24px;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
        }

        .panel {
            padding: 44px;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            border-radius: 999px;
            background: rgba(14, 165, 233, 0.12);
            color: #e0f2fe;
            font-size: 13px;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        h1 {
            margin: 22px 0 14px;
            font-size: clamp(2.5rem, 5vw, 4.6rem);
            line-height: 1.04;
        }

        .lead {
            margin: 0;
            max-width: 46rem;
            font-size: 1.05rem;
            line-height: 1.75;
            color: var(--muted);
        }

        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            margin-top: 30px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 48px;
            padding: 0 20px;
            border-radius: 999px;
            text-decoration: none;
            font-weight: 700;
            transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
        }

        .btn:hover {
            transform: translateY(-1px);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            color: white;
        }

        .btn-secondary {
            border: 1px solid var(--border);
            color: var(--text);
            background: rgba(255, 255, 255, 0.05);
        }

        .card {
            padding: 28px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .card h2 {
            margin: 0 0 8px;
            font-size: 1.3rem;
        }

        .card p {
            margin: 0;
            color: var(--muted);
            line-height: 1.65;
        }

        .bullets {
            margin: 22px 0 0;
            padding: 0;
            list-style: none;
            display: grid;
            gap: 12px;
        }

        .bullets li {
            padding: 12px 14px;
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.06);
        }

        .footer-note {
            margin-top: 24px;
            font-size: 0.95rem;
            color: #e2e8f0;
        }

        @@media (max-width: 900px) {
            .content {
                grid-template-columns: 1fr;
            }

            .panel {
                padding: 28px;
            }
        }
    </style>
</head>
<body>
    <main class="hero">
        <video autoplay muted loop playsinline aria-hidden="true">
            <source src="/samplepage-assets/moving01.mp4" type="video/mp4" />
        </video>

        <div class="content">
            <section class="panel">
                <div class="eyebrow">Coditium Property Management System</div>
                <h1>Modern property operations with a simpler public entry page.</h1>
                <p class="lead">
                    This lightweight landing page keeps your current PMS dashboard intact under
                    <strong>/coditium</strong>, while the root URL stays clean for presentation, sharing, and future public content.
                </p>
                <div class="actions">
                    <a class="btn btn-primary" href="/Account/Login">Open PMS Login</a>
                    <a class="btn btn-secondary" href="/coditium">Open Current Home</a>
                </div>
                <p class="footer-note">
                    Background media is served from your `samplepage` folder so the original sample asset stays reusable.
                </p>
            </section>

            <aside class="card">
                <div>
                    <h2>What changed</h2>
                    <p>The existing dashboard has been preserved and moved behind a dedicated route without deleting any of its logic.</p>
                    <ul class="bullets">
                        <li><strong>/</strong> serves this simple landing page.</li>
                        <li><strong>/coditium</strong> serves the previous authenticated home dashboard.</li>
                        <li>The landing page can evolve independently from the PMS app shell.</li>
                    </ul>
                </div>
            </aside>
        </div>
    </main>
</body>
</html>
