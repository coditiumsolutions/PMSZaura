@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";
    var auditFilter = Context.Request.Query["auditFilter"].ToString();
    var isAuditIndex = string.Equals(currentController, "PaymentAudit", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
    var isPending = isAuditIndex && string.Equals(auditFilter, "Pending", StringComparison.OrdinalIgnoreCase);
    var isApproved = isAuditIndex && string.Equals(auditFilter, "Approved", StringComparison.OrdinalIgnoreCase);
    var isDeclined = isAuditIndex && string.Equals(auditFilter, "Declined", StringComparison.OrdinalIgnoreCase);
}

<li class="nav-item sidebar-section-label sidebar-section-label--module">
    <h6 class="sidebar-section-title">Audit Section</h6>
</li>

<li class="nav-item sidebar-module-item">
    <a class="nav-link @(isPending ? "active" : "")"
       asp-controller="PaymentAudit"
       asp-action="Index"
       asp-route-auditFilter="Pending">
        <i class="fas fa-clock me-2"></i>Pending
    </a>
</li>
<li class="nav-item sidebar-module-item">
    <a class="nav-link @(isApproved ? "active" : "")"
       asp-controller="PaymentAudit"
       asp-action="Index"
       asp-route-auditFilter="Approved">
        <i class="fas fa-check-circle me-2"></i>Approved
    </a>
</li>
<li class="nav-item sidebar-module-item">
    <a class="nav-link @(isDeclined ? "active" : "")"
       asp-controller="PaymentAudit"
       asp-action="Index"
       asp-route-auditFilter="Declined">
        <i class="fas fa-times-circle me-2"></i>Declined
    </a>
</li>
